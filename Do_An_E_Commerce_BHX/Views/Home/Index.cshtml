@model Do_An_E_Commerce_BHX.Models.ViewModels.HomeIndexViewModel

@{
    ViewBag.Title = "Trang chủ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@helper ProductCard(Do_An_E_Commerce_BHX.Models.Entities.Product item)
{
    bool soldOut = item.IsOutOfStock;
    string img = string.IsNullOrEmpty(item.URLImage) ? "/Content/images/no-image.png" : item.URLImage;
    <div class="product-card @(soldOut ? "is-sold-out" : "")">
        <div class="product-media btn-open-detail" data-id="@item.Id" style="cursor: pointer;" title="Bấm xem chi tiết sản phẩm">
            <img src="@img" alt="@item.Name" loading="lazy" onerror="this.src='/Content/images/no-image.png'" />
            <div class="badge-stack">
                @if (item.IsHot)
                {<span class="badge badge-hot"><i class="fa-solid fa-fire"></i> Hot</span>}
                @if (item.IsBestSeller)
                {<span class="badge badge-best"><i class="fa-solid fa-star"></i> Bán chạy</span>}
            </div>
            @if (soldOut)
            {
                <div class="sold-out-layer"><span>Hết hàng</span></div>
            }
        </div>
        <div class="product-body">
            <h4 class="product-name btn-open-detail" data-id="@item.Id" style="cursor: pointer;" title="@item.Name">@item.Name</h4>
            <div class="product-price">@item.Price.ToString("N0") ₫</div>

            <!-- ĐÁNH GIÁ SAO & SỐ LƯỢNG ĐÁNH GIÁ -->
            <div class="product-rating my-2 d-flex align-items-center gap-1">
                <span class="text-warning fw-bold"><i class="fa-solid fa-star"></i> 5.0</span>
                <span class="text-muted small ms-1">(12 đánh giá)</span>
            </div>

            <div class="d-flex gap-2 mt-auto pt-2">
                <button type="button" class="btn btn-sm btn-outline-success w-50 btn-open-detail fw-bold btn-detail-custom" data-id="@item.Id">
                    <i class="fa-solid fa-eye me-1"></i> Chi tiết
                </button>
                <button type="button" class="btn-add-cart w-50" data-id="@item.Id" @(soldOut ? "disabled" : "")>
                    <i class="fa-solid fa-cart-plus"></i> @(soldOut ? "Hết" : "Mua")
                </button>
            </div>
        </div>
    </div>
}

@section styles {
    <style>
            /* ================================================
           BHX HOME - REDESIGN v3 (Dramatic Visual Upgrade)
        ================================================ */

            /* Override body background to fresh light green */
            body {
                background: #EEF5EF !important;
            }

            /* FLYING CART */
            .flying-cart-img {
                position: fixed;
                pointer-events: none;
                z-index: 9999;
                border-radius: 50%;
                transition: all 0.8s cubic-bezier(0.2, 0.8, 0.4, 1);
                box-shadow: 0 4px 20px rgba(0,0,0,0.3);
            }

            /* ===== HERO BAND — Dramatic gradient with animated shimmer ===== */
            .hero-band {
                background: linear-gradient(140deg, #064E21 0%, #0F7A3C 40%, #17A85A 75%, #1DBF67 100%);
                border-radius: 20px;
                padding: 40px 36px;
                margin-bottom: 24px;
                position: relative;
                overflow: hidden;
                box-shadow: 0 12px 40px rgba(6,78,33,0.35);
            }

                .hero-band::before {
                    content: '';
                    position: absolute;
                    top: -60%;
                    left: -20%;
                    width: 60%;
                    height: 220%;
                    background: rgba(255,255,255,0.06);
                    transform: rotate(25deg);
                    border-radius: 50%;
                    pointer-events: none;
                }

                .hero-band::after {
                    content: '';
                    position: absolute;
                    bottom: -40%;
                    right: -10%;
                    width: 45%;
                    height: 180%;
                    background: rgba(255,255,255,0.04);
                    transform: rotate(-20deg);
                    border-radius: 50%;
                    pointer-events: none;
                }

            .hero-eyebrow {
                font-family: 'JetBrains Mono', monospace;
                font-size: 11px;
                letter-spacing: 0.25em;
                text-transform: uppercase;
                color: rgba(255,255,255,0.7);
                margin: 0 0 12px;
                position: relative;
                z-index: 1;
            }

                .hero-eyebrow::before {
                    content: "▸ ";
                    color: #A8F5C8;
                }

            .hero-title {
                font-size: clamp(24px, 4.5vw, 38px);
                font-weight: 900;
                color: #fff;
                margin: 0 0 24px;
                text-transform: uppercase;
                letter-spacing: -0.5px;
                line-height: 1.15;
                text-shadow: 0 3px 12px rgba(0,0,0,0.25);
                position: relative;
                z-index: 1;
            }

        /* ===== FORM TÌM KIẾM ===== */
        .search-form {
            display: flex;
            align-items: center; /* Căn giữa theo chiều dọc */
            background: #fff;
            border-radius: 14px;
            padding: 7px;
            box-shadow: 0 10px 36px rgba(0,0,0,0.2), 0 2px 8px rgba(0,0,0,0.1);
            width: 100%;
            position: relative;
            z-index: 1;
        }

            .search-form input[type="text"] {
                flex: 1; /* Chiếm toàn bộ không gian còn trống */
                width: 100%;
                min-width: 0;
                border: none;
                outline: none;
                font-family: 'Inter', sans-serif;
                font-size: 15px;
                padding: 11px 18px;
                color: #1A2E22;
                background: transparent;
            }

                .search-form input[type="text"]::placeholder {
                    color: #AABFB0;
                }

            .search-form button {
                margin-left: auto; /* Lệnh chốt chặn: Đẩy nút sát về mép phải */
                flex-shrink: 0; /* Giữ nguyên kích thước nút, không bị bóp méo */
                border: none;
                background: linear-gradient(135deg, #0F7A3C, #064E21);
                color: #fff;
                font-weight: 700;
                font-size: 14.5px;
                padding: 11px 26px;
                border-radius: 10px;
                cursor: pointer;
                display: flex;
                align-items: center;
                gap: 8px;
                transition: all 0.2s;
                white-space: nowrap;
                box-shadow: 0 4px 12px rgba(6,78,33,0.4);
            }

                .search-form button:hover {
                    background: linear-gradient(135deg, #064E21, #043A18);
                    box-shadow: 0 6px 18px rgba(6,78,33,0.5);
                    transform: translateY(-1px);
                }

            /* ===== FILTER PANEL ===== */
            .filter-panel {
                background: #fff;
                border: 1.5px solid #C8DFCC;
                border-radius: 14px;
                box-shadow: 0 4px 20px rgba(15,122,60,0.08);
                margin-bottom: 28px;
                overflow: hidden;
            }

            .filter-toggle {
                list-style: none;
                cursor: pointer;
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 14px 22px;
                font-weight: 700;
                font-size: 14px;
                color: #0A6030;
                background: linear-gradient(90deg, #F2FAF5, #fff);
                transition: background 0.15s;
                user-select: none;
            }

                .filter-toggle::-webkit-details-marker {
                    display: none;
                }

                .filter-toggle:hover {
                    background: #E6F5EC;
                }

                .filter-toggle i {
                    color: #0F7A3C;
                    font-size: 15px;
                }

                .filter-toggle .toggle-caret {
                    margin-left: auto;
                    transition: transform .25s ease;
                    color: #8FB89A;
                }

            details[open] .filter-toggle .toggle-caret {
                transform: rotate(180deg);
            }

            .filter-body {
                padding: 20px 22px 24px;
                border-top: 1.5px solid #E2F0E6;
                background: #F8FCF9;
            }

            .filter-form {
                display: grid;
                grid-template-columns: minmax(160px,1.1fr) minmax(200px,1.3fr) minmax(150px,1fr) auto;
                align-items: end;
                gap: 14px;
            }

            .filter-field {
                display: flex;
                flex-direction: column;
                gap: 5px;
            }

                .filter-field label {
                    font-size: 11px;
                    font-weight: 700;
                    text-transform: uppercase;
                    letter-spacing: 0.06em;
                    color: #5A7A62;
                }

                .filter-field select, .filter-field input {
                    border: 1.5px solid #C8DFCC;
                    border-radius: 9px;
                    padding: 9px 13px;
                    font-family: 'Inter', sans-serif;
                    font-size: 13.5px;
                    color: #1A2E22;
                    outline: none;
                    background: #fff;
                    width: 100%;
                    transition: border-color 0.15s, box-shadow 0.15s;
                }

                    .filter-field select:focus, .filter-field input:focus {
                        border-color: #0F7A3C;
                        box-shadow: 0 0 0 3px rgba(15,122,60,0.15);
                    }

            .price-range-inputs {
                display: flex;
                align-items: center;
                gap: 8px;
            }

                .price-range-inputs input {
                    width: 100%;
                }

                .price-range-inputs span {
                    color: #8FB89A;
                    font-size: 13px;
                    white-space: nowrap;
                }

            .filter-actions {
                display: flex;
                align-items: center;
                gap: 10px;
                white-space: nowrap;
            }

            .btn-apply-filter {
                border: none;
                background: linear-gradient(135deg, #0F7A3C, #064E21);
                color: #fff;
                font-weight: 700;
                font-size: 13.5px;
                padding: 10px 20px;
                border-radius: 9px;
                cursor: pointer;
                display: flex;
                align-items: center;
                gap: 7px;
                box-shadow: 0 4px 14px rgba(6,78,33,0.3);
                transition: all 0.2s;
            }

                .btn-apply-filter:hover {
                    transform: translateY(-1px);
                    box-shadow: 0 6px 18px rgba(6,78,33,0.4);
                }

            .btn-reset-filter {
                font-size: 13px;
                font-weight: 600;
                color: #E53935;
                text-decoration: none;
                transition: color 0.15s;
            }

                .btn-reset-filter:hover {
                    color: #C62828;
                }

            /* ===== SECTION HEADINGS ===== */
            .section-heading {
                display: flex;
                align-items: center;
                gap: 12px;
                margin: 0 0 20px;
            }

                .section-heading .dot {
                    width: 10px;
                    height: 10px;
                    background: linear-gradient(135deg, #0F7A3C, #17A85A);
                    transform: rotate(45deg);
                    display: inline-block;
                    flex-shrink: 0;
                    box-shadow: 0 2px 6px rgba(15,122,60,0.4);
                }

                .section-heading h3 {
                    margin: 0;
                    font-size: clamp(17px, 2.8vw, 21px);
                    font-weight: 900;
                    color: #064E21;
                    text-transform: uppercase;
                    letter-spacing: 0.2px;
                }

            section.store-section {
                margin-bottom: 48px;
            }

            .product-sections {
                display: flex;
                flex-direction: column;
            }

                .product-sections.is-filtering .all-products-section {
                    order: -1;
                }

            /* ===== FLASH SALE — Vivid red with diagonal stripes ===== */
            .flash-banner {
                background: linear-gradient(120deg, #B71C1C 0%, #D32F2F 50%, #E53935 100%);
                border-radius: 16px;
                padding: 20px 26px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                flex-wrap: wrap;
                gap: 14px;
                margin-bottom: 24px;
                color: #fff;
                box-shadow: 0 8px 28px rgba(183,28,28,0.4);
                position: relative;
                overflow: hidden;
            }

                .flash-banner::before {
                    content: '';
                    position: absolute;
                    inset: 0;
                    background: repeating-linear-gradient(-55deg, transparent 0, transparent 10px, rgba(255,255,255,0.04) 10px, rgba(255,255,255,0.04) 20px);
                    pointer-events: none;
                }

            .flash-left {
                display: flex;
                align-items: center;
                gap: 16px;
                z-index: 1;
            }

                .flash-left i {
                    font-size: 32px;
                    color: #FFD54F;
                    filter: drop-shadow(0 0 8px rgba(255,213,79,0.6));
                    animation: bhxPulse 1.4s ease-in-out infinite;
                }

            @@keyframes bhxPulse {
                0%, 100% {
                    transform: scale(1) rotate(-5deg);
                }

                50% {
                    transform: scale(1.25) rotate(5deg);
                }
            }

            .flash-title {
                font-family: 'Montserrat', 'Inter', sans-serif;
                font-size: clamp(17px, 3vw, 24px);
                font-weight: 900;
                text-transform: uppercase;
                margin: 0;
                letter-spacing: 0.3px;
                text-shadow: 0 2px 6px rgba(0,0,0,0.2);
            }

            .flash-sub {
                font-size: 12.5px;
                color: rgba(255,255,255,0.85);
                margin: 4px 0 0;
            }

            .flash-timer-wrap {
                display: flex;
                align-items: center;
                gap: 10px;
                font-family: 'JetBrains Mono', monospace;
                background: rgba(0,0,0,0.25);
                border-radius: 12px;
                padding: 10px 20px;
                z-index: 1;
                border: 1px solid rgba(255,255,255,0.2);
                backdrop-filter: blur(4px);
            }

            .flash-timer {
                font-size: clamp(20px, 3.5vw, 28px);
                font-weight: 700;
                letter-spacing: 0.1em;
                text-shadow: 0 2px 8px rgba(0,0,0,0.4);
            }

            /* ===== PRODUCT GRID ===== */
            .product-grid {
                display: grid;
                grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
                gap: 20px;
            }

            /* ===== PRODUCT CARD — Premium elevated card ===== */
            .product-card {
                background: #fff;
                border: none;
                border-radius: 18px;
                overflow: hidden;
                display: flex;
                flex-direction: column;
                transition: transform 0.28s cubic-bezier(.22,.68,0,1.2), box-shadow 0.28s ease;
                box-shadow: 0 4px 16px rgba(0,0,0,0.08), 0 1px 4px rgba(0,0,0,0.04);
            }

                .product-card:hover {
                    transform: translateY(-10px) scale(1.015);
                    box-shadow: 0 20px 50px rgba(6,78,33,0.18), 0 8px 20px rgba(0,0,0,0.08);
                }

            .product-media {
                position: relative;
                aspect-ratio: 1 / 1;
                background: linear-gradient(145deg, #F2FAF5, #E8F5ED);
                padding: 14px;
                overflow: hidden;
            }

                .product-media img {
                    width: 100%;
                    height: 100%;
                    object-fit: contain;
                    display: block;
                    border-radius: 10px;
                    transition: transform 0.35s cubic-bezier(.22,.68,0,1.2);
                }

            .product-card:hover .product-media img {
                transform: scale(1.08);
            }

            .badge-stack {
                position: absolute;
                top: 10px;
                left: 10px;
                display: flex;
                flex-direction: column;
                gap: 5px;
            }

            .badge {
                font-family: 'Inter', sans-serif;
                font-size: 11px;
                font-weight: 800;
                padding: 4px 10px;
                border-radius: 20px;
                color: #fff;
                display: inline-flex;
                align-items: center;
                gap: 4px;
                width: fit-content;
                box-shadow: 0 2px 8px rgba(0,0,0,0.2);
                text-transform: uppercase;
                letter-spacing: 0.03em;
            }

            .badge-hot {
                background: linear-gradient(135deg, #F44336, #B71C1C);
            }

            .badge-best {
                background: linear-gradient(135deg, #FF8F00, #E65100);
            }

            .sold-out-layer {
                position: absolute;
                inset: 0;
                background: rgba(10,30,18,0.65);
                display: flex;
                align-items: center;
                justify-content: center;
                backdrop-filter: blur(1px);
            }

                .sold-out-layer span {
                    color: #fff;
                    border: 2.5px solid #fff;
                    padding: 8px 18px;
                    font-size: 15px;
                    font-weight: 900;
                    border-radius: 8px;
                    text-transform: uppercase;
                    letter-spacing: 0.08em;
                    transform: rotate(-9deg);
                    background: rgba(0,0,0,0.25);
                }

            .product-body {
                padding: 16px 16px 18px;
                display: flex;
                flex-direction: column;
                gap: 7px;
                flex: 1;
                background: #fff;
                border-top: 1px solid #F0F7F2;
            }

            .product-name {
                font-family: 'Inter', sans-serif;
                font-size: 14.5px;
                line-height: 1.45;
                font-weight: 600;
                color: #1A2E22;
                margin: 0 0 2px;
                min-height: 42px;
                display: -webkit-box;
                -webkit-line-clamp: 2;
                -webkit-box-orient: vertical;
                overflow: hidden;
                transition: color 0.2s;
            }

                .product-name:hover {
                    color: #0F7A3C;
                }

            .product-price {
                font-family: 'JetBrains Mono', monospace;
                font-weight: 900;
                color: #D32F2F;
                font-size: 19px;
                line-height: 1;
            }

            .product-rating {
                font-size: 12.5px;
            }

            .btn-add-cart {
                border: none;
                background: linear-gradient(135deg, #0F7A3C, #064E21);
                color: #fff;
                font-family: 'Inter', sans-serif;
                font-weight: 700;
                font-size: 13.5px;
                padding: 11px 12px;
                border-radius: 10px;
                cursor: pointer;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 6px;
                transition: all 0.2s;
                min-height: 42px;
                box-shadow: 0 4px 12px rgba(6,78,33,0.25);
            }

                .btn-add-cart:hover:not([disabled]) {
                    background: linear-gradient(135deg, #064E21, #043A18);
                    box-shadow: 0 6px 18px rgba(6,78,33,0.4);
                    transform: translateY(-2px);
                }

                .btn-add-cart[disabled] {
                    background: #C8D8CC;
                    color: #7A9A82;
                    cursor: not-allowed;
                    box-shadow: none;
                }

            .btn-detail-custom {
                border-radius: 10px !important;
                font-size: 13.5px;
                padding: 11px 12px;
                border-color: #0F7A3C !important;
                color: #0F7A3C !important;
                font-weight: 700;
                min-height: 42px;
                background: transparent !important;
                transition: all 0.2s !important;
            }

                .btn-detail-custom:hover {
                    background: #E6F5EC !important;
                    border-color: #064E21 !important;
                    color: #064E21 !important;
                    transform: translateY(-2px);
                }

            /* ===== EMPTY STATE ===== */
            .empty-state {
                text-align: center;
                padding: 64px 24px;
                color: #8FB89A;
                background: #fff;
                border: 2px dashed #B8D8C0;
                border-radius: 18px;
            }

                .empty-state i {
                    font-size: 52px;
                    color: #C8DFCC;
                    margin-bottom: 16px;
                    display: block;
                }

            /* ===== PAGINATION ===== */
            .pagination-bar {
                display: flex;
                justify-content: center;
                align-items: center;
                gap: 8px;
                margin-top: 32px;
                flex-wrap: wrap;
            }

            .page-link {
                min-width: 40px;
                height: 40px;
                display: flex;
                align-items: center;
                justify-content: center;
                border-radius: 10px;
                border: 1.5px solid #C8DFCC;
                color: #1A2E22;
                font-family: 'JetBrains Mono', monospace;
                font-size: 13.5px;
                font-weight: 600;
                background: #fff;
                transition: all 0.2s;
                text-decoration: none;
            }

                .page-link:hover {
                    border-color: #0F7A3C;
                    color: #0F7A3C;
                    background: #E6F5EC;
                }

                .page-link.is-active {
                    background: linear-gradient(135deg, #0F7A3C, #064E21);
                    border-color: transparent;
                    color: #fff;
                    box-shadow: 0 4px 12px rgba(6,78,33,0.35);
                }

                .page-link.is-disabled {
                    opacity: 0.35;
                    pointer-events: none;
                }

            /* ===== RESPONSIVE ===== */
            @@media (max-width: 640px) {
                .hero-band {
                    padding: 24px 18px;
                    border-radius: 14px;
                }

                .search-form button {
                    padding: 11px 16px;
                }

                .flash-banner {
                    flex-direction: column;
                    align-items: flex-start;
                }

                .filter-form {
                    grid-template-columns: 1fr;
                }

                .filter-actions {
                    justify-content: space-between;
                }

                .product-grid {
                    grid-template-columns: repeat(2, minmax(0,1fr));
                    gap: 12px;
                }

                .product-body {
                    padding: 12px;
                }

                .product-name {
                    font-size: 13px;
                    min-height: 38px;
                }

                .product-price {
                    font-size: 16px;
                }

                .btn-add-cart, .btn-detail-custom {
                    font-size: 12px;
                    padding: 9px 8px;
                    min-height: 38px;
                }

                .product-card:hover {
                    transform: translateY(-4px);
                }
            }

            @@media (min-width: 641px) and (max-width: 1080px) {
                .filter-form {
                    grid-template-columns: repeat(2, minmax(0,1fr));
                }

                .product-grid {
                    grid-template-columns: repeat(auto-fill, minmax(185px,1fr));
                }
            }

            @@media (min-width: 1081px) {
                .product-grid {
                    grid-template-columns: repeat(auto-fill, minmax(225px,1fr));
                }
            }
    </style>
}

@{
    var activeSlot = Model.IsSlotActive ? Model.CurrentSlot : Model.NextSlot;
    var targetEnd = activeSlot != null ? activeSlot.End : TimeSpan.Zero;

    // Tự động kiểm tra xem có đang áp dụng bộ lọc nào không để fix lỗi CS1061 Model.IsFiltering
    bool isFiltering = !string.IsNullOrEmpty(Model.SearchTerm)
                    || Model.CategoryId != null
                    || Model.MinPrice != null
                    || Model.MaxPrice != null
                    || !string.IsNullOrEmpty(Model.SortBy);
}

<!-- Hero / tìm kiếm nhanh -->
<div class="hero-band">
    <p class="hero-eyebrow">Bách Hóa Xanh &middot; Siêu thị trực tuyến</p>
    <h1 class="hero-title">Hôm nay ăn gì, mua gì cũng có</h1>
    @using (Html.BeginForm("Index", "Home", FormMethod.Get, new { @class = "search-form" }))
    {
        @Html.Hidden("categoryId", Model.CategoryId)
        @Html.Hidden("minPrice", Model.MinPrice)
        @Html.Hidden("maxPrice", Model.MaxPrice)
        @Html.Hidden("sortBy", Model.SortBy)
        <input type="text" name="searchTerm" placeholder="Tìm rau củ, thịt cá, sữa, gia vị..." value="@Model.SearchTerm" />
        <button type="submit"><i class="fa-solid fa-magnifying-glass"></i> Tìm kiếm</button>
    }
</div>

<!-- Bộ lọc nâng cao: danh mục + khoảng giá + sắp xếp -->
<details class="filter-panel">
    <summary class="filter-toggle">
        <i class="fa-solid fa-sliders"></i> Bộ lọc nâng cao
        <i class="fa-solid fa-chevron-down toggle-caret"></i>
    </summary>
    <div class="filter-body">
        @using (Html.BeginForm("Index", "Home", FormMethod.Get, new { @class = "filter-form" }))
        {
            @Html.Hidden("searchTerm", Model.SearchTerm)
            <div class="filter-field">
                <label for="filterCategory">Danh mục</label>
                <select name="categoryId" id="filterCategory">
                    <option value="">Tất cả danh mục</option>
                    @if (Model.Categories != null)
                    {
                        foreach (var cat in Model.Categories)
                        {
                            <option value="@cat.Id" selected="@(Model.CategoryId == cat.Id ? "selected" : null)">@cat.Name</option>
                        }
                    }
                </select>
            </div>
            <div class="filter-field">
                <label>Khoảng giá</label>
                <div class="price-range-inputs">
                    <input type="number" name="minPrice" placeholder="Từ" min="0" step="1000" value="@Model.MinPrice" />
                    <span>&ndash;</span>
                    <input type="number" name="maxPrice" placeholder="Đến" min="0" step="1000" value="@Model.MaxPrice" />
                    <span>₫</span>
                </div>
            </div>
            <div class="filter-field">
                <label for="filterSort">Sắp xếp</label>
                <select name="sortBy" id="filterSort">
                    <option value="">Mặc định</option>
                    <option value="price_asc" selected="@(Model.SortBy == "price_asc" ? "selected" : null)">Giá tăng dần</option>
                    <option value="price_desc" selected="@(Model.SortBy == "price_desc" ? "selected" : null)">Giá giảm dần</option>
                    <option value="name_asc" selected="@(Model.SortBy == "name_asc" ? "selected" : null)">Tên A-Z</option>
                </select>
            </div>
            <div class="filter-actions">
                <button type="submit" class="btn-apply-filter"><i class="fa-solid fa-check"></i> Áp dụng</button>
                @Html.ActionLink("Xóa lọc", "Index", "Home", new { searchTerm = Model.SearchTerm }, new { @class = "btn-reset-filter" })
            </div>
        }
    </div>
</details>

<div class="product-sections @(isFiltering ? "is-filtering" : "")">
    <!-- Khung giờ vàng / Flash sale -->
    @if (Model.HotProducts != null && Model.HotProducts.Any())
    {
        <section class="store-section">
            <div class="flash-banner" id="flashBanner"
                 data-active="@Model.IsSlotActive.ToString().ToLower()"
                 data-target-hour="@targetEnd.Hours"
                 data-target-minute="@targetEnd.Minutes">
                <div class="flash-left">
                    <i class="fa-solid fa-bolt"></i>
                    <div>
                        <p class="flash-title">Khung giờ vàng @(activeSlot != null ? "· " + activeSlot.Label : "")</p>
                        <p class="flash-sub">
                            @if (Model.IsSlotActive)
                            {
                                <text>Đang diễn ra &mdash; giá tốt kết thúc sau</text>
                            }
                            else
                            {
                                <text>Khung giờ vàng tiếp theo bắt đầu sau</text>
                            }
                        </p>
                    </div>
                </div>
                <div class="flash-timer-wrap">
                    <i class="fa-solid fa-hourglass-half"></i>
                    <span class="flash-timer">00:00:00</span>
                </div>
            </div>

            <div class="section-heading"><span class="dot"></span><h3>Sản phẩm HOT trong khung giờ này</h3></div>
            <div class="product-grid">
                @foreach (var item in Model.HotProducts)
                {
                    @ProductCard(item)
                }
            </div>
        </section>
    }

    <!-- Bán chạy nhất -->
    @if (Model.BestSellerProducts != null && Model.BestSellerProducts.Any())
    {
        <section class="store-section">
            <div class="section-heading"><span class="dot"></span><h3>Bán chạy nhất</h3></div>
            <div class="product-grid">
                @foreach (var item in Model.BestSellerProducts)
                {
                    @ProductCard(item)
                }
            </div>
        </section>
    }

    <!-- Toàn bộ sản phẩm (đã áp bộ lọc) -->
    <section class="store-section all-products-section">
        <div class="section-heading">
            <span class="dot"></span>
            <h3>
                @if (!string.IsNullOrEmpty(Model.SearchTerm))
                {
                    <text>Kết quả cho "@Model.SearchTerm"</text>
                }
                else if (isFiltering)
                {
                    <text>Sản phẩm phù hợp</text>
                }
                else
                {
                    <text>Tất cả sản phẩm</text>
                }
            </h3>
        </div>

        @if (Model.Products != null && Model.Products.Any())
        {
            <div class="product-grid">
                @foreach (var item in Model.Products)
                {
                    @ProductCard(item)
                }
            </div>

            if (Model.TotalPages > 1)
            {
                <div class="pagination-bar">
                    @Html.ActionLink("‹", "Index", "Home", new { searchTerm = Model.SearchTerm, categoryId = Model.CategoryId, minPrice = Model.MinPrice, maxPrice = Model.MaxPrice, sortBy = Model.SortBy, page = Model.CurrentPage - 1 }, new { @class = "page-link" + (Model.CurrentPage <= 1 ? " is-disabled" : "") })

                    @for (int p = 1; p <= Model.TotalPages; p++)
                    {
                        @Html.ActionLink(p.ToString(), "Index", "Home", new { searchTerm = Model.SearchTerm, categoryId = Model.CategoryId, minPrice = Model.MinPrice, maxPrice = Model.MaxPrice, sortBy = Model.SortBy, page = p }, new { @class = "page-link" + (p == Model.CurrentPage ? " is-active" : "") })
                    }

                    @Html.ActionLink("›", "Index", "Home", new { searchTerm = Model.SearchTerm, categoryId = Model.CategoryId, minPrice = Model.MinPrice, maxPrice = Model.MaxPrice, sortBy = Model.SortBy, page = Model.CurrentPage + 1 }, new { @class = "page-link" + (Model.CurrentPage >= Model.TotalPages ? " is-disabled" : "") })
                </div>
            }
        }
        else
        {
            <div class="empty-state">
                <i class="fa-solid fa-basket-shopping"></i>
                Không tìm thấy sản phẩm phù hợp. Thử từ khoá, danh mục hoặc khoảng giá khác nhé.
            </div>
        }
    </section>
</div>

<!-- MODAL OVERLAY TRANG GHI ĐÈ CHI TIẾT SẢN PHẨM & BÌNH LUẬN QTV -->
<div class="modal fade" id="homeProductDetailModal" tabindex="-1" aria-labelledby="homeProductDetailModalLabel" aria-hidden="true" style="display: none !important; visibility: hidden !important;">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header bg-dark text-white py-3">
                <h5 class="modal-title font-weight-bold" id="homeProductDetailModalLabel">
                    <i class="fa-solid fa-circle-info text-warning me-2"></i><span id="pmd-name">Chi tiết sản phẩm</span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 bg-light">
                <!-- KHUNG THÔNG TIN SẢN PHẨM -->
                <div class="card border-0 shadow-sm rounded-3 p-3 mb-4 bg-white">
                    <div class="row g-4 align-items-center">
                        <div class="col-md-5 text-center border-end">
                            <img id="pmd-image" src="" class="img-fluid rounded-3 p-2 border" style="max-height: 240px; object-fit: contain;" />
                        </div>
                        <div class="col-md-7">
                            <span class="badge bg-success bg-opacity-10 text-success fw-bold p-2 mb-2" id="pmd-category"></span>
                            <h3 class="fw-bold text-dark mb-2" id="pmd-title"></h3>

                            <!-- ĐÁNH GIÁ SAO -->
                            <div class="d-flex align-items-center gap-2 mb-3">
                                <div class="text-warning fs-5 fw-bold"><i class="fa-solid fa-star"></i> <span id="pmd-avg-rating">5.0</span> / 5</div>
                                <span class="text-muted small">(<span id="pmd-review-count">0</span> đánh giá)</span>
                            </div>

                            <div class="text-danger fw-bold fs-2 mb-3" id="pmd-price"></div>

                            <div class="p-3 bg-light rounded-3 border">
                                <span class="text-muted small fw-bold text-uppercase d-block mb-1">Mô tả sản phẩm:</span>
                                <p id="pmd-description" class="text-dark small m-0"></p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- KHUNG ĐÁNH GIÁ TỪ KHÁCH HÀNG ĐÃ MUA (PHÍA TRÊN PHẦN HỎI ĐÁP) -->
                <div class="card border-0 shadow-sm rounded-3 p-4 mb-4 bg-white">
                    <h5 class="fw-bold text-dark mb-3"><i class="fa-solid fa-star text-warning me-2"></i>Đánh giá từ khách hàng đã mua</h5>
                    <div id="pmd-reviews-container">
                        <!-- Render qua JS -->
                    </div>
                </div>

                <!-- LUỒNG BÌNH LUẬN & HỎI ĐÁP TRAO ĐỔI VỚI ADMIN -->
                <div class="card border-0 shadow-sm rounded-3 p-4 bg-white">
                    <h5 class="fw-bold text-dark mb-3"><i class="fa-solid fa-comments text-primary me-2"></i>Bình luận</h5>

                    <!-- Ô nhập câu hỏi / bình luận của khách -->
                    <div class="mb-4">
                        <input type="hidden" id="pmd-current-id" value="0" />
                        <textarea id="pmd-question-input" rows="3" class="form-control rounded-3 p-3 border-2" placeholder="Mời bạn bình luận hoặc đặt câu hỏi"></textarea>
                        <div class="d-flex justify-content-end mt-2">
                            <button type="button" id="btnPostQuestion" class="btn btn-primary px-4 fw-bold shadow-sm rounded-3">
                                <i class="fa-solid fa-paper-plane me-1"></i> Gửi bình luận
                            </button>
                        </div>
                    </div>

                    <hr />

                    <!-- Danh sách bình luận & phản hồi Admin QTV -->
                    <h6 class="fw-bold text-dark mb-3">Tất cả bình luận & hỏi đáp:</h6>
                    <div id="pmd-questions-container">
                        <!-- Render từ Javascript -->
                    </div>
                </div>

            </div>
            <div class="modal-footer bg-white border-top">
                <button type="button" class="btn btn-secondary px-4 fw-bold" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
    $(document).ready(function () {
        // Flash Sale Countdown
        var el = document.getElementById("flashBanner");
        if (el) {
            var targetHour = parseInt(el.getAttribute("data-target-hour"), 10);
            var targetMinute = parseInt(el.getAttribute("data-target-minute"), 10);
            var timerEl = el.querySelector(".flash-timer");

            function pad(n) { return n < 10 ? "0" + n : "" + n; }

            function tick() {
                var now = new Date();
                var target = new Date(now.getFullYear(), now.getMonth(), now.getDate(), targetHour, targetMinute, 0);
                if (target <= now) target.setDate(target.getDate() + 1);

                var diff = Math.max(0, target - now);
                var h = Math.floor(diff / 3600000);
                var m = Math.floor((diff % 3600000) / 60000);
                var s = Math.floor((diff % 60000) / 1000);

                if (timerEl) timerEl.textContent = pad(h) + ":" + pad(m) + ":" + pad(s);
            }

            tick();
            setInterval(tick, 1000);
        }

        // Hiệu ứng hình ảnh sản phẩm bay vào giỏ hàng (Fly to Cart)
        function flyToCart(productCard) {
            var img = productCard.find(".product-media img");
            var cartTarget = $(".cart-icon-wrap").length ? $(".cart-icon-wrap") : $(".header-cart");

            if (img.length && cartTarget.length) {
                var imgOffset = img[0].getBoundingClientRect();
                var cartOffset = cartTarget[0].getBoundingClientRect();

                var $flyImg = $('<img src="' + img.attr('src') + '" class="flying-cart-img" />');
                $flyImg.css({
                    top: imgOffset.top + 'px',
                    left: imgOffset.left + 'px',
                    width: imgOffset.width + 'px',
                    height: imgOffset.height + 'px',
                    opacity: 1
                });

                $('body').append($flyImg);

                setTimeout(function () {
                    $flyImg.css({
                        top: (cartOffset.top - 5) + 'px',
                        left: (cartOffset.left - 5) + 'px',
                        width: '32px',
                        height: '32px',
                        opacity: 0.15,
                        transform: 'rotate(720deg) scale(0.25)'
                    });
                }, 30);

                setTimeout(function () {
                    $flyImg.remove();

                    // Nẩy biểu tượng giỏ hàng ở Header
                    cartTarget.removeClass("cart-bounce");
                    if (cartTarget[0]) {
                        void cartTarget[0].offsetWidth; // trigger reflow
                    }
                    cartTarget.addClass("cart-bounce");
                }, 850);
            }
        }

        // Thêm vào giỏ hàng AJAX với hiệu ứng bay
        $(document).on("click", ".btn-add-cart", function (e) {
            e.preventDefault();
            e.stopPropagation();
            var btn = $(this);
            if (btn.is(":disabled")) return;

            var id = btn.attr("data-id") || btn.data("id") || btn.closest("[data-id]").attr("data-id") || btn.closest("[data-id]").data("id");
            if (!id) return;

            var productCard = btn.closest(".product-card");

            // Kích hoạt hiệu ứng ảnh bay lên giỏ hàng
            if (productCard.length) {
                flyToCart(productCard);
            }

            btn.prop("disabled", true).html('<i class="fa-solid fa-spinner fa-spin"></i> Đang thêm...');

            $.ajax({
                url: '@Url.Action("AddToCart", "Cart")',
                type: 'POST',
                data: { productId: id, quantity: 1 },
                success: function (res) {
                    if (res.success) {
                        btn.removeClass("btn-add-cart").addClass("btn-success").html('<i class="fa-solid fa-check"></i> Đã thêm!');
                        setTimeout(function () {
                            location.reload();
                        }, 850);
                    } else {
                        alert(res.message || "Không thể thêm vào giỏ hàng!");
                        btn.prop("disabled", false).html('<i class="fa-solid fa-cart-plus"></i> Mua');
                    }
                },
                error: function (xhr, status, err) {
                    alert("Lỗi hệ thống khi thêm vào giỏ hàng: " + (xhr.responseText || err));
                    btn.prop("disabled", false).html('<i class="fa-solid fa-cart-plus"></i> Mua');
                }
            });
        });

        // Xử lý mở Modal Chi Tiết Sản Phẩm
        $(document).on('click', '.btn-open-detail', function (e) {
            e.preventDefault();
            e.stopPropagation();
            var productId = $(this).attr('data-id') || $(this).data('id') || $(this).closest('[data-id]').attr('data-id') || $(this).closest('[data-id]').data('id');
            if (productId) {
                loadProductDetailModal(productId);
            }
        });

        function loadProductDetailModal(productId) {
            var modalEl = document.getElementById('homeProductDetailModal');
            if (!modalEl) {
                alert("Không tìm thấy modal chi tiết sản phẩm!");
                return;
            }

            // Đặt trạng thái đang tải
            $('#pmd-current-id').val(productId);
            $('#pmd-name').text('Đang tải...');
            $('#pmd-title').text('Đang tải thông tin sản phẩm...');
            $('#pmd-image').attr('src', '/Content/images/no-image.png');
            $('#pmd-category').text('Danh mục: ...');
            $('#pmd-price').text('...');
            $('#pmd-description').text('Đang nạp dữ liệu chi tiết...');
            $('#pmd-questions-container').html('<div class="text-center py-3"><i class="fa-solid fa-spinner fa-spin fs-3 text-success"></i></div>');

            // Mở modal ngay lập tức
            showModalInstance(modalEl);

            // Tải dữ liệu qua AJAX
            $.ajax({
                url: '@Url.Action("GetProductDetailJson", "Product")',
                type: 'GET',
                data: { productId: productId },
                success: function (res) {
                    if (res.success && res.data) {
                        var d = res.data;
                        $('#pmd-current-id').val(d.id);
                        $('#pmd-name').text(d.name || '');
                        $('#pmd-title').text(d.name || '');
                        $('#pmd-image').attr('src', d.imageUrl || '/Content/images/no-image.png');
                        $('#pmd-category').text('Danh mục: ' + (d.categoryName || 'Chung'));
                        $('#pmd-avg-rating').text(d.avgRating || '5.0');
                        $('#pmd-review-count').text(d.reviewCount || '0');
                        $('#pmd-price').text(d.price ? d.price.toLocaleString('vi-VN') + ' ₫' : '0 ₫');
                        $('#pmd-stock').html(d.quantity > 0 ? '<span class="text-success fw-bold">Còn hàng (' + d.quantity + ')</span>' : '<span class="text-danger fw-bold">Hết hàng</span>');
                        $('#pmd-description').text(d.description || 'Sản phẩm tươi ngon, đảm bảo chất lượng từ Bách Hóa Xanh.');

                        renderReviewsList(d.reviews);
                        renderQuestionsList(d.questions, res.isAdmin);

                        // Ghi log hành vi xem sản phẩm ngầm
                        if (window.BHXTracker) {
                            window.BHXTracker.logEvent('ViewProduct', d.id, d.name);
                        }
                    } else {
                        $('#pmd-description').text(res.message || "Không nạp được thông tin chi tiết sản phẩm!");
                    }
                },
                error: function (xhr, status, err) {
                    $('#pmd-description').text("Lỗi nạp chi tiết sản phẩm: " + (xhr.responseText || err));
                }
            });
        }

        // Render danh sách Đánh Giá từ khách hàng
        function renderReviewsList(reviews) {
            var container = $('#pmd-reviews-container');
            container.empty();

            if (!reviews || reviews.length === 0) {
                container.html('<div class="text-center py-3 text-muted"><i class="fa-solid fa-star-half-stroke fs-3 d-block mb-1 opacity-50"></i>Chưa có đánh giá nào cho sản phẩm này.</div>');
                return;
            }

            $.each(reviews, function (i, r) {
                var stars = '';
                for (var s = 1; s <= 5; s++) {
                    if (s <= r.rating) {
                        stars += '<i class="fa-solid fa-star text-warning"></i>';
                    } else {
                        stars += '<i class="fa-regular fa-star text-muted"></i>';
                    }
                }

                var html = '<div class="p-3 mb-3 bg-light rounded-3 border">' +
                    '<div class="d-flex justify-content-between align-items-center mb-1">' +
                    '<div class="fw-bold text-dark fs-6">' +
                    '<i class="fa-solid fa-user-circle text-success me-1"></i>' + r.userName + ' ' +
                    '<span class="ms-2 fs-6">' + stars + '</span>' +
                    '</div>' +
                    '<small class="text-muted"><i class="fa-regular fa-clock me-1"></i>' + r.createdDate + '</small>' +
                    '</div>' +
                    '<div class="text-dark mt-2 ms-4">' +
                    '<i class="fa-solid fa-quote-left text-muted me-2 opacity-50"></i><strong>' + (r.comment || 'Không có nhận xét') + '</strong>' +
                    '</div>' +
                    '</div>';

                container.append(html);
            });
        }

        function showModalInstance(modalEl) {
            modalEl.style.setProperty('display', 'block', 'important');
            modalEl.style.setProperty('visibility', 'visible', 'important');
            try {
                if (typeof bootstrap !== 'undefined' && bootstrap.Modal) {
                    var detailModal = bootstrap.Modal.getOrCreateInstance(modalEl);
                    detailModal.show();
                } else if (typeof $(modalEl).modal === 'function') {
                    $(modalEl).modal('show');
                } else {
                    modalEl.classList.add('show');
                }
            } catch (err) {
                if (typeof $(modalEl).modal === 'function') {
                    $(modalEl).modal('show');
                }
            }
        }

        // Tự động ẩn lại modal khi bấm nút Đóng hoặc click backdrop
        $(document).on('hidden.bs.modal', '#homeProductDetailModal', function () {
            this.style.setProperty('display', 'none', 'important');
            this.style.setProperty('visibility', 'hidden', 'important');
        });

        function renderQuestionsList(questions, isAdmin) {
            var container = $('#pmd-questions-container');
            container.empty();

            if (!questions || questions.length === 0) {
                container.html('<div class="text-center py-4 text-muted"><i class="fa-solid fa-comment-slash fs-2 d-block mb-2"></i>Chưa có bình luận nào. Hãy là người đầu tiên đặt câu hỏi!</div>');
                return;
            }

            $.each(questions, function (i, q) {
                var html = '<div class="border-bottom pb-3 mb-3">' +
                    '<div class="fw-bold text-dark fs-6 mb-1">' + q.userName + '</div>' +
                    '<div class="text-dark mb-2">' + q.content + '</div>' +
                    '<div class="d-flex align-items-center gap-3 small text-muted mb-2">' +
                    '<span><i class="fa-regular fa-clock me-1"></i>' + q.createdDate + '</span>' +
                    '<span class="text-primary fw-bold" style="cursor:pointer;"><i class="fa-regular fa-thumbs-up me-1"></i>Thích</span>' +
                    '</div>';

                if (q.answer && q.answer.trim().length > 0) {
                    html += '<div class="bg-light border rounded-3 p-3 ms-3 mt-2">' +
                        '<div class="d-flex align-items-center gap-2 mb-2">' +
                        '<div class="rounded-circle bg-success text-white d-flex align-items-center justify-content-center fw-bold" style="width: 32px; height: 32px; font-size: 14px;"><i class="fa-solid fa-leaf"></i></div>' +
                        '<div class="fw-bold text-dark">' + (q.answerBy || "Nguyễn Thị Ngọc Điều") + '</div>' +
                        '<span class="badge bg-warning text-dark fw-bold px-2 py-1" style="font-size: 11px;">QTV</span>' +
                        '</div>' +
                        '<div class="text-dark small mb-2 ms-4">' + q.answer + '</div>' +
                        '<div class="small text-muted ms-4"><i class="fa-regular fa-clock me-1"></i>Hỗ trợ Bách Hóa Xanh</div>' +
                        '</div>';
                } else if (isAdmin) {
                    html += '<div class="ms-3 mt-2 bg-warning bg-opacity-10 border border-warning p-2 rounded-3">' +
                        '<div class="small fw-bold text-dark mb-1"><i class="fa-solid fa-user-shield text-warning me-1"></i>Trả lời với tư cách QTV:</div>' +
                        '<div class="input-group">' +
                        '<input type="text" class="form-control form-control-sm admin-answer-input" placeholder="Nhập câu trả lời tư vấn cho khách..." />' +
                        '<button type="button" class="btn btn-sm btn-warning fw-bold btn-submit-admin-answer" data-qid="' + q.id + '">Gửi QTV</button>' +
                        '</div>' +
                        '</div>';
                }

                html += '</div>';
                container.append(html);
            });
        }

        // Gửi bình luận mới của khách
        $(document).on('click', '#btnPostQuestion', function () {
            var productId = $('#pmd-current-id').val();
            var content = $('#pmd-question-input').val().trim();

            if (!content) {
                alert("Vui lòng nhập nội dung bình luận!");
                return;
            }

            $.post('@Url.Action("PostQuestion", "Product")', { productId: productId, content: content }, function (res) {
                alert(res.message);
                if (res.success) {
                    $('#pmd-question-input').val('');
                    loadProductDetailModal(productId);
                }
            });
        });

        // Admin bấm gửi trả lời QTV
        $(document).on('click', '.btn-submit-admin-answer', function () {
            var questionId = $(this).data('qid');
            var answerInput = $(this).closest('.input-group').find('.admin-answer-input');
            var answer = answerInput.val().trim();
            var productId = $('#pmd-current-id').val();

            if (!answer) {
                alert("Vui lòng nhập nội dung trả lời QTV!");
                return;
            }

            $.post('@Url.Action("PostAnswerAdmin", "Product")', { questionId: questionId, answer: answer }, function (res) {
                alert(res.message);
                if (res.success) {
                    loadProductDetailModal(productId);
                }
            });
        });

        // =========================================================
        // LOGIC PHÂN TRANG RÚT GỌN (FRONT-END ONLY)
        // =========================================================
        var $pagination = $('.pagination-bar');
        if ($pagination.length > 0) {
            var $allLinks = $pagination.find('.page-link');
            var $prevBtn = $allLinks.first(); // Nút ‹
            var $nextBtn = $allLinks.last();  // Nút ›
            var $pages = $allLinks.not($prevBtn).not($nextBtn); // Các trang số (1, 2, 3...)
            var totalPages = $pages.length;

            if (totalPages > 6) {
                var activeIndex = $pages.index($pages.filter('.is-active'));
                if (activeIndex === -1) activeIndex = 0;

                $pages.hide(); // Tạm ẩn toàn bộ

                var start = Math.max(0, activeIndex - 2);
                var end = start + 5;

                if (end >= totalPages) {
                    end = totalPages - 1;
                    start = Math.max(0, end - 5);
                }

                for (var i = start; i <= end; i++) {
                    $pages.eq(i).show();
                }

                if (start > 0) {
                    $('<span class="fw-bold align-self-end px-2 text-muted pb-2">...</span>').insertBefore($pages.eq(start));
                }
                if (end < totalPages - 1) {
                    $('<span class="fw-bold align-self-end px-2 text-muted pb-2">...</span>').insertAfter($pages.eq(end));
                }
            }
        }
    });
    </script>
}