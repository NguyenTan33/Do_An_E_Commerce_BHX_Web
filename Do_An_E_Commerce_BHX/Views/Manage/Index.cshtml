@model Do_An_E_Commerce_BHX.Models.IndexViewModel
@{
    ViewBag.Title = "Quản lý tài khoản cá nhân";
    Layout = "~/Views/Shared/_Layout.cshtml";

    string fullName = !string.IsNullOrWhiteSpace(Model.FullName) ? Model.FullName : "Khách hàng";
    string phone = !string.IsNullOrWhiteSpace(Model.PhoneNumber) ? Model.PhoneNumber : "Chưa cập nhật";
    int points = Model.LoyaltyPoints;
    string initial = !string.IsNullOrEmpty(fullName) ? fullName.Substring(0, Math.Min(2, fullName.Length)).ToUpper() : "KH";
}

@section Styles {
    <style>
        /* ===== USER PROFILE MANAGEMENT DASHBOARD ===== */
        .profile-container {
            max-width: 1140px;
            margin: 0 auto;
        }

        .profile-sidebar-card {
            background: #ffffff;
            border: 1px solid #e5e7eb;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 4px 20px rgba(14, 42, 32, 0.05);
        }

        .profile-avatar-header {
            background: linear-gradient(135deg, #163B2E 0%, #1F6B3F 100%);
            padding: 32px 20px;
            text-align: center;
            color: #ffffff;
            position: relative;
        }

        .profile-avatar-circle {
            width: 84px;
            height: 84px;
            background: #ffffff;
            color: #1F6B3F;
            border: 4px solid rgba(255, 255, 255, 0.3);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            font-weight: 800;
            margin: 0 auto 12px;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
        }

        .profile-menu-list {
            list-style: none;
            padding: 12px;
            margin: 0;
        }

        .profile-menu-item a, .profile-menu-item button {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 16px;
            border-radius: 12px;
            color: #374151;
            font-weight: 600;
            font-size: 0.9375rem;
            text-decoration: none;
            transition: all 0.2s ease;
            width: 100%;
            border: none;
            background: transparent;
            text-align: left;
        }

        .profile-menu-item a:hover, .profile-menu-item button:hover {
            background: #f0fdf4;
            color: #1F6B3F;
        }

        .profile-menu-item.active a {
            background: #1F6B3F;
            color: #ffffff;
            box-shadow: 0 4px 12px rgba(31, 107, 63, 0.25);
        }

        .profile-content-card {
            background: #ffffff;
            border: 1px solid #e5e7eb;
            border-radius: 20px;
            padding: 28px;
            box-shadow: 0 4px 20px rgba(14, 42, 32, 0.05);
            margin-bottom: 24px;
        }

        .profile-card-title {
            font-size: 1.125rem;
            font-weight: 800;
            color: #1E2A22;
            margin-bottom: 20px;
            padding-bottom: 12px;
            border-bottom: 2px solid #f3f4f6;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .info-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 16px 0;
            border-bottom: 1px dashed #e5e7eb;
            flex-wrap: wrap;
            gap: 12px;
        }

        .info-row:last-child {
            border-bottom: none;
        }

        .info-label {
            font-size: 0.8125rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #6b7280;
            font-weight: 700;
            margin-bottom: 2px;
        }

        .info-value {
            font-size: 1rem;
            font-weight: 700;
            color: #111827;
        }

        .btn-edit-inline {
            background: rgba(31, 107, 63, 0.1);
            color: #1F6B3F;
            font-weight: 700;
            font-size: 0.875rem;
            padding: 8px 18px;
            border-radius: 20px;
            border: none;
            transition: all 0.2s ease;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .btn-edit-inline:hover {
            background: #1F6B3F;
            color: #ffffff;
            transform: translateY(-1px);
        }

        .edit-form-box {
            display: none;
            background: #f9fafb;
            border: 1px solid #e5e7eb;
            border-radius: 14px;
            padding: 20px;
            margin-top: 10px;
            width: 100%;
        }

        .quick-shortcut-card {
            border-radius: 16px;
            padding: 20px;
            transition: all 0.25s ease;
            border: 1px solid transparent;
            height: 100%;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .quick-shortcut-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.08);
        }

        .shortcut-orders {
            background: #f0fdf4;
            border-color: #bbf7d0;
        }

        .shortcut-vouchers {
            background: #fffbe8;
            border-color: #fde68a;
        }

        .shortcut-address {
            background: #f0f9ff;
            border-color: #bae6fd;
        }
    </style>
}

<div class="container py-4 profile-container">
    <!-- TIÊU ĐỀ BREADCRUMB -->
    <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
        <div>
            <h3 class="fw-bold text-dark m-0"><i class="fa-solid fa-user-gear text-success me-2"></i>Quản Lý Tài Khoản Cá Nhân</h3>
            <small class="text-muted">Cập nhật thông tin cá nhân, kiểm tra ví voucher và theo dõi đơn hàng</small>
        </div>
        <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary btn-sm rounded-pill px-3 fw-bold">
            <i class="fa-solid fa-house me-1"></i> Về trang chủ
        </a>
    </div>

    <!-- NỘI DUNG CHÍNH 2 CỘT RESPONSIVE -->
    <div class="row g-4">
        <!-- CỘT TRÁI: SIDEBAR HỒ SƠ & MENU -->
        <div class="col-lg-4">
            <div class="profile-sidebar-card">
                <!-- AVATAR HEADER -->
                <div class="profile-avatar-header">
                    <div class="profile-avatar-circle">
                        @initial
                    </div>
                    <h4 class="fw-bold m-0 mb-1">@fullName</h4>
                    <div class="d-inline-flex align-items-center gap-2 mt-2">
                        @Do_An_E_Commerce_BHX.Models.CustomerTierHelper.GetTierBadgeHtml(points)
                    </div>
                </div>

                <!-- DỊCH VỤ & MENU CÁ NHÂN -->
                <ul class="profile-menu-list">
                    <li class="profile-menu-item active">
                        <a href="@Url.Action("Index", "Manage")">
                            <i class="fa-solid fa-user text-success"></i>
                            <span>Thông tin tài khoản</span>
                        </a>
                    </li>
                    <li class="profile-menu-item">
                        <a href="@Url.Action("MyOrders", "Manage")">
                            <i class="fa-solid fa-boxes-packing text-primary"></i>
                            <span>Đơn hàng của tôi</span>
                        </a>
                    </li>
                    <li class="profile-menu-item">
                        <a href="@Url.Action("MyVouchers", "Manage")">
                            <i class="fa-solid fa-ticket text-warning"></i>
                            <span>Ví Mã Giảm Giá</span>
                        </a>
                    </li>
                    <li class="profile-menu-item">
                        <a href="@Url.Action("Index", "UserAddress")">
                            <i class="fa-solid fa-map-location-dot text-danger"></i>
                            <span>Sổ địa chỉ nhận hàng</span>
                        </a>
                    </li>
                    <li class="profile-menu-item">
                        <a href="@Url.Action("ChangePassword", "Manage")">
                            <i class="fa-solid fa-lock text-info"></i>
                            <span>Đổi mật khẩu</span>
                        </a>
                    </li>
                    <li class="profile-menu-item border-top mt-2 pt-2">
                        @using (Html.BeginForm("LogOff", "Account", FormMethod.Post, new { id = "logoutFormSide" }))
                        {
                            @Html.AntiForgeryToken()
                            <button type="submit" class="text-danger fw-bold">
                                <i class="fa-solid fa-right-from-bracket me-1"></i> Đăng xuất tài khoản
                            </button>
                        }
                    </li>
                </ul>
            </div>
        </div>

        <!-- CỘT PHẢI: NỘI DUNG CHI TIẾT -->
        <div class="col-lg-8">
            <!-- THÔNG BÁO STATUS NẾU CÓ -->
            @if (!string.IsNullOrEmpty(ViewBag.StatusMessage as string))
            {
                <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm mb-4" role="alert">
                    <i class="fa-solid fa-circle-check me-2"></i> <strong>@ViewBag.StatusMessage</strong>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <!-- 1. THẺ THÔNG TIN CÁ NHÂN -->
            <div class="profile-content-card">
                <div class="profile-card-title">
                    <i class="fa-solid fa-id-card text-success fs-4"></i>
                    <span>Thông Tin Cá Nhân</span>
                </div>

                <!-- HỌ VÀ TÊN -->
                <div class="info-row">
                    <div>
                        <div class="info-label">Họ và Tên</div>
                        <div class="info-value">@fullName</div>
                    </div>
                    <button type="button" class="btn-edit-inline" onclick="toggleEditBox('name-edit-form')">
                        <i class="fa-solid fa-pen-to-square"></i> Cập nhật
                    </button>
                </div>
                <!-- FORM ĐỔI HỌ TÊN -->
                <div class="edit-form-box" id="name-edit-form">
                    @using (Html.BeginForm("UpdateName", "Manage", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <label class="form-label fw-bold small text-dark">Nhập Họ và Tên mới <span class="text-danger">*</span></label>
                        <div class="input-group mb-3">
                            <span class="input-group-text bg-white"><i class="fa-solid fa-user text-muted"></i></span>
                            <input type="text" name="FullName" value="@Model.FullName" class="form-control" placeholder="Ví dụ: Nguyễn Minh Tân" required />
                        </div>
                        <div class="d-flex justify-content-end gap-2">
                            <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3" onclick="toggleEditBox('name-edit-form')">Hủy</button>
                            <button type="submit" class="btn btn-sm btn-success rounded-pill px-4 fw-bold">Lưu thay đổi</button>
                        </div>
                    }
                </div>

                <!-- SỐ ĐIỆN THOẠI -->
                <div class="info-row">
                    <div>
                        <div class="info-label">Số Điện Thoại Liên Hệ</div>
                        <div class="info-value">@phone</div>
                    </div>
                    <button type="button" class="btn-edit-inline" onclick="toggleEditBox('phone-edit-form')">
                        <i class="fa-solid fa-phone"></i> @(string.IsNullOrEmpty(Model.PhoneNumber) ? "Thêm SĐT" : "Cập nhật")
                    </button>
                </div>
                <!-- FORM ĐỔI SĐT -->
                <div class="edit-form-box" id="phone-edit-form">
                    @using (Html.BeginForm("UpdatePhone", "Manage", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <label class="form-label fw-bold small text-dark">Nhập Số điện thoại mới <span class="text-danger">*</span></label>
                        <div class="input-group mb-3">
                            <span class="input-group-text bg-white"><i class="fa-solid fa-mobile-screen text-muted"></i></span>
                            <input type="text" name="PhoneNumber" value="@Model.PhoneNumber" class="form-control" placeholder="Ví dụ: 0703342732" required />
                        </div>
                        <div class="d-flex justify-content-end gap-2">
                            <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3" onclick="toggleEditBox('phone-edit-form')">Hủy</button>
                            <button type="submit" class="btn btn-sm btn-success rounded-pill px-4 fw-bold">Lưu SĐT</button>
                        </div>
                    }
                </div>

                <!-- TÊN ĐĂNG NHẬP / EMAIL -->
                <div class="info-row">
                    <div>
                        <div class="info-label">Tài Khoản Đăng Nhập (Email)</div>
                        <div class="info-value">@User.Identity.Name</div>
                    </div>
                    <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 rounded-pill fw-bold">
                        <i class="fa-solid fa-shield-check me-1"></i> Đã xác thực
                    </span>
                </div>
            </div>

            <!-- 2. THẺ ĐIỂM TÍCH LŨY THƯỞNG -->
            <div class="profile-content-card border-start border-4 border-warning">
                <div class="profile-card-title justify-content-between">
                    <div class="d-flex align-items-center gap-2">
                        <i class="fa-solid fa-coins text-warning fs-4"></i>
                        <span>Điểm Thưởng Tích Lũy</span>
                    </div>
                    <span class="badge bg-warning text-dark fs-6 px-3 py-2 rounded-pill fw-bold">
                        @points điểm
                    </span>
                </div>
                <div class="row align-items-center g-3">
                    <div class="col-md-8">
                        <p class="text-muted small mb-0">
                            Mỗi <strong>10.000 VNĐ</strong> mua sắm bạn nhận ngay <strong>1 điểm thưởng</strong>.
                            Điểm thưởng được sử dụng trực tiếp để trừ tiền thanh toán cho các đơn hàng tiếp theo (<strong>100 điểm = 1.000 VNĐ</strong>).
                        </p>
                    </div>
                    <div class="col-md-4 text-md-end">
                        <a href="@Url.Action("Index", "Cart")" class="btn btn-warning btn-sm rounded-pill px-3 fw-bold text-dark shadow-sm">
                            <i class="fa-solid fa-cart-plus me-1"></i> Mua hàng tích điểm
                        </a>
                    </div>
                </div>
            </div>

            <!-- 3. PHÍM TẮT TRUY CẬP NHANH -->
            <div class="row g-3">
                <!-- KHỐI ĐƠN HÀNG -->
                <div class="col-md-4">
                    <div class="quick-shortcut-card shortcut-orders">
                        <div>
                            <h6 class="fw-bold text-success mb-1"><i class="fa-solid fa-boxes-packing me-1"></i> Đơn hàng của tôi</h6>
                            <p class="text-muted small mb-3">Xem lịch sử mua hàng, trạng thái giao & gạch nợ.</p>
                        </div>
                        <a href="@Url.Action("MyOrders", "Manage")" class="btn btn-sm btn-success rounded-pill fw-bold w-100">
                            Xem đơn hàng
                        </a>
                    </div>
                </div>

                <!-- KHỐI VOUCHER -->
                <div class="col-md-4">
                    <div class="quick-shortcut-card shortcut-vouchers">
                        <div>
                            <h6 class="fw-bold text-warning mb-1"><i class="fa-solid fa-ticket me-1"></i> Ví Mã Giảm Giá</h6>
                            <p class="text-muted small mb-3">Lưu trữ voucher ưu đãi 0đ, 50k & khuyến mãi lớn.</p>
                        </div>
                        <a href="@Url.Action("MyVouchers", "Manage")" class="btn btn-sm btn-warning rounded-pill fw-bold text-dark w-100">
                            Mở ví Voucher
                        </a>
                    </div>
                </div>

                <!-- KHỐI SỔ ĐỊA CHỈ -->
                <div class="col-md-4">
                    <div class="quick-shortcut-card shortcut-address">
                        <div>
                            <h6 class="fw-bold text-info mb-1"><i class="fa-solid fa-location-dot me-1"></i> Sổ địa chỉ</h6>
                            <p class="text-muted small mb-3">Quản lý các địa chỉ giao hàng nhận nhanh.</p>
                        </div>
                        <a href="@Url.Action("Index", "UserAddress")" class="btn btn-sm btn-info rounded-pill fw-bold text-white w-100">
                            Sổ địa chỉ
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function toggleEditBox(id) {
            var box = document.getElementById(id);
            if (box) {
                if (box.style.display === "block") {
                    box.style.display = "none";
                } else {
                    box.style.display = "block";
                }
            }
        }
    </script>
}