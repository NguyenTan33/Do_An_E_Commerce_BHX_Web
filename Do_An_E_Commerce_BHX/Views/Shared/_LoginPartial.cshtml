@using Microsoft.AspNet.Identity
@using Microsoft.AspNet.Identity.Owin
@using Do_An_E_Commerce_BHX.Models

@if (Request.IsAuthenticated)
{
    ApplicationUser user = null;
    try
    {
        var manager = Context.GetOwinContext().GetUserManager<ApplicationUserManager>();
        user = manager.FindById(User.Identity.GetUserId());
    }
    catch { }

    var displayName = !string.IsNullOrWhiteSpace(user?.FullName)
        ? user.FullName
        : User.Identity.GetUserName();

    int userPoints = user != null ? user.LoyaltyPoints : 0;

    using (Html.BeginForm("LogOff", "Account", FormMethod.Post, new { id = "logoutForm", @class = "d-inline" }))
    {
        @Html.AntiForgeryToken()

        <div class="d-flex align-items-center gap-2">
            <!-- TÊN KHÁCH HÀNG (Bấm vào xem Quản lý tài khoản) -->
            <a href="@Url.Action("Index", "Manage")" class="d-flex align-items-center gap-1 text-decoration-none text-dark fw-bold" title="Quản lý tài khoản cá nhân">
                <i class="fa-solid fa-circle-user text-success fs-5"></i>
                <span class="text-dark fw-bold">@displayName</span>
            </a>

            <!-- BADGE HẠNG THÀNH VIÊN -->
            @CustomerTierHelper.GetTierBadgeHtml(userPoints)

            <!-- NÚT ĐĂNG XUẤT -->
            <a href="javascript:document.getElementById('logoutForm').submit()" class="btn btn-sm btn-outline-danger ms-1 px-2 py-1 rounded-pill fw-semibold" style="font-size: 0.8125rem;">
                <i class="fa-solid fa-right-from-bracket me-1"></i>Đăng xuất
            </a>
        </div>
    }
}
else
{
    <div class="d-flex align-items-center gap-2">
        <a href="@Url.Action("Register", "Account")" class="text-secondary fw-semibold text-decoration-none px-2" style="font-size: 0.875rem;">
            Đăng ký
        </a>
        <a href="@Url.Action("Login", "Account")" class="btn btn-sm btn-success fw-bold px-3 py-1 rounded-pill" style="font-size: 0.875rem;">
            <i class="fa-solid fa-right-to-bracket me-1"></i>Đăng nhập
        </a>
    </div>
}