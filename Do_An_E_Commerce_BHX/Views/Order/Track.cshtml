@{
    ViewBag.Title = "Tra cứu đơn hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string initialQuery = ViewBag.InitialQuery as string ?? "";
}

<div class="container py-4" style="max-width: 960px;">
    <!-- BANNER TIÊU ĐỀ -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
        <div class="card-body p-4 text-center">
            <div class="d-inline-flex align-items-center justify-content-center bg-success bg-opacity-10 text-success rounded-circle p-3 mb-2" style="width: 60px; height: 60px;">
                <i class="fa-solid fa-magnifying-glass-location fs-2"></i>
            </div>
            <h3 class="fw-bold text-dark mb-1">TRA CỨU TRẠNG THÁI ĐƠN HÀNG</h3>
            <p class="text-muted mb-3">Nhập <strong>Số điện thoại nhận hàng</strong> hoặc <strong>Mã đơn hàng</strong> để kiểm tra tình trạng giao hàng tức thì</p>

            <!-- FORM TÌM KIẾM -->
            <form id="track-form" class="row g-2 justify-content-center" style="max-width: 680px; margin: 0 auto;">
                <div class="col-md-9">
                    <div class="input-group input-group-lg shadow-sm rounded-3 overflow-hidden border">
                        <span class="input-group-text bg-white border-0 text-muted"><i class="fa-solid fa-search"></i></span>
                        <input type="text" id="track-query" class="form-control border-0 ps-0 fs-6" placeholder="Nhập SĐT nhận hàng (VD: 0901234567) hoặc Mã đơn (VD: 1005)..." value="@initialQuery" required />
                    </div>
                </div>
                <div class="col-md-3">
                    <button type="submit" id="btn-search-track" class="btn btn-success btn-lg w-100 fw-bold shadow-sm rounded-3">
                        <i class="fa-solid fa-magnifying-glass me-1"></i> TRA CỨU
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- KHUNG KẾT QUẢ HIỂN THỊ LIST ĐƠN HÀNG -->
    <div id="track-result-container">
        <div class="text-center py-5 text-muted bg-white rounded-4 border shadow-sm">
            <i class="fa-solid fa-box-open fs-1 mb-2 opacity-50 text-success"></i>
            <h6 class="fw-bold text-dark">Vui lòng nhập thông tin để tra cứu đơn hàng</h6>
            <p class="small text-muted mb-0">Hệ thống hỗ trợ tra cứu bằng số điện thoại người nhận hoặc mã số đơn hàng.</p>
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            var initialQuery = $('#track-query').val().trim();
            if (initialQuery) {
                doTrackSearch(initialQuery);
            }

            $('#track-form').on('submit', function (e) {
                e.preventDefault();
                var query = $('#track-query').val().trim();
                if (!query) {
                    alert("Vui lòng nhập Số điện thoại hoặc Mã đơn hàng!");
                    return;
                }
                doTrackSearch(query);
            });

            function doTrackSearch(query) {
                var btn = $('#btn-search-track');
                var container = $('#track-result-container');

                btn.prop('disabled', true).html('<i class="fa-solid fa-spinner fa-spin me-1"></i> ĐANG TÌM...');
                container.html('<div class="text-center py-5"><i class="fa-solid fa-spinner fa-spin fs-2 text-success mb-2 d-block"></i><span class="text-muted fw-bold">Đang tra cứu dữ liệu đơn hàng...</span></div>');

                $.post('@Url.Action("SearchOrderJson", "Order")', { query: query }, function (res) {
                    btn.prop('disabled', false).html('<i class="fa-solid fa-magnifying-glass me-1"></i> TRA CỨU');

                    if (!res.success) {
                        container.html('<div class="alert alert-warning text-center rounded-4 shadow-sm p-4"><i class="fa-solid fa-circle-exclamation fs-3 mb-2 d-block"></i><h5 class="fw-bold m-0">' + res.message + '</h5></div>');
                        return;
                    }

                    renderOrderList(res.orders, container);
                }).fail(function () {
                    btn.prop('disabled', false).html('<i class="fa-solid fa-magnifying-glass me-1"></i> TRA CỨU');
                    container.html('<div class="alert alert-danger text-center rounded-4 shadow-sm p-4"><i class="fa-solid fa-triangle-exclamation fs-3 mb-2 d-block"></i><h5 class="fw-bold m-0">Lỗi kết nối tra cứu! Vui lòng thử lại sau.</h5></div>');
                });
            }

            function renderOrderList(orders, container) {
                container.empty();
                var html = '<div class="d-flex justify-content-between align-items-center mb-3">' +
                    '<h5 class="fw-bold text-dark m-0"><i class="fa-solid fa-boxes-packing text-success me-2"></i>Kết quả tra cứu trạng thái (' + orders.length + ' đơn hàng):</h5>' +
                    '</div>';

                $.each(orders, function (i, o) {
                    var statusBadge = '';
                    if (o.orderStatus === 0) statusBadge = '<span class="badge bg-warning text-dark px-3 py-2 fs-6 rounded-pill"><i class="fa-solid fa-clock me-1"></i>Chờ duyệt</span>';
                    else if (o.orderStatus === 1) statusBadge = '<span class="badge bg-info text-dark px-3 py-2 fs-6 rounded-pill"><i class="fa-solid fa-check-double me-1"></i>Đã duyệt</span>';
                    else if (o.orderStatus === 2) statusBadge = '<span class="badge bg-primary px-3 py-2 fs-6 rounded-pill"><i class="fa-solid fa-box me-1"></i>Đã đóng gói</span>';
                    else if (o.orderStatus === 3) statusBadge = '<span class="badge bg-primary px-3 py-2 fs-6 rounded-pill"><i class="fa-solid fa-truck-fast me-1"></i>Đang giao hàng</span>';
                    else if (o.orderStatus === 4) statusBadge = '<span class="badge bg-success px-3 py-2 fs-6 rounded-pill"><i class="fa-solid fa-circle-check me-1"></i>Giao thành công</span>';
                    else statusBadge = '<span class="badge bg-danger px-3 py-2 fs-6 rounded-pill"><i class="fa-solid fa-xmark me-1"></i>Đã hủy</span>';

                    html += '<div class="card border-0 shadow-sm rounded-4 mb-4 bg-white overflow-hidden">' +
                        '<div class="card-header bg-light py-3 px-4 d-flex justify-content-between align-items-center flex-wrap gap-2 border-bottom">' +
                        '<div>' +
                        '<span class="fw-bold text-dark fs-5">Mã đơn: #' + o.id + '</span> &bull; ' +
                        '<small class="text-muted"><i class="fa-regular fa-clock me-1"></i>Ngày đặt: ' + o.orderDate + '</small>' +
                        '</div>' +
                        '<div>' + statusBadge + '</div>' +
                        '</div>' +
                        '<div class="card-body p-4">';

                    if (o.orderStatus === 5) {
                        html += '<div class="alert alert-danger d-flex align-items-center rounded-3 mb-0">' +
                            '<i class="fa-solid fa-circle-xmark fs-4 me-3"></i>' +
                            '<div><strong>Đơn hàng này đã bị hủy.</strong> Vui lòng liên hệ hotline bộ phận hỗ trợ nếu cần trợ giúp.</div>' +
                            '</div>';
                    } else {
                        var steps = [
                            { title: 'Tiếp nhận', icon: 'fa-file-invoice' },
                            { title: 'Đã duyệt', icon: 'fa-clipboard-check' },
                            { title: 'Đóng gói', icon: 'fa-box' },
                            { title: 'Đang giao', icon: 'fa-truck-fast' },
                            { title: 'Thành công', icon: 'fa-circle-check' }
                        ];

                        html += '<div class="row g-2 text-center my-2 position-relative">' +
                            '<div class="d-flex justify-content-between align-items-center w-100 flex-wrap gap-2">';

                        $.each(steps, function (idx, step) {
                            var isPassed = idx <= o.orderStatus;
                            var isCurrent = idx === o.orderStatus;
                            var stepBg = isCurrent ? 'bg-success text-white shadow' : (isPassed ? 'bg-success bg-opacity-25 text-success' : 'bg-light text-muted border');
                            var titleClass = isCurrent ? 'fw-bold text-success' : (isPassed ? 'fw-semibold text-dark' : 'text-muted');

                            html += '<div class="flex-fill p-2 rounded-3 text-center ' + (isCurrent ? 'border border-success bg-success bg-opacity-10' : '') + '">' +
                                '<div class="rounded-circle mx-auto d-flex align-items-center justify-content-center mb-1 ' + stepBg + '" style="width: 42px; height: 42px; font-size: 18px;">' +
                                '<i class="fa-solid ' + step.icon + '"></i>' +
                                '</div>' +
                                '<div class="small ' + titleClass + '">' + step.title + '</div>' +
                                '</div>';
                        });

                        html += '</div></div>';
                    }

                    html += '<div class="d-flex justify-content-between align-items-center pt-3 mt-3 border-top text-muted small flex-wrap gap-2">' +
                        '<div><i class="fa-solid fa-phone me-1"></i>SĐT nhận hàng: <strong>' + o.maskedPhone + '</strong></div>' +
                        '<div><i class="fa-solid fa-shield-halved me-1 text-primary"></i>Trạng thái thanh toán: <strong class="' + (o.paymentStatus === 'Đã thanh toán' ? 'text-success' : 'text-danger') + '">' + o.paymentStatus + '</strong></div>' +
                        '</div>';

                    html += '</div></div>';
                });

                container.html(html);
            }
        });
    </script>
}
