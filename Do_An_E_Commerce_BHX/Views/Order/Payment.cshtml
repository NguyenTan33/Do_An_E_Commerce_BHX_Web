@model Do_An_E_Commerce_BHX.Models.Entities.Order

@{
    Layout = null;
    string sePayBank = System.Configuration.ConfigurationManager.AppSettings["SePay_Bank"] ?? "VietinBank";
    string sePayAccNum = System.Configuration.ConfigurationManager.AppSettings["SePay_AccountNumber"] ?? "10123456789";
    string sePayAccName = System.Configuration.ConfigurationManager.AppSettings["SePay_AccountName"] ?? "NGUYEN MINH TAN";
    string qrUrl = $"https://qr.sepay.vn/img?bank={sePayBank}&acc={sePayAccNum}&template=compact&amount={(int)Model.TotalAmount}&des=SEVQRBHX{Model.Id}";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Thanh Toán Đơn Hàng #@Model.Id - Bách Hóa Xanh</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Montserrat:wght@600;700;800&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />

    <style>
        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(135deg, #091710 0%, #163b2e 50%, #0d241c 100%);
            background-attachment: fixed;
            color: #1e2a22;
            min-height: 100vh;
            padding-bottom: 50px;
        }

        h1, h2, h3, h4, h5, h6, .brand-font {
            font-family: 'Montserrat', 'Plus Jakarta Sans', sans-serif;
        }

        /* Top Navigation */
        .checkout-navbar {
            background: rgba(14, 42, 32, 0.85);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.12);
            padding: 16px 0;
            margin-bottom: 35px;
        }

        .brand-logo {
            color: #fff;
            font-size: 1.4rem;
            font-weight: 800;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .brand-logo i {
                color: #4ade80;
            }

        /* Stepper */
        .checkout-stepper {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .step-item {
            display: flex;
            align-items: center;
            gap: 8px;
            color: rgba(255, 255, 255, 0.5);
            font-size: 0.875rem;
            font-weight: 600;
        }

            .step-item.active {
                color: #4ade80;
            }

            .step-item.done {
                color: #ffffff;
            }

        .step-number {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.15);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.8125rem;
        }

        .step-item.active .step-number {
            background: #1F6B3F;
            color: #fff;
            box-shadow: 0 0 12px rgba(74, 222, 128, 0.4);
        }

        .step-item.done .step-number {
            background: #3F8F5C;
            color: #fff;
        }

        .step-divider {
            width: 40px;
            height: 2px;
            background: rgba(255, 255, 255, 0.2);
        }

        /* Glass Card */
        .glass-card {
            background: rgba(255, 255, 255, 0.97);
            border-radius: 20px;
            border: 1px solid rgba(255, 255, 255, 0.3);
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.3);
            overflow: hidden;
        }

        .payment-header {
            background: linear-gradient(135deg, #111827 0%, #163b2e 100%);
            color: #fff;
            padding: 24px 30px;
        }

        /* Nav Pills Tabs */
        .payment-tabs .nav-link {
            border-radius: 12px;
            padding: 16px;
            font-weight: 700;
            font-size: 0.9375rem;
            color: #4b5563;
            background: #f3f4f6;
            border: 2px solid transparent;
            transition: all 0.2s ease;
        }

            .payment-tabs .nav-link:hover {
                background: #e5e7eb;
            }

            .payment-tabs .nav-link.active {
                background: #f0fdf4;
                border-color: #1F6B3F;
                color: #166534;
                box-shadow: 0 6px 16px rgba(31, 107, 63, 0.15);
            }

        .btn-action-lg {
            padding: 16px;
            font-size: 1.05rem;
            font-weight: 800;
            border-radius: 12px;
            transition: all 0.2s ease;
        }

            .btn-action-lg:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 20px rgba(0, 0, 0, 0.2);
            }
    </style>
</head>
<body>

    <!-- NAVBAR -->
    <nav class="checkout-navbar">
        <div class="container d-flex justify-content-between align-items-center">
            <a href="@Url.Action("Index", "Home")" class="brand-logo">
                <i class="fa-solid fa-leaf"></i>
                <span>BÁCH HÓA XANH</span>
            </a>

            <!-- Stepper -->
            <div class="checkout-stepper d-none d-md-flex">
                <div class="step-item done">
                    <span class="step-number"><i class="fa-solid fa-check"></i></span>
                    <span>Thông tin đặt hàng</span>
                </div>
                <div class="step-divider"></div>
                <div class="step-item active">
                    <span class="step-number">2</span>
                    <span>Phương thức thanh toán</span>
                </div>
            </div>

            <a href="@Url.Action("Index", "Home")" class="btn btn-outline-light btn-sm rounded-pill px-3">
                <i class="fa-solid fa-house me-1"></i> Trang chủ
            </a>
        </div>
    </nav>

    <!-- MAIN CONTENT -->
    <div class="container">
        <div class="glass-card mx-auto" style="max-width: 860px;">
            <!-- CARD HEADER -->
            <div class="payment-header d-flex justify-content-between align-items-center">
                <div>
                    <h4 class="m-0 font-weight-bold"><i class="fa-solid fa-wallet text-warning me-2"></i>Chọn Phương Thức Thanh Toán</h4>
                    <div class="small text-muted mt-1">Đơn hàng đã khởi tạo thành công. Chọn phương thức để hoàn tất đơn hàng.</div>
                </div>
                <span class="badge bg-warning text-dark fs-6 px-3 py-2 rounded-pill">Mã đơn #@Model.Id</span>
            </div>

            <div class="p-4 p-md-5">
                <!-- TÓM TẮT ĐƠN HÀNG -->
                <div class="bg-light p-4 rounded-3 border mb-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <span class="text-secondary small">Người nhận hàng:</span>
                            <div class="fw-bold fs-6">@Model.ReceiverName (@Model.ReceiverPhone)</div>
                        </div>
                        <div class="col-md-6 text-md-end">
                            <span class="text-secondary small">Thời gian tạo đơn:</span>
                            <div class="fw-bold text-dark">@Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</div>
                        </div>
                        <div class="col-12 pt-2 border-top">
                            <span class="text-secondary small">Địa chỉ nhận hàng:</span>
                            <div class="fw-bold"><i class="fa-solid fa-map-marker-alt text-danger me-1"></i>@Model.ShippingAddress</div>
                        </div>
                        <div class="col-12 pt-3 border-top d-flex justify-content-between align-items-center">
                            <span class="fs-5 fw-bold">TỔNG TIỀN CẦN THANH TOÁN:</span>
                            <span class="text-danger fs-2 fw-bold">@Model.TotalAmount.ToString("N0") VNĐ</span>
                        </div>
                    </div>
                </div>

                <!-- HEADER NÚT CHỌN & THAY ĐỔI PHƯƠNG THỨC -->
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold text-dark m-0"><i class="fa-solid fa-hand-pointer text-success me-2"></i>Chọn phương thức thanh toán:</h6>
                    <button class="btn btn-outline-success btn-sm rounded-pill px-3 fw-bold" type="button" id="btnChangePaymentMethod">
                        <i class="fa-solid fa-arrows-rotate me-1"></i> Thay đổi phương thức
                    </button>
                </div>

                <!-- NAV TABS (CHỈ GIỮ SEPAY VIETQR VÀ COD) -->
                <ul class="nav nav-pills payment-tabs row g-3 mb-4" id="paymentTab" role="tablist">
                    <li class="nav-item col-md-6" role="presentation">
                        <button class="nav-link w-100 active py-3" id="bank-tab" data-bs-toggle="pill" data-bs-target="#bank-content" type="button" role="tab">
                            🏦 1. Chuyển Khoản QR Ngân Hàng (SePay Tự Động 24/7)
                        </button>
                    </li>
                    <li class="nav-item col-md-6" role="presentation">
                        <button class="nav-link w-100 py-3" id="cod-tab" data-bs-toggle="pill" data-bs-target="#cod-content" type="button" role="tab">
                            💵 2. Thanh Toán Khi Nhận Hàng (COD)
                        </button>
                    </li>
                </ul>

                <!-- TAB CONTENTS -->
                <div class="tab-content border rounded-3 p-4 bg-white shadow-sm" id="paymentTabContent">
                    <!-- 1. BANK TRANSFER / VIETQR SEPAY VIETINBANK (DEFAULT) -->
                    <div class="tab-pane fade show active" id="bank-content" role="tabpanel">
                        <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
                            <h5 class="fw-bold text-primary m-0"><i class="fa-solid fa-qrcode me-2"></i> Quét Mã VietQR Ngân Hàng VietinBank</h5>
                            <span class="badge bg-success px-3 py-2 fs-6 shadow-sm"><i class="fa-solid fa-bolt me-1"></i> Tự Động Gạch Nợ 24/7</span>
                        </div>

                        <div class="row align-items-center g-4">
                            <div class="col-md-5 text-center">
                                <div class="position-relative d-inline-block">
                                    <img src="@qrUrl"
                                         alt="Mã VietQR VietinBank Đơn #@Model.Id"
                                         class="img-fluid rounded-3 border shadow p-2 bg-white"
                                         style="max-height: 260px;" />
                                    <div class="position-absolute top-0 end-0 m-2">
                                        <span class="badge bg-danger rounded-pill shadow-sm fs-6 px-3 py-1"><i class="fa-solid fa-clock me-1"></i> <span id="countdown">15:00</span></span>
                                    </div>
                                </div>
                                <div class="small text-success fw-bold mt-3 p-2 bg-success bg-opacity-10 rounded-3 border border-success border-opacity-25 shadow-sm">
                                    <i class="fa-solid fa-spinner fa-spin me-1 fs-6"></i> Đang tự động kiểm tra biến động số dư qua SePay...
                                </div>
                            </div>
                            <div class="col-md-7">
                                <div class="bg-light p-3 rounded-3 border shadow-sm">
                                    <div class="mb-2 d-flex justify-content-between align-items-center">
                                        <span><strong>Ngân hàng:</strong> <span class="text-primary fw-bold fs-6">@sePayBank</span></span>
                                    </div>
                                    <div class="mb-2 d-flex justify-content-between align-items-center">
                                        <span><strong>Số tài khoản:</strong> <span class="text-danger fw-bold fs-4 ms-1" id="txtAccNum">@sePayAccNum</span></span>
                                        <button class="btn btn-sm btn-outline-primary py-1 px-3 rounded-pill fw-bold" onclick="copyText('@sePayAccNum', 'Số tài khoản')">
                                            <i class="fa-regular fa-copy me-1"></i> Copy
                                        </button>
                                    </div>
                                    <div class="mb-2"><strong>Chủ tài khoản:</strong> <span class="text-dark fw-bold">@sePayAccName</span></div>
                                    <div class="mb-2 d-flex justify-content-between align-items-center">
                                        <span><strong>Số tiền thanh toán:</strong> <span class="text-danger fw-bold fs-4">@Model.TotalAmount.ToString("N0") VNĐ</span></span>
                                        <button class="btn btn-sm btn-outline-primary py-1 px-3 rounded-pill fw-bold" onclick="copyText('@((int)Model.TotalAmount)', 'Số tiền')">
                                            <i class="fa-regular fa-copy me-1"></i> Copy
                                        </button>
                                    </div>
                                    <div class="mb-0 p-3 bg-warning bg-opacity-25 rounded-3 border border-warning d-flex justify-content-between align-items-center">
                                        <div>
                                            <span class="text-secondary small d-block fw-bold">Nội dung chuyển khoản (Bắt buộc):</span>
                                            <span class="text-danger fw-bold fs-5" id="txtContent">SEVQR BHX @Model.Id</span>
                                        </div>
                                        <button class="btn btn-sm btn-warning fw-bold text-dark px-3 py-2 rounded-pill shadow-sm" onclick="copyText('SEVQR BHX @Model.Id', 'Nội dung chuyển khoản')">
                                            <i class="fa-regular fa-copy me-1"></i> Copy
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 2. COD -->
                    <div class="tab-pane fade text-center py-4" id="cod-content" role="tabpanel">
                        <div class="text-success mb-3">
                            <i class="fa-solid fa-hand-holding-dollar" style="font-size: 4rem;"></i>
                        </div>
                        <h5 class="fw-bold fs-4">Thanh Toán Khi Nhận Hàng (COD)</h5>
                        <p class="text-muted max-w-500 mx-auto fs-6">Bạn sẽ thanh toán số tiền <strong class="text-danger fs-5">@Model.TotalAmount.ToString("N0") VNĐ</strong> bằng tiền mặt cho nhân viên giao hàng khi nhận sản phẩm.</p>
                        
                        <div class="d-flex justify-content-center gap-3 mt-4">
                            <button class="btn btn-outline-secondary px-4 py-2 rounded-pill btn-switch-method">
                                <i class="fa-solid fa-arrow-left me-1"></i> Đổi sang VietQR
                            </button>
                            <button id="btnConfirmCOD" class="btn btn-success btn-action-lg px-5 py-2 rounded-pill shadow">
                                <i class="fa-solid fa-check-circle me-2"></i> HOÀN TẤT ĐẶT HÀNG COD
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- JAVASCRIPT -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // Hàm sao chép nhanh
        function copyText(strText, labelName) {
            if (!strText) return;
            navigator.clipboard.writeText(strText).then(function () {
                alert("✅ Đã sao chép " + labelName + ": " + strText);
            }).catch(function (err) {
                var tempInput = document.createElement("input");
                tempInput.value = strText;
                document.body.appendChild(tempInput);
                tempInput.select();
                document.execCommand("copy");
                document.body.removeChild(tempInput);
                alert("✅ Đã sao chép " + labelName + ": " + strText);
            });
        }

        $(document).ready(function () {
            var orderId = @Model.Id;

            // 1. ĐẾM NGƯỢC 10 PHÚT QR (TỰ ĐỘNG HỦY NẾU QUÁ 10 PHÚT)
            var timerSeconds = 10 * 60;
            var timerInterval = setInterval(function () {
                var minutes = Math.floor(timerSeconds / 60);
                var seconds = timerSeconds % 60;
                var displaySec = seconds < 10 ? '0' + seconds : seconds;
                var displayMin = minutes < 10 ? '0' + minutes : minutes;
                $('#countdown').text(displayMin + ':' + displaySec);
                
                if (timerSeconds <= 0) {
                    clearInterval(timerInterval);
                    $('#countdown').text('Hết giờ');
                } else {
                    timerSeconds--;
                }
            }, 1000);

            // 2. NÚT THAY ĐỔI PHƯƠNG THỨC THANH TOÁN
            $('#btnChangePaymentMethod, .btn-switch-method').on('click', function (e) {
                e.preventDefault();
                $('html, body').animate({
                    scrollTop: $("#paymentTab").offset().top - 80
                }, 300);

                // Highlight tabs
                $('#paymentTab .nav-link').addClass('border-warning');
                setTimeout(function() {
                    $('#paymentTab .nav-link').removeClass('border-warning');
                }, 1500);
            });

            // 3. AUTO-POLLING SEPAY VIETINBANK (Kiểm tra tự động mỗi 3 giây)
            var pollTimer = setInterval(function () {
                $.ajax({
                    url: '@Url.Action("CheckPaymentStatus", "Order")',
                    type: 'GET',
                    data: { orderId: orderId },
                    success: function (res) {
                        if (res && res.isPaid) {
                            clearInterval(pollTimer);
                            clearInterval(timerInterval);
                            alert("🎉 THANH TOÁN SEPAY VIETINBANK THÀNH CÔNG!\nHệ thống đã tự động gạch nợ đơn hàng #" + orderId + " và gửi Hóa đơn về Email của bạn.");
                            window.location.href = '@Url.Action("Success", "Order", new { paymentMethod = 1, orderId = Model.Id })';
                        } else if (res && res.isExpired) {
                            clearInterval(pollTimer);
                            clearInterval(timerInterval);
                            alert("⚠️ ĐƠN HÀNG HẾT HẠN THANH TOÁN!\nĐơn hàng #" + orderId + " đã quá 10 phút chưa thanh toán và đã được hệ thống tự động hủy.");
                            window.location.href = '@Url.Action("Track", "Order", new { query = Model.Id })';
                        }
                    }
                });
            }, 3000);

            // 4. XỬ LÝ COD
            $('#btnConfirmCOD').on('click', function (e) {
                e.preventDefault();
                var btn = $(this);
                btn.prop('disabled', true).html('<i class="fa-solid fa-spinner fa-spin me-2"></i> Đang xử lý...');

                $.ajax({
                    url: '@Url.Action("ProcessCOD", "Order")',
                    type: 'POST',
                    data: { orderId: orderId },
                    success: function (res) {
                        if (res.success) {
                            alert("🎉 ĐẶT HÀNG COD THÀNH CÔNG!\nCảm ơn bạn đã lựa chọn Bách Hóa Xanh!");
                            window.location.href = res.redirectUrl || '@Url.Action("Success", "Order", new { paymentMethod = 0, orderId = Model.Id })';
                        } else {
                            alert(res.message || "Xử lý COD thất bại!");
                            btn.prop('disabled', false).html('<i class="fa-solid fa-check-circle me-2"></i> HOÀN TẤT ĐẶT HÀNG COD');
                        }
                    },
                    error: function (xhr, status, err) {
                        alert("Lỗi hệ thống: " + (xhr.responseText || err));
                        btn.prop('disabled', false).html('<i class="fa-solid fa-check-circle me-2"></i> HOÀN TẤT ĐẶT HÀNG COD');
                    }
                });
            });
        });
    </script>
        });
    </script>
</body>
</html>
