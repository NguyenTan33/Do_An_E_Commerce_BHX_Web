@model Do_An_E_Commerce_BHX.Models.Entities.Product

@{
    ViewBag.Title = Model.Name + " - Chi tiết sản phẩm";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var reviews = ViewBag.Reviews as List<Do_An_E_Commerce_BHX.Models.Entities.Review> ?? new List<Do_An_E_Commerce_BHX.Models.Entities.Review>();
    var questions = ViewBag.Questions as List<Do_An_E_Commerce_BHX.Models.Entities.Question> ?? new List<Do_An_E_Commerce_BHX.Models.Entities.Question>();

    double avgRating = reviews.Any() ? Math.Round(reviews.Average(r => r.Rating), 1) : 5.0;
    int reviewCount = reviews.Count;
}

<div class="container py-4">
    <!-- KHUNG THÔNG TIN SẢN PHẨM -->
    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
        <div class="row g-4 align-items-center">
            <div class="col-md-5 text-center border-end">
                <img src="@(string.IsNullOrEmpty(Model.URLImage) ? "/Content/images/no-image.png" : Model.URLImage)" 
                     class="img-fluid rounded-3 p-2 border" style="max-height: 320px; object-fit: contain;" alt="@Model.Name" />
            </div>
            <div class="col-md-7">
                <span class="badge bg-success bg-opacity-10 text-success fw-bold p-2 mb-2 fs-6">Sản Phẩm Tươi Ngon</span>
                <h2 class="fw-bold text-dark mb-2">@Model.Name</h2>
                
                <!-- ĐÁNH GIÁ SAO & SỐ LƯỢNG ĐÁNH GIÁ -->
                <div class="d-flex align-items-center gap-2 mb-3">
                    <div class="text-warning fs-5 fw-bold"><i class="fa-solid fa-star"></i> @avgRating / 5</div>
                    <span class="text-muted small">(@reviewCount đánh giá)</span>
                </div>

                <div class="text-danger fw-bold fs-1 mb-3">@Model.Price.ToString("N0") ₫</div>

                <div class="p-3 bg-light rounded-3 border mb-3">
                    <span class="text-muted small fw-bold text-uppercase d-block mb-1">Mô tả sản phẩm:</span>
                    <p class="text-dark small m-0">@(string.IsNullOrEmpty(Model.Description) ? "Sản phẩm tươi ngon, đảm bảo chất lượng chính hãng từ Bách Hóa Xanh." : Model.Description)</p>
                </div>

                <button type="button" class="btn btn-success btn-lg px-5 fw-bold rounded-3 shadow btn-add-cart" data-id="@Model.Id" @(Model.Quantity <= 0 ? "disabled" : "")>
                    <i class="fa-solid fa-cart-plus me-2"></i> @(Model.Quantity <= 0 ? "Hết Hàng" : "Thêm Vào Giỏ Hàng")
                </button>
            </div>
        </div>
    </div>

    <!-- LUỒNG BÌNH LUẬN & HỎI ĐÁP TRAO ĐỔI VỚI ADMIN (CHUẨN 100% ẢNH MẪU BÁCH HÓA XANH) -->
    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
        <h4 class="fw-bold text-dark mb-3"><i class="fa-solid fa-comments text-primary me-2"></i>Bình luận</h4>
        
        <!-- Ô nhập câu hỏi / bình luận của khách -->
        <div class="mb-4">
            <input type="hidden" id="hdfProductId" value="@Model.Id" />
            <textarea id="question-content" rows="3" class="form-control rounded-3 p-3 border-2" placeholder="Mời bạn bình luận hoặc đặt câu hỏi"></textarea>
            <div class="d-flex justify-content-end mt-2">
                <button type="button" id="btn-post-question" class="btn btn-primary px-4 fw-bold shadow-sm rounded-3">
                    <i class="fa-solid fa-paper-plane me-1"></i> Gửi bình luận
                </button>
            </div>
        </div>

        <hr />

        <!-- Danh sách bình luận & phản hồi Admin QTV -->
        <h5 class="fw-bold text-dark mb-3">Tất cả bình luận & hỏi đáp:</h5>
        <div id="questions-container">
            @if (questions != null && questions.Any())
            {
                foreach (var q in questions)
                {
                    <div class="border-bottom pb-3 mb-3">
                        <div class="fw-bold text-dark fs-6 mb-1">Khách hàng</div>
                        <div class="text-dark mb-2">@q.Content</div>
                        <div class="d-flex align-items-center gap-3 small text-muted mb-2">
                            <span><i class="fa-regular fa-clock me-1"></i>@q.CreatedDate.ToString("dd/MM/yyyy HH:mm")</span>
                            <span class="text-primary fw-bold" style="cursor:pointer;"><i class="fa-regular fa-thumbs-up me-1"></i>Thích</span>
                        </div>

                        <!-- Nếu có phản hồi từ Admin -> Hiển thị Khung Trả Lời QTV màu vàng chuẩn như ảnh mẫu -->
                        @if (!string.IsNullOrWhiteSpace(q.Answer))
                        {
                            <div class="bg-light border rounded-3 p-3 ms-3 mt-2">
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <div class="rounded-circle bg-success text-white d-flex align-items-center justify-content-center fw-bold" style="width: 32px; height: 32px; font-size: 14px;"><i class="fa-solid fa-leaf"></i></div>
                                    <div class="fw-bold text-dark">Nguyễn Thị Ngọc Điều</div>
                                    <span class="badge bg-warning text-dark fw-bold px-2 py-1" style="font-size: 11px;">QTV</span>
                                </div>
                                <div class="text-dark small mb-2 ms-4">@q.Answer</div>
                                <div class="small text-muted ms-4"><i class="fa-regular fa-clock me-1"></i>Hỗ trợ Bách Hóa Xanh</div>
                            </div>
                        }
                        else if (User.IsInRole("Admin"))
                        {
                            <div class="ms-3 mt-2 bg-warning bg-opacity-10 border border-warning p-2 rounded-3">
                                <div class="small fw-bold text-dark mb-1"><i class="fa-solid fa-user-shield text-warning me-1"></i>Trả lời với tư cách QTV:</div>
                                <div class="input-group">
                                    <input type="text" class="form-control form-control-sm admin-answer-input" placeholder="Nhập câu trả lời tư vấn cho khách..." />
                                    <button type="button" class="btn btn-sm btn-warning fw-bold btn-submit-admin-answer" data-qid="@q.Id">Gửi QTV</button>
                                </div>
                            </div>
                        }
                    </div>
                }
            }
            else
            {
                <div class="text-center py-4 text-muted">
                    <i class="fa-solid fa-comment-slash fs-2 d-block mb-2"></i>Chưa có bình luận nào. Hãy là người đầu tiên đặt câu hỏi!
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
            const productId = $('#hdfProductId').val();

            // Gửi câu hỏi / bình luận mới
            $('#btn-post-question').click(function () {
                let content = $('#question-content').val().trim();

                if (!content) {
                    alert("Vui lòng nhập nội dung bình luận!");
                    return;
                }

                $.post('/Product/PostQuestion', { productId: productId, content: content }, function (res) {
                    alert(res.message);
                    if (res.success) {
                        location.reload();
                    }
                });
            });

            // Admin bấm gửi trả lời QTV
            $(document).on('click', '.btn-submit-admin-answer', function () {
                var questionId = $(this).data('qid');
                var answerInput = $(this).closest('.input-group').find('.admin-answer-input');
                var answer = answerInput.val().trim();

                if (!answer) {
                    alert("Vui lòng nhập nội dung trả lời QTV!");
                    return;
                }

                $.post('/Product/PostAnswerAdmin', { questionId: questionId, answer: answer }, function (res) {
                    alert(res.message);
                    if (res.success) {
                        location.reload();
                    }
                });
            });
        });
    </script>
}