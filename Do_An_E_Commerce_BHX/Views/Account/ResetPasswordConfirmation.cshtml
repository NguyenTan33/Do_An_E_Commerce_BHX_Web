@{
    ViewBag.Title = "Thành công";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="auth-form-header" style="text-align: center;">
    <div style="width: 60px; height: 60px; border-radius: 50%; background: #EBF6F0; color: #3F8F5C; display: inline-flex; align-items: center; justify-content: center; font-size: 1.8rem; margin-bottom: 16px;">
        <i class="fa-solid fa-circle-check"></i>
    </div>
    <h2>Đặt Lai Mật Khẩu Thành Công</h2>
    <p style="margin-top: 10px; line-height: 1.6;">
        Mật khẩu của bạn đã được cập nhật thành công. Bạn có thể sử dụng mật khẩu mới để đăng nhập ngay bây giờ.
    </p>
</div>

<div class="auth-switch-footer" style="margin-top: 30px;">
    <a href="@Url.Action("Login", "Account")" class="btn-auth-submit" style="text-decoration: none;">
        <span>Đăng Nhập Ngay</span>
        <i class="fa-solid fa-arrow-right"></i>
    </a>
</div>
