@model Do_An_E_Commerce_BHX.Models.RegisterViewModel
@{
    ViewBag.Title = "Đăng ký tài khoản";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<!-- Segmented Navigation Tabs -->
<div class="auth-tabs">
    <a href="@Url.Action("Login", "Account")" class="auth-tab-item">
        <i class="fa-solid fa-right-to-bracket me-1"></i> Đăng Nhập
    </a>
    <a href="@Url.Action("Register", "Account")" class="auth-tab-item active">
        <i class="fa-solid fa-user-plus me-1"></i> Đăng Ký
    </a>
</div>

<div class="auth-form-header" style="margin-bottom: 24px;">
    <h2 style="font-family: 'Montserrat', sans-serif; font-size: 1.7rem; font-weight: 800; color: #123829; margin-bottom: 6px;">
        Tạo Tài Khoản Mới
    </h2>
    <p style="font-size: 0.9rem; color: #6B7280;">
        Trở thành thành viên Bách Hóa Xanh để tích điểm &amp; nhận ưu đãi
    </p>
</div>

@using (Html.BeginForm("Register", "Account", FormMethod.Post, new { role = "form" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary("", new { @class = "validation-summary-errors" })

    <div class="auth-form-group">
        @Html.LabelFor(m => m.Email, "Địa chỉ Email")
        <div class="input-with-icon">
            @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "nhapemail@domain.com", autocomplete = "email" })
            <i class="fa-solid fa-envelope input-icon"></i>
        </div>
        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "field-validation-error" })
    </div>

    <div class="auth-form-group">
        @Html.LabelFor(m => m.Password, "Mật khẩu")
        <div class="input-with-icon">
            @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Tối thiểu 6 ký tự", id = "RegisterPassword", autocomplete = "new-password" })
            <i class="fa-solid fa-lock input-icon"></i>
            <i class="fa-solid fa-eye toggle-password" data-target="RegisterPassword" title="Hiện/Ẩn mật khẩu"></i>
        </div>
        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "field-validation-error" })
    </div>

    <div class="auth-form-group">
        @Html.LabelFor(m => m.ConfirmPassword, "Xác nhận mật khẩu")
        <div class="input-with-icon">
            @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", placeholder = "Nhập lại mật khẩu vừa đặt", id = "ConfirmPassword", autocomplete = "new-password" })
            <i class="fa-solid fa-shield-halved input-icon"></i>
            <i class="fa-solid fa-eye toggle-password" data-target="ConfirmPassword" title="Hiện/Ẩn mật khẩu"></i>
        </div>
        @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "field-validation-error" })
    </div>

    <button type="submit" class="btn-auth-submit" style="margin-top: 10px;">
        <span>Tạo Tài Khoản Ngay</span>
        <i class="fa-solid fa-user-plus"></i>
    </button>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
