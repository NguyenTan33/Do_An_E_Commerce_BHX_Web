@model Do_An_E_Commerce_BHX.Models.ResetPasswordViewModel
@{
    ViewBag.Title = "Đặt lại mật khẩu";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="auth-form-header">
    <h2>Đặt Lai Mật Khẩu</h2>
    <p>Nhập email và mật khẩu mới của bạn bên dưới</p>
</div>

@using (Html.BeginForm("ResetPassword", "Account", FormMethod.Post, new { role = "form" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary("", new { @class = "validation-summary-errors" })
    @Html.HiddenFor(model => model.Code)

    <div class="auth-form-group">
        @Html.LabelFor(m => m.Email, "Địa chỉ Email")
        <div class="input-with-icon">
            @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "example@domain.com", autocomplete = "email" })
            <i class="fa-solid fa-envelope input-icon"></i>
        </div>
        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "field-validation-error" })
    </div>

    <div class="auth-form-group">
        @Html.LabelFor(m => m.Password, "Mật khẩu mới")
        <div class="input-with-icon">
            @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Nhập mật khẩu mới", id = "ResetPassword", autocomplete = "new-password" })
            <i class="fa-solid fa-lock input-icon"></i>
            <i class="fa-solid fa-eye toggle-password" data-target="ResetPassword" title="Hiện/Ẩn mật khẩu"></i>
        </div>
        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "field-validation-error" })
    </div>

    <div class="auth-form-group">
        @Html.LabelFor(m => m.ConfirmPassword, "Xác nhận mật khẩu mới")
        <div class="input-with-icon">
            @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", placeholder = "Nhập lại mật khẩu mới", id = "ConfirmResetPassword", autocomplete = "new-password" })
            <i class="fa-solid fa-shield-halved input-icon"></i>
            <i class="fa-solid fa-eye toggle-password" data-target="ConfirmResetPassword" title="Hiện/Ẩn mật khẩu"></i>
        </div>
        @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "field-validation-error" })
    </div>

    <button type="submit" class="btn-auth-submit" style="margin-top: 10px;">
        <span>Đặt Lai Mật Khẩu</span>
        <i class="fa-solid fa-key"></i>
    </button>
}

<div class="auth-switch-footer">
    Nhớ ra mật khẩu? <a href="@Url.Action("Login", "Account")">Đăng nhập ngay</a>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
