@model Do_An_E_Commerce_BHX.Models.ForgotPasswordViewModel
@{
    ViewBag.Title = "Quên mật khẩu?";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div style="margin-bottom: 24px;">
    <a href="@Url.Action("Login", "Account")" class="auth-link" style="display: inline-flex; align-items: center; gap: 6px; font-size: 0.875rem;">
        <i class="fa-solid fa-arrow-left"></i> Quay lại Đăng nhập
    </a>
</div>

<div class="auth-form-header" style="margin-bottom: 28px;">
    <div style="width: 54px; height: 54px; border-radius: 16px; background: rgba(245, 166, 35, 0.15); color: #F5A623; display: inline-flex; align-items: center; justify-content: center; font-size: 1.5rem; margin-bottom: 16px; border: 1px solid rgba(245, 166, 35, 0.3);">
        <i class="fa-solid fa-key"></i>
    </div>
    <h2 style="font-family: 'Montserrat', sans-serif; font-size: 1.7rem; font-weight: 800; color: #123829; margin-bottom: 6px;">
        Quên Mật Khẩu?
    </h2>
    <p style="font-size: 0.9rem; color: #6B7280; line-height: 1.5;">
        Đừng lo lắng! Nhập địa chỉ email đã đăng ký tài khoản, chúng tôi sẽ gửi liên kết hướng dẫn khôi phục mật khẩu.
    </p>
</div>

@using (Html.BeginForm("ForgotPassword", "Account", FormMethod.Post, new { role = "form" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary("", new { @class = "validation-summary-errors" })

    <div class="auth-form-group">
        @Html.LabelFor(m => m.Email, "Địa chỉ Email của bạn")
        <div class="input-with-icon">
            @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "nhapemail@domain.com", autocomplete = "email" })
            <i class="fa-solid fa-envelope input-icon"></i>
        </div>
        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "field-validation-error" })
    </div>

    <button type="submit" class="btn-auth-submit" style="margin-top: 15px;">
        <span>Gửi Liên Kết Khôi Phục</span>
        <i class="fa-solid fa-paper-plane"></i>
    </button>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
