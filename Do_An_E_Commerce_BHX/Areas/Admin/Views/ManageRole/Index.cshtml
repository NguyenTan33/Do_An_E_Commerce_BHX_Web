@model IEnumerable<Microsoft.AspNet.Identity.EntityFramework.IdentityRole>

@{
    ViewData["Title"] = "Quản lý Phân quyền";
    ViewData["Subtitle"] = "Danh sách các nhóm quyền trong hệ thống";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="dash-page">

    <!-- ===== PAGE HEADER ===== -->
    <div class="d-flex align-items-center justify-content-between mb-4 pb-3" style="border-bottom: 1px solid var(--adm-border);">
        <div>
            <h3 class="mb-1" style="font-size: 20px; font-weight: 700; color: var(--adm-text); display: flex; align-items: center; gap: 10px;">
                <i class="fa-solid fa-shield-halved text-primary"></i> Quản Lý Phân Quyền
            </h3>
            <p class="mb-0" style="font-size: 13.5px; color: var(--adm-text-2);">Thiết lập và quản lý danh sách các nhóm quyền trong hệ thống</p>
        </div>
        <div class="d-flex align-items-center gap-3">
            <span class="badge bg-secondary" style="font-size: 13px; padding: 8px 12px;">
                <i class="fa-solid fa-users-gear me-1"></i> @(Model?.Count() ?? 0) Nhóm Quyền
            </span>
            <a href="@Url.Action("ThemRole", "ManageRole")" class="btn btn-success">
                <i class="fa-solid fa-plus"></i> Thêm nhóm quyền
            </a>
        </div>
    </div>

    <!-- ===== HIỂN THỊ THÔNG BÁO LỖI ===== -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger d-flex align-items-center mb-4 shadow-sm" role="alert" style="background: var(--adm-red-dim); border-color: var(--adm-red); color: var(--adm-red);">
            <i class="fa-solid fa-triangle-exclamation me-2 fs-5"></i>
            <div style="font-weight: 500;">@TempData["Error"]</div>
        </div>
    }

    <!-- ===== BỘ LỌC TÌM KIẾM ===== -->
    <div class="adm-filter-bar">
        <h5 class="mb-3" style="font-size: 14px; font-weight: 700; color: var(--adm-text); display: flex; align-items: center; gap: 8px;">
            <i class="fa-solid fa-sliders text-primary"></i> Bộ lọc tìm kiếm
        </h5>
        @using (Html.BeginForm("Index", "ManageRole", FormMethod.Get))
        {
            <div class="row g-3">
                <div class="col-12 col-md-6 col-lg-5">
                    <label class="form-label">Tên nhóm quyền</label>
                    <div class="input-group">
                        <span class="input-group-text border-end-0"><i class="fa-solid fa-magnifying-glass"></i></span>
                        <input type="text" name="tuKhoa" class="form-control border-start-0 ps-0" value="@Request["tuKhoa"]" placeholder="Nhập tên quyền cần tìm..." />
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end align-items-center gap-2 mt-4 pt-3" style="border-top: 1px solid var(--adm-border);">
                <a href="@Url.Action("Index", "ManageRole")" class="btn btn-outline-secondary">
                    <i class="fa-solid fa-rotate-left"></i> Đặt lại
                </a>
                <button type="submit" class="btn btn-primary">
                    <i class="fa-solid fa-filter"></i> LỌC KẾT QUẢ
                </button>
            </div>
        }
    </div>

    <!-- ===== BẢNG DANH SÁCH ROLE ===== -->
    <div class="adm-table-wrap">
        <div class="adm-table-header">
            <h5 class="adm-table-title m-0">
                <i class="fa-solid fa-list-ul"></i>
                Danh Sách Nhóm Quyền (@(Model?.Count() ?? 0))
            </h5>
        </div>
        <div class="adm-table-responsive">
            <table class="table mb-0">
                <thead>
                    <tr>
                        <th class="ps-4" style="width: 250px;">Tên quyền (Role Name)</th>
                        <th>Mã định danh (ID)</th>
                        <th class="text-end pe-4" style="width: 150px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var role in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <span class="badge bg-primary px-2 py-1" style="font-size: 13.5px;">@role.Name</span>
                                </td>
                                <td>
                                    <span style="font-family: 'JetBrains Mono', monospace; color: var(--adm-text-2); font-size: 13.5px;">@role.Id</span>
                                </td>
                                <td class="text-end pe-4">
                                    <!-- Nút Sửa -->
                                    <a href="@Url.Action("SuaRole", "ManageRole", new { id = role.Id })" class="btn btn-sm btn-outline-primary" title="Sửa quyền">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                    </a>

                                    <!-- Nút Xóa (Mở Modal) -->
                                    <button type="button" class="btn btn-sm btn-outline-danger ms-1" title="Xóa quyền"
                                            onclick="openDeleteModal('@role.Id', '@role.Name')">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>

                                    <!-- Form Ẩn Xóa -->
                                    @using (Html.BeginForm("XoaRole", "ManageRole", FormMethod.Post, new { id = "formDelete_" + role.Id, style = "display:none;" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@role.Id" />
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="adm-empty">
                                <i class="fa-solid fa-shield-halved"></i>
                                <h5>Trống</h5>
                                <p>Chưa có nhóm quyền nào trong hệ thống.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ============ MODALS (BOOTSTRAP 5 THÍCH ỨNG THEME DARK) ============ -->
<!-- Modal Xác Nhận Xóa Quyền -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-danger shadow-lg">
            <div class="modal-header" style="border-bottom-color: var(--adm-red-dim) !important;">
                <h5 class="modal-title text-danger" id="deleteModalLabel" style="font-weight: 700; font-size: 15px;">
                    <i class="fa-solid fa-triangle-exclamation me-2"></i>Xác nhận xóa
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <p style="color: var(--adm-text-2); margin-bottom: 0;">
                    Bạn có chắc chắn muốn xóa nhóm quyền <strong id="deleteRoleName" class="text-white" style="font-size: 15px;"></strong>?<br />
                    <span class="text-danger mt-2 d-inline-block" style="font-size: 12.5px;">* Cảnh báo: Các tài khoản đang sử dụng nhóm quyền này có thể bị mất quyền truy cập hệ thống.</span>
                </p>
            </div>
            <div class="modal-footer" style="border-top-color: var(--adm-border) !important;">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-danger" onclick="confirmDelete()"><i class="fa-solid fa-trash"></i> Xóa quyền</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let roleIdToDelete = null;

        function openDeleteModal(id, name) {
            roleIdToDelete = id;
            document.getElementById('deleteRoleName').textContent = name;

            // Khởi tạo và gọi Modal từ Bootstrap 5 Javascript
            var deleteModalEl = document.getElementById('deleteModal');
            var modal = bootstrap.Modal.getOrCreateInstance(deleteModalEl);
            modal.show();
        }

        function confirmDelete() {
            if (roleIdToDelete) {
                document.getElementById('formDelete_' + roleIdToDelete).submit();
            }
        }
    </script>
}