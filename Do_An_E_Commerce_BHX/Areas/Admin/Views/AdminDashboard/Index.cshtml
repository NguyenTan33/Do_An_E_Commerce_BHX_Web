@model Do_An_E_Commerce_BHX.Areas.Admin.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Báo cáo Doanh thu & Dashboard";
    ViewData["Subtitle"] = "Thống kê biểu đồ doanh số, đơn hàng và phân tích chuyên sâu";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
    var statusList = ViewBag.StatusList as List<SelectListItem> ?? new List<SelectListItem>();
    var paymentMethodList = ViewBag.PaymentMethodList as List<SelectListItem> ?? new List<SelectListItem>();
    string selectedPeriod = ViewBag.SelectedPeriod as string ?? "";
    string selectedStartDate = ViewBag.SelectedStartDate as string ?? "";
    string selectedEndDate = ViewBag.SelectedEndDate as string ?? "";
}

<!-- IMPORT THƯ VIỆN ĐỂ KHÔNG BỊ BỂ GIAO DIỆN -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

<style>
    /* ===== CUSTOM CSS CHO ADMIN ĐỒNG BỘ ===== */
    .admin-card {
        border-radius: 12px;
        border: none;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        background-color: #fff;
    }

    .btn-custom {
        border-radius: 8px;
        transition: all 0.2s ease-in-out;
    }

        .btn-custom:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 10px rgba(0,0,0,0.15);
        }

    /* Bảng dữ liệu */
    .table-custom th {
        background-color: #f4f6f9;
        color: #495057;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border-bottom: 2px solid #e2e8f0;
        padding: 16px 12px;
    }

    .table-custom td {
        vertical-align: middle;
        padding: 16px 12px;
        border-bottom: 1px solid #f1f3f5;
        transition: background-color 0.2s;
    }

    .table-custom tbody tr:hover {
        background-color: #f8f9fa;
    }

    /* Widgets Thống kê hiện đại */
    .widget-card {
        transition: all 0.3s;
    }

        .widget-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(0,0,0,0.1);
        }

    .icon-box {
        width: 54px;
        height: 54px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
    }

    /* Làm đẹp select tag */
    .form-select, .form-control {
        border-radius: 8px;
        border: 1px solid #ced4da;
    }

        .form-select:focus, .form-control:focus {
            border-color: #198754;
            box-shadow: 0 0 0 0.25rem rgba(25, 135, 84, 0.25);
        }
</style>

<div class="container-fluid py-3">
    <!-- TIÊU ĐỀ TRANG -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h3 class="fw-bold text-dark m-0"><i class="fa-solid fa-chart-pie text-success me-2"></i>Tổng Quan Doanh Thu (Dashboard)</h3>
            <p class="text-muted mb-0 mt-1 fs-6">Thống kê biểu đồ doanh số, đơn hàng và phân tích chuyên sâu</p>
        </div>
        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 fs-6 px-3 py-2 rounded-pill shadow-sm">
            <i class="fa-solid fa-clock me-1"></i> Kỳ lọc: @Model.CurrentPeriodInfo
        </span>
    </div>

    <!-- KHUNG BỘ LỌC BÁO CÁO NÂNG CAO -->
    <div class="card admin-card border border-light mb-4">
        <div class="card-header bg-white py-3 border-bottom d-flex align-items-center">
            <h5 class="m-0 fw-bold text-dark"><i class="fa-solid fa-filter text-primary me-2"></i>Bộ Lọc Báo Cáo</h5>
        </div>
        <div class="card-body p-4">
            <form method="get" action="@Url.Action("Index", "AdminDashboard")" id="filterForm">
                <div class="row g-3 align-items-end">
                    <!-- 1. Thời gian lọc (Period) -->
                    <div class="col-md-3">
                        <label class="form-label fw-bold text-secondary small text-uppercase"><i class="fa-solid fa-calendar-days me-1 text-primary"></i>Khoảng thời gian</label>
                        <select name="period" id="periodSelect" class="form-select" onchange="toggleCustomDates()">
                            <option value="" @(string.IsNullOrEmpty(selectedPeriod) ? "selected" : "")>Tháng này</option>
                            <option value="today" @(selectedPeriod == "today" ? "selected" : "")>Hôm nay</option>
                            <option value="7days" @(selectedPeriod == "7days" ? "selected" : "")>7 ngày gần nhất</option>
                            <option value="lastmonth" @(selectedPeriod == "lastmonth" ? "selected" : "")>Tháng trước</option>
                            <option value="custom" @(selectedPeriod == "custom" ? "selected" : "")>Tùy chọn ngày...</option>
                        </select>
                    </div>

                    <!-- 2. Danh mục sản phẩm -->
                    <div class="col-md-3">
                        <label class="form-label fw-bold text-secondary small text-uppercase"><i class="fa-solid fa-layer-group me-1 text-success"></i>Danh mục sản phẩm</label>
                        @Html.DropDownList("categoryId", (SelectList)ViewBag.CategoryId, "-- Tất cả danh mục --", new { @class = "form-select" })
                    </div>

                    <!-- 3. Trạng thái đơn hàng -->
                    <div class="col-md-3">
                        <label class="form-label fw-bold text-secondary small text-uppercase"><i class="fa-solid fa-list-check me-1 text-warning"></i>Trạng thái đơn hàng</label>
                        @Html.DropDownList("status", statusList, new { @class = "form-select" })
                    </div>

                    <!-- 4. Hình thức thanh toán -->
                    <div class="col-md-3">
                        <label class="form-label fw-bold text-secondary small text-uppercase"><i class="fa-solid fa-wallet me-1 text-info"></i>Thanh toán</label>
                        @Html.DropDownList("paymentMethod", paymentMethodList, new { @class = "form-select" })
                    </div>

                    <!-- Tùy chọn ngày (Hiển thị khi chọn Tùy chọn ngày) -->
                    <div class="col-md-3 custom-date" style="display: @(selectedPeriod == "custom" ? "block" : "none");">
                        <label class="form-label fw-bold text-secondary small text-uppercase">Từ ngày</label>
                        <input type="date" name="startDate" class="form-control" value="@selectedStartDate" />
                    </div>

                    <div class="col-md-3 custom-date" style="display: @(selectedPeriod == "custom" ? "block" : "none");">
                        <label class="form-label fw-bold text-secondary small text-uppercase">Đến ngày</label>
                        <input type="date" name="endDate" class="form-control" value="@selectedEndDate" />
                    </div>

                    <!-- Nút xem báo cáo -->
                    <div class="col-12 mt-4 d-flex justify-content-end gap-2">
                        <a href="@Url.Action("Index", "AdminDashboard")" class="btn btn-outline-secondary btn-custom px-4 fw-bold">
                            <i class="fa-solid fa-rotate-left me-1"></i> Tải lại
                        </a>
                        <button type="submit" class="btn btn-success btn-custom px-5 fw-bold shadow-sm">
                            <i class="fa-solid fa-chart-line me-1"></i> XEM BÁO CÁO
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- 4 WIDGET CARD THỐNG KÊ TỔNG QUAN (Modern Dashboard Style) -->
    <div class="row g-3 mb-4">
        <!-- Widget 1 -->
        <div class="col-md-3">
            <div class="card admin-card widget-card border-start border-success border-4 h-100">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="small text-muted text-uppercase fw-bold letter-spacing-1">Doanh thu kỳ lọc</div>
                            <h3 class="fw-bold text-dark m-0 mt-2">@Model.PeriodRevenue.ToString("N0") <span class="fs-6">đ</span></h3>
                        </div>
                        <div class="icon-box bg-success bg-opacity-10">
                            <i class="fa-solid fa-money-bill-trend-up fs-3 text-success"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Widget 2 -->
        <div class="col-md-3">
            <div class="card admin-card widget-card border-start border-primary border-4 h-100">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <div>
                            <div class="small text-muted text-uppercase fw-bold letter-spacing-1">Đơn hàng kỳ lọc</div>
                            <h3 class="fw-bold text-dark m-0 mt-2">@Model.FilteredTotalOrders <span class="fs-6 fw-normal">đơn</span></h3>
                        </div>
                        <div class="icon-box bg-primary bg-opacity-10">
                            <i class="fa-solid fa-cart-shopping fs-3 text-primary"></i>
                        </div>
                    </div>
                    <div class="mt-2 pt-2 border-top small text-muted">
                        Thành công: <strong class="text-success">@Model.FilteredSuccessOrders</strong> |
                        Hủy: <strong class="text-danger">@Model.FilteredCancelOrders</strong>
                    </div>
                </div>
            </div>
        </div>

        <!-- Widget 3 -->
        <div class="col-md-3">
            <div class="card admin-card widget-card border-start border-info border-4 h-100">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <div>
                            <div class="small text-muted text-uppercase fw-bold letter-spacing-1">Doanh thu toàn TG</div>
                            <h3 class="fw-bold text-info m-0 mt-2">@Model.TotalRevenue.ToString("N0") <span class="fs-6 fw-normal">đ</span></h3>
                        </div>
                        <div class="icon-box bg-info bg-opacity-10">
                            <i class="fa-solid fa-vault fs-3 text-info"></i>
                        </div>
                    </div>
                    <div class="mt-2 pt-2 border-top small text-muted">
                        Tất cả các đơn giao thành công
                    </div>
                </div>
            </div>
        </div>

        <!-- Widget 4 -->
        <div class="col-md-3">
            <div class="card admin-card widget-card border-start border-danger border-4 h-100">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <div>
                            <div class="small text-muted text-uppercase fw-bold letter-spacing-1">Sản phẩm sắp hết</div>
                            <h3 class="fw-bold text-danger m-0 mt-2">@Model.LowStockProducts <span class="fs-6 fw-normal">SP</span></h3>
                        </div>
                        <div class="icon-box bg-danger bg-opacity-10">
                            <i class="fa-solid fa-triangle-exclamation fs-3 text-danger"></i>
                        </div>
                    </div>
                    <div class="mt-2 pt-2 border-top small text-muted">
                        Số lượng &lt; 10, cần nhập thêm
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- KHUNG BIỂU ĐỒ & BẢNG SẢN PHẨM BÁN CHẠY -->
    <div class="row g-4 mb-4">
        <!-- CỘT TRÁI: BIỂU ĐỒ DOANH THU CHART.JS -->
        <div class="col-lg-7">
            <div class="card admin-card border border-light h-100">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <h5 class="m-0 fw-bold text-dark"><i class="fa-solid fa-chart-area text-success me-2"></i>Biểu Đồ Xu Hướng Doanh Thu</h5>
                    <span class="badge bg-light text-dark border px-2 py-1">@Model.CurrentPeriodInfo</span>
                </div>
                <div class="card-body p-3" style="position: relative; min-height: 350px;">
                    <canvas id="revenueChart"></canvas>
                </div>
            </div>
        </div>

        <!-- CỘT PHẢI: TOP SẢN PHẨM BÁN CHẠY -->
        <div class="col-lg-5">
            <div class="card admin-card border border-light h-100 overflow-hidden">
                <div class="card-header bg-white py-3 border-bottom">
                    <h5 class="m-0 fw-bold text-dark"><i class="fa-solid fa-trophy text-warning me-2"></i>Top Sản Phẩm Bán Chạy</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-custom mb-0">
                            <thead>
                                <tr>
                                    <th class="ps-4">Sản Phẩm</th>
                                    <th class="text-center">Đã Bán</th>
                                    <th class="text-end pe-4">Doanh Thu</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.TopProducts != null && Model.TopProducts.Any())
                                {
                                    foreach (var item in Model.TopProducts)
                                    {
                                        <tr>
                                            <td class="ps-4">
                                                <div class="fw-bold text-dark text-truncate" style="max-width: 200px;" title="@item.ProductName">@item.ProductName</div>
                                            </td>
                                            <td class="text-center">
                                                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1">@item.QuantitySold</span>
                                            </td>
                                            <td class="text-end pe-4 fw-bold text-danger">
                                                @item.Revenue.ToString("N0") đ
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="3" class="text-center py-5 text-muted">
                                            <i class="fa-solid fa-box-open fs-2 mb-2 opacity-50 d-block"></i>
                                            Chưa có dữ liệu bán hàng trong kỳ này.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- KHUNG TỶ TRỌNG DOANH THU THEO DANH MỤC -->
    <div class="card admin-card border border-light overflow-hidden mb-5">
        <div class="card-header bg-white py-3 border-bottom">
            <h5 class="m-0 fw-bold text-dark"><i class="fa-solid fa-pie-chart text-info me-2"></i>Doanh Thu Mang Lại Theo Danh Mục</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-custom mb-0">
                    <thead>
                        <tr>
                            <th class="ps-4">Danh Mục Sản Phẩm</th>
                            <th class="text-end pe-4">Tổng Doanh Thu Mang Lại</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.CategoryRevenue != null && Model.CategoryRevenue.Any())
                        {
                            foreach (var item in Model.CategoryRevenue)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-dark">
                                        <i class="fa-solid fa-tag text-secondary me-2 small"></i>@item.CategoryName
                                    </td>
                                    <td class="text-end pe-4 fw-bold text-success fs-6">
                                        @item.Revenue.ToString("N0") đ
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="2" class="text-center py-5 text-muted">
                                    <i class="fa-solid fa-chart-pie fs-2 mb-2 opacity-50 d-block"></i>
                                    Chưa có dữ liệu đóng góp danh mục.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    function toggleCustomDates() {
        var period = document.getElementById("periodSelect").value;
        var customDates = document.querySelectorAll(".custom-date");
        if (period === "custom") {
            customDates.forEach(function (el) { el.style.display = "block"; });
        } else {
            customDates.forEach(function (el) { el.style.display = "none"; });
        }
    }

    $(document).ready(function () {
        var labels = [];
        var values = [];

        @if (Model.RevenueChart != null && Model.RevenueChart.Any())
        {
            foreach (var item in Model.RevenueChart)
            {
                <text>
                labels.push("@Html.Raw(item.Label)");
                values.push(@item.Revenue);
                </text>
            }
        }

        var canvas = document.getElementById("revenueChart");
        if (canvas) {
            var ctx = canvas.getContext("2d");

            // Gradient hiệu ứng xịn xò cho Chart
            var gradient = ctx.createLinearGradient(0, 0, 0, 320);
            gradient.addColorStop(0, 'rgba(31, 107, 63, 0.35)'); // Xanh lá đậm mờ
            gradient.addColorStop(1, 'rgba(31, 107, 63, 0.0)');

            new Chart(ctx, {
                type: "line",
                data: {
                    labels: labels,
                    datasets: [{
                        label: "Doanh thu (VNĐ)",
                        data: values,
                        borderColor: "#198754", /* Bootstrap Success Green */
                        backgroundColor: gradient,
                        borderWidth: 3,
                        pointBackgroundColor: "#198754",
                        pointBorderColor: "#fff",
                        pointBorderWidth: 2,
                        pointRadius: 4,
                        pointHoverRadius: 6,
                        fill: true,
                        tension: 0.4 /* Đường cong mềm mại */
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: '#1f2937',
                            padding: 12,
                            titleFont: { size: 14 },
                            bodyFont: { size: 14, weight: 'bold' },
                            callbacks: {
                                label: function (context) {
                                    var val = context.parsed.y || 0;
                                    return ' Doanh thu: ' + val.toLocaleString('vi-VN') + ' đ';
                                }
                            }
                        }
                    },
                    scales: {
                        x: { grid: { display: false } },
                        y: {
                            beginAtZero: true,
                            grid: { color: '#f3f4f6' }, /* Viền lưới mờ */
                            ticks: {
                                callback: function (value) {
                                    return value.toLocaleString('vi-VN') + ' đ';
                                }
                            }
                        }
                    }
                }
            });
        }
    });
</script>