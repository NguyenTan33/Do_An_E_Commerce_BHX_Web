@{
    // Lấy controller/action hiện tại để tô sáng mục menu đang chọn
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    bool IsActive(string controller) =>
        string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase);

    string ActiveClass(string controller) => IsActive(controller) ? "active" : "";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <title>@(ViewData["Title"] != null ? $"{ViewData["Title"]} — Admin" : "Admin — Bảng điều khiển")</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 — load TRƯỚC Admin.css để Admin.css override được -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- FontAwesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" />

    <!-- Admin Dark Theme — load SAU Bootstrap để override -->
    <link rel="stylesheet" href="~/Content/CSS/Admin.css?v=2" />

    @RenderSection("Styles", required: false)
</head>
<body>

    <!-- ============ MOBILE BACKDROP OVERLAY ============ -->
    <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

    <!-- ============ SIDEBAR (dùng chung cho mọi trang admin) ============ -->
    <aside class="sidebar" id="adminSidebar">
        <div class="brand">
            <div class="brand-mark">Q</div>
            <div class="brand-text">
                <b>Quản trị cửa hàng</b>
                <span>admin.shop</span>
            </div>
        </div>

        <div class="nav-group-label">Vận hành</div>
        <ul class="nav">
            <li>
                <a href="@Url.Action("Index", "ManageProduct")" class="@ActiveClass("ManageProduct")">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8l-9-5-9 5 9 5 9-5z" /><path d="M3 8v8l9 5 9-5V8" /><path d="M3 8l9 5 9-5" /></svg>
                    Quản lý sản phẩm
                </a>
            </li>
            <li>
                <a href="@Url.Action("Index", "ManageCategory")" class="@ActiveClass("ManageCategory")">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1" /><rect x="14" y="3" width="7" height="7" rx="1" /><rect x="3" y="14" width="7" height="7" rx="1" /><rect x="14" y="14" width="7" height="7" rx="1" /></svg>
                    Danh mục
                </a>
            </li>
            <li>
                <a href="@Url.Action("Index", "ManagePromotion")" class="@ActiveClass("ManagePromotion")">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1" /><rect x="14" y="3" width="7" height="7" rx="1" /><rect x="3" y="14" width="7" height="7" rx="1" /><rect x="14" y="14" width="7" height="7" rx="1" /></svg>
                    Mã Giảm Giá
                </a>
            </li>
            <li>
                <a href="@Url.Action("Index", "ManageReview")" class="@ActiveClass("ManageReview")">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                    Quản lý Đánh Giá (★)
                </a>
            </li>
            <li>
                <a href="@Url.Action("Index", "ManageQuestion")" class="@ActiveClass("ManageQuestion")">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
                    Bình luận & Rep QTV
                </a>
            </li>
        </ul>

        <div class="nav-group-label">Con người & Dòng tiền</div>
        <ul class="nav">
            <li>
                <a href="@Url.Action("Index", "ManageUser")" class="@ActiveClass("ManageUser")">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1" /><rect x="14" y="3" width="7" height="7" rx="1" /><rect x="3" y="14" width="7" height="7" rx="1" /><rect x="14" y="14" width="7" height="7" rx="1" /></svg>
                    Quản lý người dùng
                </a>
            </li>
            <li>
                <a href="@Url.Action("Index", "ManageRole")" class="@ActiveClass("ManageRole")">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1" /><rect x="14" y="3" width="7" height="7" rx="1" /><rect x="3" y="14" width="7" height="7" rx="1" /><rect x="14" y="14" width="7" height="7" rx="1" /></svg>
                    Roles & Quyền hạn
                </a>
            </li>
            <li>
                <a href="@Url.Action("Index", "AdminDashboard")" class="@ActiveClass("AdminDashboard")">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1" /><rect x="14" y="3" width="7" height="7" rx="1" /><rect x="3" y="14" width="7" height="7" rx="1" /><rect x="14" y="14" width="7" height="7" rx="1" /></svg>
                    Báo cáo doanh thu
                </a>
            </li>
            <li>
                <a href="@Url.Action("History", "ManageOrder")" class="@ActiveClass("ManageOrder")">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 3" /></svg>
                    Lịch sử giao dịch mua hàng
                </a>
            </li>
            <li>
                <a href="@Url.Action("Index", "BehaviorAnalytics")" class="@ActiveClass("BehaviorAnalytics")">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
                    Phân Tích Hành Vi Người Dùng
                </a>
            </li>
        </ul>
        <div class="nav-group-label">Đơn Hàng</div>
        <ul class="nav">
            <li>
                <a href="@Url.Action("Index", "ManageOrder")" class="@ActiveClass("ManageOrder")">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1" /><rect x="14" y="3" width="7" height="7" rx="1" /><rect x="3" y="14" width="7" height="7" rx="1" /><rect x="14" y="14" width="7" height="7" rx="1" /></svg>
                    Quản Lý Đơn Hàng
                </a>
            </li>
            <li>
                <a href="@Url.Action("PackingList", "ManageOrder")" class="@ActiveClass("ManageOrder")">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1" /><rect x="14" y="3" width="7" height="7" rx="1" /><rect x="3" y="14" width="7" height="7" rx="1" /><rect x="14" y="14" width="7" height="7" rx="1" /></svg>
                    Soạn Đơn
                </a>
            </li>
            <li>
                <a href="@Url.Action("DeliveryList", "ManageOrder")" class="@ActiveClass("ManageOrder")">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1" /><rect x="14" y="3" width="7" height="7" rx="1" /><rect x="3" y="14" width="7" height="7" rx="1" /><rect x="14" y="14" width="7" height="7" rx="1" /></svg>
                    Giao Hàng
                </a>
            </li>
        </ul>

        <div class="sidebar-footer">
            <div class="admin-chip">
                @{
                    string adminName = "Quản trị viên";
                    if (ViewBag.FullName != null && !string.IsNullOrWhiteSpace(ViewBag.FullName.ToString()))
                    {
                        adminName = ViewBag.FullName.ToString();
                    }
                    else if (User.Identity != null && !string.IsNullOrEmpty(User.Identity.Name))
                    {
                        adminName = User.Identity.Name;
                    }
                    string initial = !string.IsNullOrEmpty(adminName) ? adminName.Substring(0, Math.Min(2, adminName.Length)).ToUpper() : "AD";
                }
                <div class="avatar">@initial</div>
                <div>
                    <div style="font-size:13.5px;font-weight:600;">@adminName</div>
                    <small>Quản trị viên (Admin)</small>
                </div>
            </div>
        </div>
    </aside>
    <!-- ============ MAIN CONTENT ============ -->
    <div class="main">
        <div class="topbar">
            <div class="d-flex align-items-center gap-3">
                <button class="mobile-toggle-btn" id="sidebarToggle" type="button" title="Mở menu nav">
                    <i class="fa-solid fa-bars"></i>
                </button>
                <div class="page-title">
                    @(ViewData["Title"] ?? "Bảng điều khiển")
                    @if (ViewData["Subtitle"] != null)
                    {
                        <span>@ViewData["Subtitle"]</span>
                    }
                </div>
            </div>

            <!-- NÚT QUAY VỀ TRANG CHỦ -->
            <div class="topbar-actions">
                <a href="@Url.Action("Index", "Home", new { area = "" })" class="btn-return-home">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                        <polyline points="9 22 9 12 15 12 15 22"></polyline>
                    </svg>
                    <span>Về trang cửa hàng</span>
                </a>
            </div>
        </div>

        <div class="content">
            @RenderBody()
        </div>
    </div>

    <!-- Bootstrap 5 JS Bundle (Popper included) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var toggleBtn = document.getElementById("sidebarToggle");
            var sidebar = document.getElementById("adminSidebar");
            var backdrop = document.getElementById("sidebarBackdrop");

            if (toggleBtn && sidebar && backdrop) {
                toggleBtn.addEventListener("click", function () {
                    sidebar.classList.toggle("open");
                    backdrop.classList.toggle("show");
                });

                backdrop.addEventListener("click", function () {
                    sidebar.classList.remove("open");
                    backdrop.classList.remove("show");
                });
            }
        });
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>