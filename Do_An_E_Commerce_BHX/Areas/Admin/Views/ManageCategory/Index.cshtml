@model IEnumerable<Do_An_E_Commerce_BHX.Models.Entities.Category>

@{
    ViewData["Title"] = "Quản lý danh mục";
    ViewData["Subtitle"] = "Danh sách danh mục sản phẩm trong cửa hàng";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="dash-page">

    <!-- ===== PAGE HEADER ===== -->
    <div class="d-flex align-items-center justify-content-between mb-4 pb-3" style="border-bottom: 1px solid var(--adm-border);">
        <div>
            <h3 class="mb-1" style="font-size: 20px; font-weight: 700; color: var(--adm-text); display: flex; align-items: center; gap: 10px;">
                <i class="fa-solid fa-layer-group text-primary"></i> Quản Lý Danh Mục
            </h3>
            <p class="mb-0" style="font-size: 13.5px; color: var(--adm-text-2);">Quản lý và cập nhật danh sách danh mục sản phẩm trong hệ thống</p>
        </div>
        <div>
            <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#addModal">
                <i class="fa-solid fa-plus"></i> Thêm danh mục
            </button>
        </div>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4 d-flex align-items-center gap-2 shadow-sm" role="alert">
            <i class="fa-solid fa-triangle-exclamation fs-5"></i>
            <div class="fw-bold">@TempData["ErrorMessage"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4 d-flex align-items-center gap-2 shadow-sm" role="alert">
            <i class="fa-solid fa-circle-check fs-5"></i>
            <div class="fw-bold">@TempData["SuccessMessage"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- ===== BỘ LỌC TÌM KIẾM ===== -->
    <div class="adm-filter-bar">
        <h5 class="mb-3" style="font-size: 14px; font-weight: 700; color: var(--adm-text); display: flex; align-items: center; gap: 8px;">
            <i class="fa-solid fa-sliders text-primary"></i> Bộ lọc tìm kiếm
        </h5>
        @using (Html.BeginForm("Index", "ManageCategory", FormMethod.Get))
        {
            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <label class="form-label">Từ khóa</label>
                    <input type="text" name="tuKhoa" class="form-control" value="@Request["tuKhoa"]" placeholder="Nhập tên danh mục..." />
                </div>
                <div class="col-12 col-md-6">
                    <label class="form-label">Sắp xếp</label>
                    <select name="sortBy" class="form-select">
                        <option value="">Mặc định (Theo ID)</option>
                        <option value="nameAsc" @(Request["sortBy"] == "nameAsc" ? "selected" : "")>Tên A-Z</option>
                        <option value="nameDesc" @(Request["sortBy"] == "nameDesc" ? "selected" : "")>Tên Z-A</option>
                    </select>
                </div>
            </div>

            <!-- Nút Lọc và Đặt lại đã được đồng bộ -->
            <div class="d-flex justify-content-end align-items-center gap-2 mt-4 pt-3" style="border-top: 1px solid var(--adm-border);">
                <a href="@Url.Action("Index", "ManageCategory")" class="btn btn-outline-secondary">
                    <i class="fa-solid fa-rotate-left"></i> Đặt lại
                </a>
                <button type="submit" class="btn btn-primary">
                    <i class="fa-solid fa-filter"></i> LỌC KẾT QUẢ
                </button>
            </div>
        }
    </div>

    <!-- ===== BẢNG DANH SÁCH DANH MỤC ===== -->
    <div class="adm-table-wrap">
        <div class="adm-table-header">
            <h5 class="adm-table-title m-0">
                <i class="fa-solid fa-list-ul"></i>
                Danh Sách Danh Mục (@(Model?.Count() ?? 0))
            </h5>
        </div>
        <div class="adm-table-responsive">
            <table class="table mb-0">
                <thead>
                    <tr>
                        <th class="ps-4" style="width: 120px;">Mã DM</th>
                        <th>Tên danh mục</th>
                        <th class="text-end pe-4" style="width: 150px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <span style="font-family: 'JetBrains Mono', monospace; color: var(--adm-text-2); font-size: 13px;">#@item.Id</span>
                                </td>
                                <td>
                                    <strong style="color: var(--adm-text); font-size: 14.5px;">@item.Name</strong>
                                </td>
                                <td class="text-end pe-4">
                                    <!-- Nút Sửa -->
                                    <a href="@Url.Action("SuaDanhMuc", "ManageCategory", new { id = item.Id })" class="btn btn-sm btn-outline-primary" title="Sửa">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                    </a>

                                    <!-- Nút Xóa (Mở Modal) -->
                                    <button type="button" class="btn btn-sm btn-outline-danger ms-1" title="Xóa"
                                            onclick="openDeleteModal(@item.Id, '@Html.Raw(HttpUtility.JavaScriptStringEncode(item.Name))')">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>

                                    <!-- Form Ẩn Xóa -->
                                    @using (Html.BeginForm("XoaDm", "ManageCategory", FormMethod.Post, new { id = "formDelete_" + item.Id, style = "display:none;" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="adm-empty">
                                <i class="fa-solid fa-box-open"></i>
                                <h5>Trống</h5>
                                <p>Chưa có danh mục nào trong hệ thống.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ============ MODALS (BOOTSTRAP 5 THÍCH ỨNG THEME DARK) ============ -->
<!-- Modal Thêm Danh Mục -->
<div class="modal fade" id="addModal" tabindex="-1" aria-labelledby="addModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header">
                <h5 class="modal-title" id="addModalLabel" style="color: var(--adm-text); font-weight: 700; font-size: 15px;">
                    <i class="fa-solid fa-plus text-success me-2"></i>Thêm Danh Mục Mới
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            @using (Html.BeginForm("ThemDanhMuc", "ManageCategory", FormMethod.Post))
            {
                <div class="modal-body p-4">
                    @Html.AntiForgeryToken()
                    <div class="mb-2">
                        <label class="form-label">Tên danh mục (*)</label>
                        <input type="text" name="Name" class="form-control" required placeholder="Nhập tên danh mục mới..." />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-success"><i class="fa-solid fa-check"></i> Lưu danh mục</button>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal Xác Nhận Xóa -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-danger shadow-lg">
            <div class="modal-header" style="border-bottom-color: var(--adm-red-dim) !important;">
                <h5 class="modal-title text-danger" id="deleteModalLabel" style="font-weight: 700; font-size: 15px;">
                    <i class="fa-solid fa-triangle-exclamation me-2"></i>Xác nhận xóa
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <p style="color: var(--adm-text-2); margin-bottom: 0;">
                    Bạn có chắc chắn muốn xóa danh mục <strong id="deleteCategoryName" class="text-white"></strong>?<br />
                    <span class="text-danger mt-2 d-inline-block" style="font-size: 12.5px;">* Cảnh báo: Việc này có thể ảnh hưởng đến các sản phẩm thuộc danh mục.</span>
                </p>
            </div>
            <div class="modal-footer" style="border-top-color: var(--adm-border) !important;">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-danger" onclick="confirmDelete()"><i class="fa-solid fa-trash"></i> Đồng ý xóa</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let categoryIdToDelete = null;

        function openDeleteModal(id, name) {
            categoryIdToDelete = id;
            document.getElementById('deleteCategoryName').textContent = name;

            var deleteModalEl = document.getElementById('deleteModal');
            var modal = bootstrap.Modal.getOrCreateInstance(deleteModalEl);
            modal.show();
        }

        function confirmDelete() {
            if (categoryIdToDelete) {
                document.getElementById('formDelete_' + categoryIdToDelete).submit();
            }
        }
    </script>
}