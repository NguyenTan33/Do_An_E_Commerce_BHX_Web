@model Do_An_E_Commerce_BHX.Models.Entities.Category

@{
    ViewData["Title"] = "Chỉnh sửa danh mục";
    ViewData["Subtitle"] = $"Sửa thông tin danh mục #{Model.Id}";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container-fluid py-3" style="max-width: 650px;">
    <!-- HEADER BAR -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3" style="border-bottom: 1px solid var(--adm-border);">
        <div>
            <h3 class="mb-1 fw-bold text-white d-flex align-items-center gap-2">
                <i class="fa-solid fa-pen-to-square text-warning"></i> Chỉnh Sửa Danh Mục
            </h3>
            <p class="mb-0 text-muted small">Thay đổi tên gọi hiển thị của danh mục sản phẩm</p>
        </div>
        <a href="@Url.Action("Index", "ManageCategory")" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="fa-solid fa-arrow-left me-1"></i> Quay lại
        </a>
    </div>

    <!-- FORM CARD DARK THEME -->
    <div class="card border-0 shadow-lg rounded-4 overflow-hidden" style="background: var(--adm-surface); border: 1px solid var(--adm-border) !important;">
        <div class="card-body p-4 p-md-5">
            @using (Html.BeginForm("SuaDanhMuc", "ManageCategory", new { area = "Admin" }, FormMethod.Post, null))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.Id)

                <div class="mb-4">
                    <label class="form-label text-muted fw-bold small text-uppercase">Mã danh mục</label>
                    <input type="text" class="form-control bg-dark text-warning border-secondary fw-bold" value="#@Model.Id" disabled />
                </div>

                <div class="mb-4">
                    <label class="form-label text-warning fw-bold small text-uppercase"><i class="fa-solid fa-tag me-1"></i>Tên danh mục (*)</label>
                    @Html.TextBoxFor(m => m.Name, new { @class = "form-control form-control-lg bg-dark text-white border-secondary fw-bold", placeholder = "VD: Rau Củ Tươi, Thịt Cá, Đồ Kèm...", autofocus = "autofocus", required = "required" })
                    @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger small mt-1 d-block" })
                </div>

                <div class="d-flex justify-content-end gap-3 pt-3 border-top border-secondary">
                    <a href="@Url.Action("Index", "ManageCategory")" class="btn btn-outline-secondary px-4 fw-bold">Hủy bỏ</a>
                    <button type="submit" class="btn btn-warning fw-bold px-5 text-dark shadow">
                        <i class="fa-solid fa-floppy-disk me-1"></i> LƯU THAY ĐỔI
                    </button>
                </div>
            }
        </div>
    </div>
</div>