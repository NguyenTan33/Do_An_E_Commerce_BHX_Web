@model IEnumerable<Do_An_E_Commerce_BHX.Models.Entities.Promotion>

@{
    ViewData["Title"] = "Quản lý Khuyến mãi";
    ViewData["Subtitle"] = "Danh sách các mã giảm giá và chương trình ưu đãi";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="dash-page">

    <!-- ===== PAGE HEADER ===== -->
    <div class="d-flex align-items-center justify-content-between mb-4 pb-3" style="border-bottom: 1px solid var(--adm-border);">
        <div>
            <h3 class="mb-1" style="font-size: 20px; font-weight: 700; color: var(--adm-text); display: flex; align-items: center; gap: 10px;">
                <i class="fa-solid fa-ticket text-primary"></i> Quản Lý Khuyến Mãi
            </h3>
            <p class="mb-0" style="font-size: 13.5px; color: var(--adm-text-2);">Danh sách các mã giảm giá và chương trình ưu đãi trong hệ thống</p>
        </div>
        <div class="d-flex align-items-center gap-3">
            <span class="badge bg-secondary" style="font-size: 13px; padding: 8px 12px;">
                <i class="fa-solid fa-tags me-1"></i> @(Model?.Count() ?? 0) Mã
            </span>
            <a href="@Url.Action("ThemPromotion", "ManagePromotion")" class="btn btn-success">
                <i class="fa-solid fa-plus"></i> Thêm mã khuyến mãi
            </a>
        </div>
    </div>

    <!-- ===== BỘ LỌC TÌM KIẾM ===== -->
    <div class="adm-filter-bar">
        <h5 class="mb-3" style="font-size: 14px; font-weight: 700; color: var(--adm-text); display: flex; align-items: center; gap: 8px;">
            <i class="fa-solid fa-sliders text-primary"></i> Bộ lọc tìm kiếm
        </h5>
        @using (Html.BeginForm("Index", "ManagePromotion", FormMethod.Get))
        {
            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <label class="form-label">Mã giảm giá (Code)</label>
                    <input type="text" name="tuKhoa" class="form-control" value="@Request["tuKhoa"]" placeholder="Nhập mã CODE..." style="text-transform: uppercase;" />
                </div>
                <div class="col-12 col-md-6">
                    <label class="form-label">Trạng thái</label>
                    <select name="trangThai" class="form-select">
                        <option value="">-- Tất cả trạng thái --</option>
                        <option value="true" @(Request["trangThai"] == "true" ? "selected" : "")>Đang hiệu lực</option>
                        <option value="false" @(Request["trangThai"] == "false" ? "selected" : "")>Vô hiệu hóa</option>
                    </select>
                </div>
            </div>
            <div class="d-flex justify-content-end align-items-center gap-2 mt-4 pt-3" style="border-top: 1px solid var(--adm-border);">
                <a href="@Url.Action("Index", "ManagePromotion")" class="btn btn-outline-secondary">
                    <i class="fa-solid fa-rotate-left"></i> Đặt lại
                </a>
                <button type="submit" class="btn btn-primary">
                    <i class="fa-solid fa-filter"></i> LỌC KẾT QUẢ
                </button>
            </div>
        }
    </div>

    <!-- ===== BẢNG DANH SÁCH MÃ KHUYẾN MÃI ===== -->
    <div class="adm-table-wrap">
        <div class="adm-table-header">
            <h5 class="adm-table-title m-0">
                <i class="fa-solid fa-list-ul"></i>
                Danh Sách Khuyến Mãi (@(Model?.Count() ?? 0))
            </h5>
        </div>
        <div class="adm-table-responsive">
            <table class="table mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">Mã giảm giá</th>
                        <th>Mức giảm</th>
                        <th>Điều kiện đơn</th>
                        <th>Danh mục áp dụng</th>
                        <th>Lượt dùng</th>
                        <th>Hiệu lực từ</th>
                        <th>Hết hạn vào</th>
                        <th>Trạng thái</th>
                        <th class="text-end pe-4" style="min-width: 120px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            bool isExpired = item.ExpiryDate < DateTime.Now;
                            bool isExhausted = item.UsageLimit > 0 && item.UsedCount >= item.UsageLimit;
                            string minOrderText = item.MinOrderAmount > 0 ? $"Đơn từ {item.MinOrderAmount:N0}đ" : "Đơn từ 0đ";
                            string catText = item.Category != null ? item.Category.Name : "Tất cả sản phẩm";

                            <tr>
                                <td class="ps-4">
                                    <div style="font-family: 'JetBrains Mono', monospace; font-size: 15px; font-weight: 700; color: var(--adm-gold); letter-spacing: 1px;">@item.Code</div>
                                    <small style="color: var(--adm-text-3);">@(item.Description ?? item.Code)</small>
                                </td>
                                <td style="color: var(--adm-red); font-family: 'JetBrains Mono', monospace; font-weight: 600;">
                                    @if (item.percentDiscount > 0)
                                    {
                                        <span>- @item.percentDiscount.ToString("0.##") %</span>
                                        if (item.MaxDiscountAmount > 0)
                                        {
                                            <small class="d-block" style="font-size: 11px; color: var(--adm-text-3);">(Tối đa @item.MaxDiscountAmount.ToString("N0")đ)</small>
                                        }
                                    }
                                    else if (item.DiscountValue > 0)
                                    {
                                        <span>- @item.DiscountValue.ToString("N0") ₫</span>
                                    }
                                    else
                                    {
                                        <span style="color: var(--adm-text-3);">0 ₫</span>
                                    }
                                </td>
                                <td><span class="badge bg-secondary text-white">@minOrderText</span></td>
                                <td><span class="badge bg-info text-dark">@catText</span></td>
                                <td>
                                    <span class="badge @(isExhausted ? "bg-danger text-white" : "bg-warning text-dark") font-monospace">
                                        @item.UsedCount / @(item.UsageLimit > 0 ? item.UsageLimit.ToString("N0") : "∞")
                                    </span>
                                </td>
                                <td style="font-family: 'JetBrains Mono', monospace; font-size: 13px; color: var(--adm-text-2);">
                                    @item.EffectiveDate.ToString("dd/MM/yyyy HH:mm")
                                </td>
                                <td style="font-family: 'JetBrains Mono', monospace; font-size: 13px; color: var(--adm-text-2);">
                                    @item.ExpiryDate.ToString("dd/MM/yyyy HH:mm")
                                </td>
                                <td>
                                    @if (isExhausted || !item.IsActive)
                                    {
                                        if (isExhausted)
                                        {
                                            <span class="badge bg-danger text-white">Hết số lượng (Đã tắt)</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-dark border border-secondary text-muted">Vô hiệu hóa</span>
                                        }
                                    }
                                    else if (isExpired)
                                    {
                                        <span class="badge bg-danger">Đã hết hạn</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Đang hiệu lực</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <!-- Nút Sửa -->
                                    <a href="@Url.Action("SuaPromotion", "ManagePromotion", new { id = item.Id })" class="btn btn-sm btn-outline-primary" title="Sửa mã">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                    </a>

                                    <!-- Nút Xóa (Mở Modal) -->
                                    <button type="button" class="btn btn-sm btn-outline-danger ms-1" title="Xóa mã"
                                            onclick="openDeleteModal(@item.Id, '@item.Code')">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>

                                    <!-- Form Ẩn Xóa -->
                                    @using (Html.BeginForm("XoaPromotion", "ManagePromotion", FormMethod.Post, new { id = "formDelete_" + item.Id, style = "display:none;" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="adm-empty">
                                <i class="fa-solid fa-ticket"></i>
                                <h5>Trống</h5>
                                <p>Chưa có mã khuyến mãi nào trong hệ thống.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ============ MODALS (BOOTSTRAP 5 THÍCH ỨNG THEME DARK) ============ -->
<!-- Modal Xác Nhận Xóa -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-danger shadow-lg">
            <div class="modal-header" style="border-bottom-color: var(--adm-red-dim) !important;">
                <h5 class="modal-title text-danger" id="deleteModalLabel" style="font-weight: 700; font-size: 15px;">
                    <i class="fa-solid fa-triangle-exclamation me-2"></i>Xác nhận xóa
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <p style="color: var(--adm-text-2); margin-bottom: 0;">
                    Bạn có chắc chắn muốn xóa mã khuyến mãi <strong id="deletePromoCode" class="text-white" style="font-family: 'JetBrains Mono', monospace; font-size: 16px;"></strong>?<br />
                    <span class="text-danger mt-2 d-inline-block" style="font-size: 12.5px;">* Cảnh báo: Việc này có thể ảnh hưởng đến các đơn hàng đang sử dụng mã này.</span>
                </p>
            </div>
            <div class="modal-footer" style="border-top-color: var(--adm-border) !important;">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-danger" onclick="confirmDelete()"><i class="fa-solid fa-trash"></i> Xóa mã</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let promoIdToDelete = null;

        function openDeleteModal(id, code) {
            promoIdToDelete = id;
            document.getElementById('deletePromoCode').textContent = code;

            // Mở Modal bằng Bootstrap 5 Javascript
            var deleteModalEl = document.getElementById('deleteModal');
            var modal = bootstrap.Modal.getOrCreateInstance(deleteModalEl);
            modal.show();
        }

        function confirmDelete() {
            if (promoIdToDelete) {
                document.getElementById('formDelete_' + promoIdToDelete).submit();
            }
        }
    </script>
}