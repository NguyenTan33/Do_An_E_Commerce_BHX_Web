@model Do_An_E_Commerce_BHX.Models.Entities.Promotion

@{
    ViewData["Title"] = "Chỉnh sửa mã khuyến mãi";
    ViewData["Subtitle"] = $"Sửa Voucher {Model.Code}";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
    string startDateVal = Model.StartDate.ToString("yyyy-MM-ddTHH:mm");
    string endDateVal = Model.EndDate.ToString("yyyy-MM-ddTHH:mm");
}

<div class="container-fluid py-3" style="max-width: 850px;">
    <!-- HEADER BAR -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3" style="border-bottom: 1px solid var(--adm-border);">
        <div>
            <h3 class="mb-1 fw-bold text-white d-flex align-items-center gap-2">
                <i class="fa-solid fa-pen-to-square text-warning"></i> Chỉnh Sửa Voucher: <span class="text-warning">@Model.Code</span>
            </h3>
            <p class="mb-0 text-muted small">Cập nhật thông tin chi tiết và hạn dùng của mã giảm giá</p>
        </div>
        <a href="@Url.Action("Index", "ManagePromotion")" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="fa-solid fa-arrow-left me-1"></i> Quay lại danh sách
        </a>
    </div>

    <!-- FORM CARD DARK THEME -->
    <div class="card border-0 shadow-lg rounded-4 overflow-hidden" style="background: var(--adm-surface); border: 1px solid var(--adm-border) !important;">
        <div class="card-body p-4 p-md-5">
            @using (Html.BeginForm("SuaPromotion", "ManagePromotion", FormMethod.Post, new { id = "form-sua-voucher" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.Id)
                @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

                <!-- CODE VOUCHER & TÊN KHUYẾN MÃI -->
                <div class="row g-3 mb-4">
                    <div class="col-md-5">
                        <label class="form-label text-warning fw-bold small text-uppercase"><i class="fa-solid fa-key me-1"></i>Mã Voucher (Code) (*)</label>
                        @Html.TextBoxFor(m => m.Code, new { @class = "form-control form-control-lg bg-dark text-warning border-secondary fw-bold", placeholder = "VD: BHXFREE, TET2026...", style = "text-transform: uppercase;", required = "required" })
                        @Html.ValidationMessageFor(m => m.Code, "", new { @class = "text-danger small mt-1 d-block" })
                    </div>
                    <div class="col-md-7">
                        <label class="form-label text-warning fw-bold small text-uppercase"><i class="fa-solid fa-heading me-1"></i>Tên chương trình (*)</label>
                        @Html.TextBoxFor(m => m.Title, new { @class = "form-control form-control-lg bg-dark text-white border-secondary", placeholder = "VD: Giảm 20k đơn từ 200k...", required = "required" })
                        @Html.ValidationMessageFor(m => m.Title, "", new { @class = "text-danger small mt-1 d-block" })
                    </div>
                </div>

                <!-- LOẠI GIẢM GIÁ & GIÁ TRỊ GIẢM -->
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label class="form-label text-warning fw-bold small text-uppercase"><i class="fa-solid fa-percent me-1"></i>Loại giảm giá (*)</label>
                        @Html.DropDownListFor(m => m.DiscountType, new List<SelectListItem>
                        {
                            new SelectListItem { Text = "Giảm theo số tiền cố định (VNĐ)", Value = "AMOUNT" },
                            new SelectListItem { Text = "Giảm theo phần trăm (%)", Value = "PERCENT" }
                        }, new { @class = "form-select bg-dark text-white border-secondary fw-bold" })
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-warning fw-bold small text-uppercase"><i class="fa-solid fa-calculator me-1"></i>Mức giảm (*)</label>
                        @Html.TextBoxFor(m => m.DiscountValue, new { type = "number", min = "1", step = "any", @class = "form-control bg-dark text-white border-secondary fw-bold", placeholder = "VD: 20000 hoặc 10", required = "required" })
                        @Html.ValidationMessageFor(m => m.DiscountValue, "", new { @class = "text-danger small mt-1 d-block" })
                    </div>
                </div>

                <!-- ĐƠN TỐI THIỂU & GIẢM TỐI ĐA -->
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label class="form-label text-warning fw-bold small text-uppercase"><i class="fa-solid fa-basket-shopping me-1"></i>Đơn hàng tối thiểu (VNĐ)</label>
                        @Html.TextBoxFor(m => m.MinOrderAmount, new { type = "number", min = "0", step = "1000", @class = "form-control bg-dark text-white border-secondary", placeholder = "VD: 150000" })
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-warning fw-bold small text-uppercase"><i class="fa-solid fa-shield-halved me-1"></i>Số tiền giảm tối đa (Cho %)</label>
                        @Html.TextBoxFor(m => m.MaxDiscountAmount, new { type = "number", min = "0", step = "1000", @class = "form-control bg-dark text-white border-secondary", placeholder = "VD: 50000" })
                    </div>
                </div>

                <!-- SỐ LƯỢNG LƯỢT DÙNG & SỐ LƯỢT/KHÁCH -->
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label class="form-label text-warning fw-bold small text-uppercase"><i class="fa-solid fa-ticket-simple me-1"></i>Số lượt phát hành (*)</label>
                        @Html.TextBoxFor(m => m.UsageLimit, new { type = "number", min = "1", @class = "form-control bg-dark text-white border-secondary", placeholder = "VD: 100", required = "required" })
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-warning fw-bold small text-uppercase"><i class="fa-solid fa-user-lock me-1"></i>Lượt dùng tối đa / Khách hàng</label>
                        @Html.TextBoxFor(m => m.PerUserLimit, new { type = "number", min = "1", @class = "form-control bg-dark text-white border-secondary", placeholder = "1" })
                    </div>
                </div>

                <!-- NGÀY BẮT ĐẦU & KẾT THÚC -->
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label class="form-label text-warning fw-bold small text-uppercase"><i class="fa-regular fa-calendar-check me-1"></i>Ngày bắt đầu (*)</label>
                        <input type="datetime-local" name="StartDate" value="@startDateVal" class="form-control bg-dark text-white border-secondary" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-warning fw-bold small text-uppercase"><i class="fa-regular fa-calendar-xmark me-1"></i>Ngày kết thúc (*)</label>
                        <input type="datetime-local" name="EndDate" value="@endDateVal" class="form-control bg-dark text-white border-secondary" required />
                    </div>
                </div>

                <!-- MÔ TẢ & TRẠNG THÁI -->
                <div class="mb-4">
                    <label class="form-label text-warning fw-bold small text-uppercase"><i class="fa-solid fa-align-left me-1"></i>Mô tả chương trình</label>
                    @Html.TextAreaFor(m => m.Description, new { rows = "3", @class = "form-control bg-dark text-white border-secondary", placeholder = "Nhập điều kiện áp dụng voucher..." })
                </div>

                <div class="mb-4 p-3 rounded-3 border border-secondary" style="background: rgba(255, 255, 255, 0.03);">
                    <label class="form-check-label text-success fw-bold cursor-pointer">
                        @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input me-2" }) Kích hoạt voucher ngay lập tức
                    </label>
                </div>

                <!-- BUTTON ACTIONS -->
                <div class="d-flex justify-content-end gap-3 pt-3 border-top border-secondary">
                    <a href="@Url.Action("Index", "ManagePromotion")" class="btn btn-outline-secondary px-4 fw-bold">Hủy bỏ</a>
                    <button type="submit" class="btn btn-warning fw-bold px-5 text-dark shadow">
                        <i class="fa-solid fa-floppy-disk me-1"></i> CẬP NHẬT VOUCHER
                    </button>
                </div>
            }
        </div>
    </div>
</div>