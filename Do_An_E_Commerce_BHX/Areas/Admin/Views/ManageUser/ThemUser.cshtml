@model Do_An_E_Commerce_BHX.Areas.Admin.Controllers.CreateUserViewModel

@{
    ViewData["Title"] = "Thêm người dùng mới";
    ViewData["Subtitle"] = "Tạo tài khoản và cấp quyền truy cập";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container-fluid py-3" style="max-width: 750px;">
    <!-- HEADER BAR -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3" style="border-bottom: 1px solid var(--adm-border);">
        <div>
            <h3 class="mb-1 fw-bold text-white d-flex align-items-center gap-2">
                <i class="fa-solid fa-user-plus text-warning"></i> Thêm Người Dùng Mới
            </h3>
            <p class="mb-0 text-muted small">Khởi tạo tài khoản thành viên hoặc Quản trị viên mới</p>
        </div>
        <a href="@Url.Action("Index", "ManageUser")" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="fa-solid fa-arrow-left me-1"></i> Quay lại
        </a>
    </div>

    <!-- FORM CARD DARK THEME -->
    <div class="card border-0 shadow-lg rounded-4 overflow-hidden" style="background: var(--adm-surface); border: 1px solid var(--adm-border) !important;">
        <div class="card-body p-4 p-md-5">
            @using (Html.BeginForm("ThemUser", "ManageUser", FormMethod.Post, new { id = "form-them-user" }))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

                <div class="mb-4">
                    <label class="form-label text-warning fw-bold small text-uppercase"><i class="fa-solid fa-user me-1"></i>Họ và tên (*)</label>
                    @Html.TextBoxFor(m => m.FullName, new { @class = "form-control form-control-lg bg-dark text-white border-secondary", placeholder = "VD: Nguyễn Văn A...", required = "required" })
                    @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger small mt-1 d-block" })
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label class="form-label text-warning fw-bold small text-uppercase"><i class="fa-solid fa-envelope me-1"></i>Email (*)</label>
                        @Html.TextBoxFor(m => m.Email, new { type = "email", @class = "form-control bg-dark text-white border-secondary", placeholder = "user@gmail.com", required = "required" })
                        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small mt-1 d-block" })
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-warning fw-bold small text-uppercase"><i class="fa-solid fa-phone me-1"></i>Số điện thoại</label>
                        @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "form-control bg-dark text-white border-secondary", placeholder = "0901234567" })
                        @Html.ValidationMessageFor(m => m.PhoneNumber, "", new { @class = "text-danger small mt-1 d-block" })
                    </div>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label class="form-label text-warning fw-bold small text-uppercase"><i class="fa-solid fa-lock me-1"></i>Mật khẩu (*)</label>
                        @Html.PasswordFor(m => m.Password, new { @class = "form-control bg-dark text-white border-secondary", placeholder = "••••••••", required = "required" })
                        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small mt-1 d-block" })
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-warning fw-bold small text-uppercase"><i class="fa-solid fa-shield-halved me-1"></i>Vai trò (Role) (*)</label>
                        @Html.DropDownListFor(m => m.RoleName, ViewBag.Roles as SelectList, "-- Chọn vai trò --", new { @class = "form-select bg-dark text-white border-secondary fw-bold", required = "required" })
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-3 pt-3 border-top border-secondary">
                    <a href="@Url.Action("Index", "ManageUser")" class="btn btn-outline-secondary px-4 fw-bold">Hủy bỏ</a>
                    <button type="submit" class="btn btn-warning fw-bold px-5 text-dark shadow">
                        <i class="fa-solid fa-user-plus me-1"></i> KHỞI TẠO TÀI KHOẢN
                    </button>
                </div>
            }
        </div>
    </div>
</div>