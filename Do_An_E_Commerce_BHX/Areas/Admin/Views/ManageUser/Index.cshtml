@model IEnumerable<Do_An_E_Commerce_BHX.Models.UserViewModel>

@{
    ViewData["Title"] = "Quản lý người dùng";
    ViewData["Subtitle"] = "Danh sách tài khoản và phân quyền hệ thống";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";

    bool shouldMask = Do_An_E_Commerce_BHX.Helpers.ManagerSensitiveInfoConfig.ShouldMaskForUser(User);

    Func<string, string> maskEmail = email =>
    {
        if (!shouldMask || string.IsNullOrEmpty(email)) return email;
        int atIndex = email.IndexOf('@');
        if (atIndex <= 0) return "*****";
        string name = email.Substring(0, atIndex);
        string domain = email.Substring(atIndex);
        string maskedName = name.Length <= 2 ? name[0] + "***" : name.Substring(0, 2) + "*****";
        return maskedName + domain;
    };

    Func<string, string> maskPhone = phone =>
    {
        if (!shouldMask || string.IsNullOrEmpty(phone)) return phone;
        if (phone.Length < 6) return "*****";
        return phone.Substring(0, 3) + "****" + phone.Substring(phone.Length - 3);
    };
}



<div class="dash-page">

    <!-- ===== PAGE HEADER ===== -->
    <div class="d-flex align-items-center justify-content-between mb-4 pb-3" style="border-bottom: 1px solid var(--adm-border);">
        <div>
            <h3 class="mb-1" style="font-size: 20px; font-weight: 700; color: var(--adm-text); display: flex; align-items: center; gap: 10px;">
                <i class="fa-solid fa-users text-primary"></i> Quản Lý Người Dùng
            </h3>
            <p class="mb-0" style="font-size: 13.5px; color: var(--adm-text-2);">Danh sách tài khoản, điểm thưởng, phân quyền và trạng thái trực tuyến</p>
        </div>
        <div class="d-flex align-items-center gap-3">
            @if (User.IsInRole("Admin"))
            {
                <a href="@Url.Action("ThemUser", "ManageUser")" class="btn btn-success fw-bold">
                    <i class="fa-solid fa-user-plus"></i> Thêm tài khoản
                </a>
            }
            else
            {
                <button type="button" class="btn btn-success fw-bold" onclick="alert('Bạn không có quyền thực hiện chức năng này!')">
                    <i class="fa-solid fa-user-plus"></i> Thêm tài khoản
                </button>
            }
        </div>
    </div>

    @if (User.IsInRole("Admin"))
    {
        bool isManagerAllowed = ViewBag.AllowManagerViewSensitiveInfo == true;
        <div class="p-3 mb-4 rounded-3 border @(isManagerAllowed ? "border-success bg-success" : "border-warning bg-warning") bg-opacity-10 shadow-sm" id="sensitiveSettingCard">
            <div class="d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="p-2 rounded-circle @(isManagerAllowed ? "bg-success" : "bg-warning") text-dark fs-4 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                        <i class="fa-solid @(isManagerAllowed ? "fa-eye" : "fa-user-shield")"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-1 text-white">Quyền Xem Thông Tin Nhạy Cảm Của Manager (SĐT & Email)</h6>
                        <p class="mb-0 text-muted small">
                            @(isManagerAllowed 
                                ? "Tài khoản Manager ĐANG ĐƯỢC PHÉP xem đầy đủ SĐT & Email khách hàng trên hệ thống." 
                                : "Tài khoản Manager ĐANG BỊ ẨN / CHE SĐT & Email (Mặc định bảo mật).")
                        </p>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-3 ms-auto ms-md-0">
                    <span class="badge @(isManagerAllowed ? "bg-success text-white" : "bg-warning text-dark") fw-bold px-3 py-2 fs-6">
                        <i class="fa-solid @(isManagerAllowed ? "fa-unlock" : "fa-lock") me-1"></i>
                        @(isManagerAllowed ? "ĐÃ MỞ (Manager xem đầy đủ)" : "ĐÃ CHE (Bảo mật cho Manager)")
                    </span>
                    <div class="form-check form-switch m-0" style="font-size: 1.35rem;">
                        <input class="form-check-input" type="checkbox" id="toggleManagerSensitiveSwitch" @(isManagerAllowed ? "checked" : "") style="cursor: pointer;" title="Bật/Tắt quyền xem SĐT & Email của Manager" />
                    </div>
                </div>
            </div>
        </div>
    }

    @{
        int onlineUsersCount = Model != null ? Model.Count(u => u.Presence.IsOnline) : 0;
        int offlineUsersCount = Model != null ? Model.Count(u => !u.Presence.IsOnline) : 0;
        int totalUsersCount = Model != null ? Model.Count() : 0;
    }

    <!-- ===== THẺ THỐNG KÊ SỐ LƯỢNG NGƯỜI DÙNG ONLINE / OFFLINE ===== -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="p-3 rounded-4 border border-success d-flex align-items-center justify-content-between shadow-sm" style="background: rgba(16, 185, 129, 0.08);">
                <div>
                    <div class="small text-uppercase fw-bold text-success" style="letter-spacing: 0.5px;">Đang Trực Tuyến (Online)</div>
                    <h3 class="m-0 fw-bold text-white font-monospace mt-1">@onlineUsersCount <span class="fs-6 text-muted font-sans-serif fw-normal">tài khoản</span></h3>
                </div>
                <div class="rounded-circle bg-success text-white d-flex align-items-center justify-content-center shadow-sm" style="width: 48px; height: 48px; font-size: 20px;">
                    <i class="fa-solid fa-signal"></i>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="p-3 rounded-4 border border-warning d-flex align-items-center justify-content-between shadow-sm" style="background: rgba(240, 180, 41, 0.08);">
                <div>
                    <div class="small text-uppercase fw-bold text-warning" style="letter-spacing: 0.5px;">Đang Ngoại Tuyến (Offline)</div>
                    <h3 class="m-0 fw-bold text-white font-monospace mt-1">@offlineUsersCount <span class="fs-6 text-muted font-sans-serif fw-normal">tài khoản</span></h3>
                </div>
                <div class="rounded-circle bg-warning text-dark d-flex align-items-center justify-content-center shadow-sm" style="width: 48px; height: 48px; font-size: 20px;">
                    <i class="fa-solid fa-moon"></i>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="p-3 rounded-4 border border-secondary d-flex align-items-center justify-content-between shadow-sm" style="background: var(--adm-surface-2);">
                <div>
                    <div class="small text-uppercase fw-bold text-info" style="letter-spacing: 0.5px;">Tổng Số Người Dùng</div>
                    <h3 class="m-0 fw-bold text-white font-monospace mt-1">@totalUsersCount <span class="fs-6 text-muted font-sans-serif fw-normal">tài khoản</span></h3>
                </div>
                <div class="rounded-circle bg-info text-dark d-flex align-items-center justify-content-center shadow-sm" style="width: 48px; height: 48px; font-size: 20px;">
                    <i class="fa-solid fa-users"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- ===== HIỂN THỊ CẢNH BÁO LỖI ===== -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger d-flex align-items-center mb-4 shadow-sm" role="alert" style="background: var(--adm-red-dim); border-color: var(--adm-red); color: var(--adm-red);">
            <i class="fa-solid fa-triangle-exclamation me-2 fs-5"></i>
            <div style="font-weight: 500;">@TempData["Error"]</div>
        </div>
    }

    <!-- ===== BỘ LỌC TÌM KIẾM ===== -->
    <div class="adm-filter-bar">
        <h5 class="mb-3" style="font-size: 14px; font-weight: 700; color: var(--adm-text); display: flex; align-items: center; gap: 8px;">
            <i class="fa-solid fa-sliders text-primary"></i> Bộ lọc tìm kiếm
        </h5>
        @using (Html.BeginForm("Index", "ManageUser", FormMethod.Get))
        {
            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <label class="form-label">Từ khóa tìm kiếm</label>
                    <div class="input-group">
                        <span class="input-group-text border-end-0"><i class="fa-solid fa-magnifying-glass"></i></span>
                        <input type="text" name="tuKhoa" class="form-control border-start-0 ps-0" value="@Request["tuKhoa"]" placeholder="Tên, Email hoặc Username..." />
                    </div>
                </div>
                <div class="col-12 col-md-6">
                    <label class="form-label">Nhóm quyền (Role)</label>
                    @Html.DropDownList("roleFilter", ViewBag.RolesList as SelectList, "-- Tất cả quyền --", new { @class = "form-select" })
                </div>
            </div>

            <div class="d-flex justify-content-end align-items-center gap-2 mt-4 pt-3" style="border-top: 1px solid var(--adm-border);">
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                    <i class="fa-solid fa-rotate-left"></i> Đặt lại
                </a>
                <button type="submit" class="btn btn-primary">
                    <i class="fa-solid fa-filter"></i> LỌC DỮ LIỆU
                </button>
            </div>
        }
    </div>

    <!-- ===== BẢNG DANH SÁCH USER ===== -->
    <div class="adm-table-wrap">
        <div class="adm-table-header">
            <h5 class="adm-table-title m-0">
                <i class="fa-solid fa-list-ul"></i>
                Danh Sách Tài Khoản (@(Model?.Count() ?? 0))
            </h5>
        </div>
        <div class="adm-table-responsive">
            <table class="table mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">Người dùng</th>
                        <th>Số điện thoại</th>
                        <th>Hạng Thành Viên</th>
                        <th>Phân quyền</th>
                        <th>Trạng thái</th>
                        <th class="text-end pe-4" style="min-width: 170px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var user in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div style="font-weight: 600; font-size: 14.5px; color: var(--adm-text);">@user.FullName</div>
                                    <div style="font-family: 'JetBrains Mono', monospace; font-size: 12.5px; color: var(--adm-text-2);">@maskEmail(user.Email)</div>
                                </td>
                                <td>
                                    <span style="font-family: 'JetBrains Mono', monospace; font-size: 13.5px; color: var(--adm-text-2);">
                                        @(string.IsNullOrEmpty(user.PhoneNumber) ? "N/A" : maskPhone(user.PhoneNumber))
                                    </span>
                                </td>
                                <td>
                                    <div class="d-flex flex-column align-items-start gap-1">
                                        <div class="adm-custom-tier">
                                            @Html.Raw(Do_An_E_Commerce_BHX.Models.CustomerTierHelper.GetTierBadgeHtml(user.LoyaltyPoints))
                                        </div>
                                        <small style="font-size: 12px; color: var(--adm-gold); font-weight: 600;">
                                            <i class="fa-solid fa-coins me-1"></i>@user.LoyaltyPoints.ToString("N0") điểm
                                        </small>
                                    </div>
                                </td>
                                <td>
                                    @if (user.Roles != null && user.Roles.Any())
                                    {
                                        foreach (var role in user.Roles)
                                        {
                                            if (role == "Admin")
                                            {
                                                <span class="badge bg-danger">@role</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-primary">@role</span>
                                            }
                                        }
                                    }
                                    else
                                    {
                                        <span style="color: var(--adm-text-3); font-size: 12.5px;">Chưa phân quyền</span>
                                    }
                                </td>
                                <td>
                                    <div class="mb-1">
                                        @Html.Raw(user.Presence.BadgeHtml)
                                    </div>
                                    @if (user.IsLocked)
                                    {
                                        <span class="badge bg-danger bg-opacity-25 text-danger border border-danger">🔒 Đã khóa</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25">✅ Mở khóa</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <!-- Nút Xem Lịch Sử Đơn Hàng -->
                                    <a href="@Url.Action("OrderHistory", "ManageUser", new { userId = user.Id })" class="btn btn-sm btn-outline-success" title="Xem lịch sử đơn hàng">
                                        <i class="fa-solid fa-cart-shopping"></i>
                                    </a>

                                    @if (User.IsInRole("Admin"))
                                    {
                                        <!-- Nút Reset Mật khẩu -->
                                        <button type="button" class="btn btn-sm btn-outline-warning ms-1" title="Đặt lại mật khẩu"
                                                onclick="openResetPassModal('@user.Id', '@user.Email')">
                                            <i class="fa-solid fa-key"></i>
                                        </button>

                                        <!-- Nút Khóa / Mở Khóa -->
                                        using (Html.BeginForm("ToggleLockout", "ManageUser", FormMethod.Post, new { style = "display:inline-block;" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@user.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-secondary ms-1" title="@(user.IsLocked ? "Mở khóa tài khoản" : "Khóa tài khoản")"
                                                    onclick="return confirm('Bạn có chắc muốn @(user.IsLocked ? "MỞ KHÓA" : "KHÓA") tài khoản này không?');">
                                                @if (user.IsLocked)
                                                {
                                                    <i class="fa-solid fa-lock-open"></i>
                                                }
                                                else
                                                {
                                                    <i class="fa-solid fa-lock"></i>
                                                }
                                            </button>
                                        }

                                        <!-- Nút Sửa -->
                                        <a href="@Url.Action("SuaUser", "ManageUser", new { id = user.Id })" class="btn btn-sm btn-outline-primary ms-1" title="Sửa thông tin">
                                            <i class="fa-solid fa-pen-to-square"></i>
                                        </a>

                                        <!-- Nút Xóa (Mở Modal) -->
                                        <button type="button" class="btn btn-sm btn-outline-danger ms-1" title="Xóa tài khoản"
                                                onclick="openDeleteModal('@user.Id', '@user.Email')">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>

                                        <!-- Form Ẩn Xóa -->
                                        using (Html.BeginForm("DeleteUser", "ManageUser", FormMethod.Post, new { id = "formDelete_" + user.Id, style = "display:none;" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@user.Id" />
                                        }
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-warning ms-1" title="Đặt lại mật khẩu" onclick="alert('Bạn không có quyền thực hiện chức năng này!')">
                                            <i class="fa-solid fa-key"></i>
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary ms-1" title="Khóa/Mở khóa" onclick="alert('Bạn không có quyền thực hiện chức năng này!')">
                                            <i class="fa-solid fa-lock"></i>
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-primary ms-1" title="Sửa thông tin" onclick="alert('Bạn không có quyền thực hiện chức năng này!')">
                                            <i class="fa-solid fa-pen-to-square"></i>
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-danger ms-1" title="Xóa tài khoản" onclick="alert('Bạn không có quyền thực hiện chức năng này!')">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="adm-empty">
                                <i class="fa-solid fa-user-slash"></i>
                                <h5>Trống</h5>
                                <p>Chưa có người dùng nào phù hợp với tìm kiếm.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ============ MODALS (BOOTSTRAP 5) ============ -->
<!-- Modal Reset Password (Gửi AJAX) -->
<div class="modal fade" id="resetPassModal" tabindex="-1" aria-labelledby="resetPassModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header">
                <h5 class="modal-title" id="resetPassModalLabel" style="color: var(--adm-text); font-weight: 700; font-size: 15px;">
                    <i class="fa-solid fa-key text-warning me-2"></i>Đặt lại mật khẩu
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <p style="font-size: 13.5px; color: var(--adm-text-2); margin-bottom: 16px;">
                    Nhập mật khẩu mới cho tài khoản: <strong id="resetUserEmail" class="text-white" style="font-family: 'JetBrains Mono', monospace;"></strong>
                </p>

                @Html.AntiForgeryToken()
                <input type="hidden" id="resetUserId" />

                <div class="mb-3">
                    <label class="form-label">Mật khẩu mới</label>
                    <input type="password" id="newPassword" class="form-control" placeholder="Nhập ít nhất 6 ký tự..." />
                </div>

                <!-- Thông báo kết quả AJAX -->
                <div id="resetMessage" style="font-size: 13px; font-weight: 600;"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-warning fw-bold text-dark" onclick="submitResetPassword()"><i class="fa-solid fa-check me-1"></i> Cập nhật mật khẩu</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Xác Nhận Xóa -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-danger shadow-lg">
            <div class="modal-header" style="border-bottom-color: var(--adm-red-dim) !important;">
                <h5 class="modal-title text-danger" id="deleteModalLabel" style="font-weight: 700; font-size: 15px;">
                    <i class="fa-solid fa-triangle-exclamation me-2"></i>Xác nhận xóa tài khoản
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <p style="color: var(--adm-text-2); margin-bottom: 0;">
                    Hành động này sẽ xóa vĩnh viễn tài khoản <strong id="deleteUserEmail" class="text-white" style="font-family: 'JetBrains Mono', monospace;"></strong>.<br />
                    <span class="text-danger mt-2 d-inline-block" style="font-size: 12.5px;">* Cảnh báo: Hành động này không thể hoàn tác.</span>
                </p>
            </div>
            <div class="modal-footer" style="border-top-color: var(--adm-border) !important;">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-danger" onclick="confirmDelete()"><i class="fa-solid fa-trash me-1"></i> Xóa tài khoản</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // --- XỬ LÝ XÓA TÀI KHOẢN (BOOTSTRAP MODAL) ---
        let userIdToDelete = null;

        function openDeleteModal(id, email) {
            userIdToDelete = id;
            document.getElementById('deleteUserEmail').textContent = email;
            var deleteModal = bootstrap.Modal.getOrCreateInstance(document.getElementById('deleteModal'));
            deleteModal.show();
        }

        function confirmDelete() {
            if (userIdToDelete) {
                document.getElementById('formDelete_' + userIdToDelete).submit();
            }
        }

        // --- XỬ LÝ ĐẶT LẠI MẬT KHẨU (AJAX + BOOTSTRAP MODAL) ---
        function openResetPassModal(id, email) {
            document.getElementById('resetUserId').value = id;
            document.getElementById('resetUserEmail').textContent = email;
            document.getElementById('newPassword').value = '';
            document.getElementById('resetMessage').textContent = '';

            var resetPassModal = bootstrap.Modal.getOrCreateInstance(document.getElementById('resetPassModal'));
            resetPassModal.show();
        }

        function submitResetPassword() {
            const userId = document.getElementById('resetUserId').value;
            const newPassword = document.getElementById('newPassword').value;
            const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
            const token = tokenInput ? tokenInput.value : '';
            const msgBox = document.getElementById('resetMessage');

            if (!newPassword || newPassword.length < 6) {
                msgBox.style.color = 'var(--adm-red)';
                msgBox.textContent = 'Mật khẩu phải có ít nhất 6 ký tự!';
                return;
            }

            msgBox.style.color = 'var(--adm-gold)';
            msgBox.textContent = 'Đang xử lý...';

            const formData = new FormData();
            formData.append('userId', userId);
            formData.append('newPassword', newPassword);
            if (token) formData.append('__RequestVerificationToken', token);

            fetch('@Url.Action("ResetPassword", "ManageUser")', {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    msgBox.style.color = 'var(--adm-emerald)';
                    msgBox.textContent = '✅ Đặt lại mật khẩu thành công!';
                    setTimeout(() => {
                        var modalEl = document.getElementById('resetPassModal');
                        var modal = bootstrap.Modal.getInstance(modalEl);
                        if (modal) modal.hide();
                    }, 1500);
                } else {
                    msgBox.style.color = 'var(--adm-red)';
                    msgBox.textContent = '❌ Lỗi: ' + data.message;
                }
            })
            .catch(error => {
                msgBox.style.color = 'var(--adm-red)';
                msgBox.textContent = 'Đã xảy ra lỗi kết nối!';
            });
        }

        $(document).ready(function () {
            $('#toggleManagerSensitiveSwitch').on('change', function () {
                var isChecked = $(this).is(':checked');
                var switchEl = $(this);
                switchEl.prop('disabled', true);

                $.ajax({
                    url: '@Url.Action("ToggleManagerSensitiveInfo", "ManageUser")',
                    type: 'POST',
                    data: { enable: isChecked },
                    success: function (res) {
                        switchEl.prop('disabled', false);
                        if (res.success) {
                            alert(res.message);
                            location.reload();
                        } else {
                            alert(res.message || "Lỗi khi cập nhật cấu hình!");
                            switchEl.prop('checked', !isChecked);
                        }
                    },
                    error: function () {
                        switchEl.prop('disabled', false);
                        alert("Lỗi kết nối máy chủ khi đổi cấu hình!");
                        switchEl.prop('checked', !isChecked);
                    }
                });
            });
        });
    </script>
}