@model IEnumerable<Do_An_E_Commerce_BHX.Models.Entities.Order>
@using Do_An_E_Commerce_BHX.Models
@using Do_An_E_Commerce_BHX.Models.Entities

@{
    var customer = ViewBag.Customer as ApplicationUser;

    bool isAdmin = User.IsInRole("Admin");

    Func<string, string> maskEmail = email =>
    {
        if (isAdmin || string.IsNullOrEmpty(email) || !email.Contains("@")) return email;
        var parts = email.Split('@');
        string name = parts[0];
        string maskedName = name.Length <= 2 ? name[0] + "***" : name.Substring(0, 2) + "*****";
        return maskedName + "@" + parts[1];
    };

    Func<string, string> maskPhone = phone =>
    {
        if (isAdmin || string.IsNullOrEmpty(phone)) return phone;
        if (phone.Length < 6) return "*****";
        return phone.Substring(0, 3) + "****" + phone.Substring(phone.Length - 3);
    };

    string custDisplayName = !string.IsNullOrEmpty(customer?.FullName) ? customer.FullName : maskEmail(customer?.UserName);

    ViewData["Title"] = "Lịch Sử Đơn Hàng Khách Hàng";
    ViewData["Subtitle"] = "Chi tiết tất cả đơn hàng của " + custDisplayName;
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";

    string statusFilter = ViewBag.StatusFilter as string ?? "all";
    int totalCount = ViewBag.TotalCount != null ? (int)ViewBag.TotalCount : 0;
    int processingCount = ViewBag.ProcessingCount != null ? (int)ViewBag.ProcessingCount : 0;
    int completedCount = ViewBag.CompletedCount != null ? (int)ViewBag.CompletedCount : 0;
    int cancelledCount = ViewBag.CancelledCount != null ? (int)ViewBag.CancelledCount : 0;
    int userPoints = customer != null ? customer.LoyaltyPoints : 0;
}

@section Styles {
    <style>
        /* ===== ADMIN DARK THEME - CUSTOMER ORDER HISTORY ===== */
        .history-card {
            background: linear-gradient(135deg, var(--adm-surface-2) 0%, #161B22 100%);
            border: 1px solid var(--adm-border);
            border-radius: 16px;
            padding: 24px;
            margin-bottom: 24px;
            position: relative;
            overflow: hidden;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
        }

        .history-card::after {
            content: '';
            position: absolute;
            top: -50%;
            right: -10%;
            width: 320px;
            height: 320px;
            background: radial-gradient(circle, rgba(240, 180, 41, 0.12) 0%, transparent 70%);
            border-radius: 50%;
            pointer-events: none;
        }

        .user-avatar-circle {
            width: 64px;
            height: 64px;
            background: var(--adm-surface-3);
            border: 2px solid var(--adm-gold);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 26px;
            color: var(--adm-gold);
            box-shadow: 0 0 15px rgba(240, 180, 41, 0.2);
        }

        /* Filter Tabs Dark */
        .adm-tabs-bar {
            display: inline-flex;
            flex-wrap: wrap;
            gap: 10px;
            background: var(--adm-surface);
            border: 1px solid var(--adm-border);
            padding: 8px;
            border-radius: 14px;
            margin-bottom: 24px;
        }

        .adm-tab-item {
            padding: 9px 18px;
            border-radius: 10px;
            font-weight: 700;
            font-size: 13.5px;
            color: var(--adm-text-2);
            background: transparent;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.2s ease;
            border: 1px solid transparent;
        }

        .adm-tab-item:hover {
            color: var(--adm-gold);
            background: var(--adm-surface-2);
        }

        .adm-tab-item.active {
            background: var(--adm-gold);
            color: #0D1117 !important;
            box-shadow: 0 2px 10px rgba(240, 180, 41, 0.3);
        }

        .tab-counter {
            background: rgba(255, 255, 255, 0.15);
            color: var(--adm-text);
            padding: 2px 8px;
            border-radius: 12px;
            font-size: 11.5px;
            font-weight: 800;
        }

        .adm-tab-item.active .tab-counter {
            background: #0D1117;
            color: var(--adm-gold);
        }

        /* Table Styling Dark Theme */
        .history-table-card {
            background: var(--adm-surface);
            border: 1px solid var(--adm-border);
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
        }

        .adm-hist-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
            color: var(--adm-text);
        }

        .adm-hist-table th {
            background: var(--adm-surface-2);
            color: var(--adm-text-2);
            font-weight: 700;
            text-transform: uppercase;
            font-size: 12px;
            letter-spacing: 0.5px;
            padding: 16px;
            border-bottom: 1px solid var(--adm-border);
        }

        .adm-hist-table td {
            padding: 16px;
            border-bottom: 1px solid rgba(48, 54, 61, 0.5);
            vertical-align: middle;
            font-size: 13.5px;
        }

        .adm-hist-table tbody tr.main-row:hover {
            background-color: rgba(255, 255, 255, 0.02);
        }

        .order-mono-id {
            font-family: 'JetBrains Mono', monospace;
            font-weight: 800;
            color: var(--adm-gold);
            font-size: 14px;
        }

        /* Expand Button */
        .btn-toggle-detail {
            border: 1px solid var(--adm-border-2);
            background: var(--adm-surface-2);
            color: var(--adm-text);
            border-radius: 8px;
            padding: 6px 14px;
            font-size: 12.5px;
            font-weight: 700;
            transition: all 0.2s ease;
        }

        .btn-toggle-detail:hover {
            background: var(--adm-gold);
            color: #0D1117;
            border-color: var(--adm-gold);
        }

        .btn-toggle-detail[aria-expanded="true"] .chevron-icon {
            transform: rotate(180deg);
        }

        .chevron-icon {
            transition: transform 0.3s ease;
        }

        /* Detail Area */
        .detail-row td {
            padding: 0 !important;
            border-bottom: none;
        }

        .detail-dark-card {
            background: #11151C;
            border-bottom: 2px solid var(--adm-border);
            padding: 20px;
        }

        .detail-inner-box {
            background: var(--adm-surface);
            border: 1px solid var(--adm-border);
            border-radius: 12px;
            overflow: hidden;
        }
    </style>
}

<div class="dash-page">

    <!-- PAGE HEADER BAR -->
    <div class="d-flex align-items-center justify-content-between mb-4 pb-3" style="border-bottom: 1px solid var(--adm-border);">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "ManageUser")" class="text-decoration-none text-muted"><i class="fa-solid fa-users me-1"></i> Quản lý người dùng</a></li>
                    <li class="breadcrumb-item active text-warning" aria-current="page">Lịch sử đơn hàng</li>
                </ol>
            </nav>
            <h3 class="mb-0 fw-bold text-white d-flex align-items-center gap-2">
                <i class="fa-solid fa-clock-rotate-left text-warning"></i> Lịch Sử Đơn Hàng Của Khách Khàng
            </h3>
        </div>
        <a href="@Url.Action("Index", "ManageUser")" class="btn btn-outline-secondary rounded-pill px-4 fw-bold">
            <i class="fa-solid fa-arrow-left me-2"></i> Quay lại danh sách
        </a>
    </div>

    <!-- THÔNG TIN KHÁCH HÀNG CARD -->
    <div class="history-card">
        <div class="row align-items-center g-4">
            <div class="col-md-7 d-flex align-items-center gap-4">
                <div class="user-avatar-circle">
                    <i class="fa-solid fa-user-check"></i>
                </div>
                <div style="z-index: 1;">
                    <h4 class="m-0 fw-bold text-white mb-1">@custDisplayName</h4>
                    <div class="small d-flex flex-wrap gap-3" style="color: var(--adm-text-2);">
                        <span><i class="fa-solid fa-envelope me-1 text-info"></i> @(string.IsNullOrEmpty(customer?.Email) ? "Chưa cập nhật" : maskEmail(customer.Email))</span>
                        <span><i class="fa-solid fa-phone me-1 text-danger"></i> @(string.IsNullOrEmpty(customer?.PhoneNumber) ? "Chưa cập nhật" : maskPhone(customer.PhoneNumber))</span>
                    </div>
                </div>
            </div>
            <div class="col-md-5 text-md-end border-start border-secondary border-opacity-25 ps-md-4" style="z-index: 1;">
                <div class="small text-uppercase tracking-wider mb-1" style="color: var(--adm-text-2); font-size: 11.5px;">Tích điểm & Hạng thành viên</div>
                <div class="d-flex align-items-center justify-content-md-end gap-3">
                    <div class="fs-4 fw-bold font-monospace d-flex align-items-center" style="color: var(--adm-gold);">
                        <i class="fa-solid fa-coins me-2"></i>@userPoints.ToString("N0") <span class="fs-6 ms-1 fw-normal text-muted">điểm</span>
                    </div>
                    <div>
                        @CustomerTierHelper.GetTierBadgeHtml(userPoints)
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- BỘ LỌC TABS STATUS -->
    <div class="adm-tabs-bar">
        <a href="@Url.Action("OrderHistory", "ManageUser", new { userId = customer?.Id, statusFilter = "all" })"
           class="adm-tab-item @(statusFilter == "all" ? "active" : "")">
            <i class="fa-solid fa-layer-group"></i> Tất cả đơn
            <span class="tab-counter">@totalCount</span>
        </a>

        <a href="@Url.Action("OrderHistory", "ManageUser", new { userId = customer?.Id, statusFilter = "processing" })"
           class="adm-tab-item @(statusFilter == "processing" ? "active" : "")">
            <i class="fa-solid fa-boxes-packing"></i> Đang xử lý
            <span class="tab-counter">@processingCount</span>
        </a>

        <a href="@Url.Action("OrderHistory", "ManageUser", new { userId = customer?.Id, statusFilter = "completed" })"
           class="adm-tab-item @(statusFilter == "completed" ? "active" : "")">
            <i class="fa-solid fa-check-double"></i> Đã hoàn tất
            <span class="tab-counter">@completedCount</span>
        </a>

        <a href="@Url.Action("OrderHistory", "ManageUser", new { userId = customer?.Id, statusFilter = "cancelled" })"
           class="adm-tab-item @(statusFilter == "cancelled" ? "active" : "")">
            <i class="fa-solid fa-ban"></i> Đã hủy
            <span class="tab-counter">@cancelledCount</span>
        </a>
    </div>

    <!-- BẢNG DANH SÁCH ĐƠN HÀNG -->
    <div class="history-table-card">
        <div class="table-responsive">
            <table class="adm-hist-table">
                <thead>
                    <tr>
                        <th class="ps-4" style="width: 110px;">Mã Đơn</th>
                        <th>Thời Gian Đặt</th>
                        <th style="width: 25%;">Địa Chỉ Giao</th>
                        <th>Thanh Toán</th>
                        <th>Trạng Thái</th>
                        <th class="text-end" style="width: 140px;">Tổng Tiền</th>
                        <th class="text-center" style="width: 120px;">Chi Tiết</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var order in Model)
                        {
                            string payMethodText = order.PaymentMethod == 0 ? "Tiền mặt (COD)" : (order.PaymentMethod == 2 ? "Ví MoMo" : "VietQR Ngân hàng");
                            int totalItems = order.OrderDetails != null ? order.OrderDetails.Sum(d => d.Quantity) : 0;

                            <tr class="main-row">
                                <td class="ps-4">
                                    <span class="order-mono-id">#@order.Id</span>
                                </td>
                                <td>
                                    <div class="fw-bold text-white">@order.OrderDate.ToString("dd/MM/yyyy")</div>
                                    <small class="text-muted"><i class="fa-regular fa-clock me-1"></i>@order.OrderDate.ToString("HH:mm")</small>
                                </td>
                                <td>
                                    <div class="fw-bold text-info mb-1"><i class="fa-regular fa-user me-1"></i>@order.ReceiverName</div>
                                    <div class="small text-danger fw-bold mb-1"><i class="fa-solid fa-phone me-1"></i>@maskPhone(order.ReceiverPhone)</div>
                                    <div class="small text-muted text-truncate" style="max-width: 240px;" title="@order.ShippingAddress">
                                        <i class="fa-solid fa-location-dot text-warning me-1"></i>@order.ShippingAddress
                                    </div>
                                </td>
                                <td>
                                    <div class="mb-1"><span class="badge bg-dark border border-secondary text-light">@payMethodText</span></div>
                                    <div>
                                        @if (order.PaymentStatus == 1)
                                        {
                                            <span class="badge bg-success"><i class="fa-solid fa-check me-1"></i>Đã thanh toán</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark"><i class="fa-solid fa-clock me-1"></i>Chưa thanh toán</span>
                                        }
                                    </div>
                                </td>
                                <td>
                                    @if (order.OrderStatus == 4)
                                    {
                                        <span class="badge bg-success fs-6"><i class="fa-solid fa-circle-check me-1"></i>Thành công</span>
                                    }
                                    else if (order.OrderStatus == 5)
                                    {
                                        <span class="badge bg-danger fs-6"><i class="fa-solid fa-xmark me-1"></i>Đã hủy</span>
                                    }
                                    else if (order.OrderStatus == 3)
                                    {
                                        <span class="badge bg-info text-dark fs-6"><i class="fa-solid fa-truck-fast me-1"></i>Đang giao</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark fs-6"><i class="fa-solid fa-boxes-packing me-1"></i>Đang xử lý</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="fw-bold font-monospace fs-6" style="color: var(--adm-gold);">@order.TotalAmount.ToString("N0") ₫</div>
                                    <small class="text-muted">@totalItems món</small>
                                </td>
                                <td class="text-center">
                                    <button type="button" class="btn-toggle-detail" data-bs-toggle="collapse" data-bs-target="#orderDetail_@order.Id" aria-expanded="false">
                                        Chi tiết <i class="fa-solid fa-chevron-down ms-1 chevron-icon"></i>
                                    </button>
                                </td>
                            </tr>

                            <!-- COLLAPSE CHI TIẾT SẢN PHẨM -->
                            <tr class="detail-row">
                                <td colspan="7">
                                    <div id="orderDetail_@order.Id" class="collapse">
                                        <div class="detail-dark-card">
                                            <div class="detail-inner-box">
                                                <div class="p-3 border-bottom border-secondary d-flex align-items-center justify-content-between" style="background: var(--adm-surface-2);">
                                                    <h6 class="m-0 fw-bold text-warning d-flex align-items-center gap-2">
                                                        <i class="fa-solid fa-basket-shopping"></i> Danh Sách Sản Phẩm - Đơn <span class="font-monospace">#@order.Id</span>
                                                    </h6>
                                                    <span class="text-muted small">Thời gian: @order.OrderDate.ToString("dd/MM/yyyy HH:mm")</span>
                                                </div>

                                                @if (order.OrderDetails != null && order.OrderDetails.Any())
                                                {
                                                    <div class="table-responsive">
                                                        <table class="table table-dark table-hover align-middle m-0">
                                                            <thead>
                                                                <tr class="table-secondary text-white">
                                                                    <th class="ps-4">Tên Sản Phẩm</th>
                                                                    <th class="text-center" style="width: 120px;">Số Lượng</th>
                                                                    <th class="text-end" style="width: 150px;">Đơn Giá</th>
                                                                    <th class="text-end pe-4" style="width: 180px;">Thành Tiền</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                @foreach (var detail in order.OrderDetails)
                                                                {
                                                                    string pName = detail.Product != null ? detail.Product.Name : "Sản phẩm";
                                                                    double total = detail.Price * detail.Quantity;

                                                                    <tr>
                                                                        <td class="ps-4 fw-bold text-white">@pName</td>
                                                                        <td class="text-center font-monospace">
                                                                            <span class="badge bg-secondary">x @detail.Quantity</span>
                                                                        </td>
                                                                        <td class="text-end font-monospace text-warning">@detail.Price.ToString("N0") ₫</td>
                                                                        <td class="text-end pe-4 font-monospace fw-bold text-emerald">@total.ToString("N0") ₫</td>
                                                                    </tr>
                                                                }
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="p-4 text-center text-muted">
                                                        <i class="fa-regular fa-folder-open fs-3 mb-2 opacity-50 text-warning"></i>
                                                        <p class="m-0">Không có dữ liệu chi tiết cho đơn hàng này.</p>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="py-5 text-center">
                                <i class="fa-solid fa-receipt fs-1 text-muted opacity-50 mb-3 d-block"></i>
                                <h5 class="text-white fw-bold">Không Tìm Thấy Đơn Hàng</h5>
                                <p class="text-muted mb-0">Khách hàng chưa phát sinh đơn hàng nào thuộc trạng thái này.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
        var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl)
        })
    </script>
}