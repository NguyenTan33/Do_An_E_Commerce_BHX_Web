@model IEnumerable<Do_An_E_Commerce_BHX.Models.Entities.Order>

@{
    ViewData["Title"] = "Lịch sử đơn hàng";
    ViewData["Subtitle"] = "Tra cứu nâng cao lịch sử đơn hàng, doanh thu và thông tin nhân viên xử lý";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";

    string search = ViewBag.Search as string ?? "";
    int? status = ViewBag.Status as int?;
    decimal? minPrice = ViewBag.MinPrice as decimal?;
    decimal? maxPrice = ViewBag.MaxPrice as decimal?;
    string fromDate = ViewBag.FromDate as string ?? "";
    string toDate = ViewBag.ToDate as string ?? "";

    double totalSuccessRevenue = ViewBag.TotalSuccessRevenue != null ? (double)ViewBag.TotalSuccessRevenue : 0;
    int totalHistoryCount = ViewBag.TotalHistoryCount != null ? (int)ViewBag.TotalHistoryCount : 0;
    int countSuccess = ViewBag.CountSuccess != null ? (int)ViewBag.CountSuccess : 0;
    int countFailed = ViewBag.CountFailed != null ? (int)ViewBag.CountFailed : 0;
}

<div class="dash-page">

    <!-- ===== PAGE HEADER (ĐÃ FIX RỚT DÒNG TRÊN MOBILE) ===== -->
    <div class="d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between mb-4 pb-3 gap-3" style="border-bottom: 1px solid var(--adm-border);">
        <div>
            <h3 class="mb-1" style="font-size: 20px; font-weight: 700; color: var(--adm-text); display: flex; align-items: center; gap: 10px;">
                <i class="fa-solid fa-clock-rotate-left text-primary"></i> Lịch Sử Đơn Hàng
            </h3>
            <p class="mb-0" style="font-size: 13.5px; color: var(--adm-text-2);">Tra cứu nâng cao tất cả các đơn hàng, theo dõi vết nhân viên soạn & giao hàng</p>
        </div>

        <div class="d-flex flex-wrap gap-2 w-100 w-md-auto">
            <a href="@Url.Action("Index", "ManageOrder")" class="btn btn-outline-secondary flex-fill flex-md-grow-0">
                <i class="fa-solid fa-boxes-packing me-1"></i> Quản lý đơn
            </a>
            <a href="@Url.Action("PackingList", "ManageOrder")" class="btn btn-warning text-dark fw-bold flex-fill flex-md-grow-0">
                <i class="fa-solid fa-box-open me-1"></i> Soạn hàng
            </a>
            <a href="@Url.Action("DeliveryList", "ManageOrder")" class="btn btn-info text-dark fw-bold flex-fill flex-md-grow-0">
                <i class="fa-solid fa-truck-fast me-1"></i> Giao hàng
            </a>
        </div>
    </div>

    <!-- ===== 4 KPI WIDGETS (FIX HOÀN TOÀN BỂ FORM/RỚT DÒNG) ===== -->
    <div class="row g-3 mb-4">
        <!-- KPI 1: Tổng đơn -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="adm-kpi-card h-100" style="--kpi-accent: var(--adm-blue);">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="adm-kpi-label">Tổng Đơn Hàng</div>
                        <div class="adm-kpi-value">
                            @totalHistoryCount <span style="font-size: 14px; color: var(--adm-text-2); font-weight: 500;">đơn</span>
                        </div>
                    </div>
                    <div class="adm-kpi-icon" style="background: var(--adm-blue-dim); color: var(--adm-blue);">
                        <i class="fa-solid fa-receipt"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- KPI 2: Doanh thu thành công -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="adm-kpi-card h-100" style="--kpi-accent: var(--adm-gold);">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="adm-kpi-label">Doanh Thu (Thành công)</div>
                        <div class="adm-kpi-value" style="color: var(--adm-gold);">
                            @totalSuccessRevenue.ToString("N0") <span style="font-size: 14px; color: var(--adm-text-2); font-weight: 500;">₫</span>
                        </div>
                    </div>
                    <div class="adm-kpi-icon" style="background: var(--adm-gold-dim); color: var(--adm-gold);">
                        <i class="fa-solid fa-sack-dollar"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- KPI 3: Giao thành công -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="adm-kpi-card h-100" style="--kpi-accent: var(--adm-emerald);">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="adm-kpi-label">Giao Thành Công</div>
                        <div class="adm-kpi-value" style="color: var(--adm-emerald);">
                            @countSuccess <span style="font-size: 14px; color: var(--adm-text-2); font-weight: 500;">đơn</span>
                        </div>
                    </div>
                    <div class="adm-kpi-icon" style="background: var(--adm-emerald-dim); color: var(--adm-emerald);">
                        <i class="fa-solid fa-circle-check"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- KPI 4: Thất bại / Hủy -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="adm-kpi-card h-100" style="--kpi-accent: var(--adm-red);">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="adm-kpi-label">Thất Bại / Đã Hủy</div>
                        <div class="adm-kpi-value" style="color: var(--adm-red);">
                            @countFailed <span style="font-size: 14px; color: var(--adm-text-2); font-weight: 500;">đơn</span>
                        </div>
                    </div>
                    <div class="adm-kpi-icon" style="background: var(--adm-red-dim); color: var(--adm-red);">
                        <i class="fa-solid fa-ban"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ===== BỘ LỌC TÌM KIẾM NÂNG CAO ===== -->
    <div class="adm-filter-bar mb-4">
        <h5 class="mb-3" style="font-size: 14px; font-weight: 700; color: var(--adm-text); display: flex; align-items: center; gap: 8px;">
            <i class="fa-solid fa-filter text-primary"></i> Bộ Lọc & Tìm Kiếm Nâng Cao
        </h5>
        <form method="get" action="@Url.Action("History", "ManageOrder")">
            <div class="row g-3">
                <div class="col-12 col-md-7">
                    <label class="form-label">Từ khóa (Mã đơn, SĐT, Tên)</label>
                    <input type="text" name="search" class="form-control" placeholder="VD: #15, 0901234567..." value="@search" />
                </div>
                <div class="col-12 col-md-5">
                    <label class="form-label">Trạng thái đơn hàng</label>
                    <select name="status" class="form-select">
                        <option value="">-- Tất cả trạng thái --</option>
                        <option value="0" @(status == 0 ? "selected" : "")>0. Chờ duyệt</option>
                        <option value="1" @(status == 1 ? "selected" : "")>1. Đã duyệt (Chờ soạn)</option>
                        <option value="2" @(status == 2 ? "selected" : "")>2. Đã soạn xong (Chờ giao)</option>
                        <option value="3" @(status == 3 ? "selected" : "")>3. Đang giao hàng</option>
                        <option value="4" @(status == 4 ? "selected" : "")>4. Giao thành công (Hoàn tất)</option>
                        <option value="5" @(status == 5 ? "selected" : "")>5. Đã hủy / Giao thất bại</option>
                    </select>
                </div>

                <div class="col-12 col-md-3">
                    <label class="form-label">Giá từ (VNĐ)</label>
                    <input type="number" name="minPrice" class="form-control" placeholder="Tối thiểu..." value="@minPrice" />
                </div>
                <div class="col-12 col-md-3">
                    <label class="form-label">Giá đến (VNĐ)</label>
                    <input type="number" name="maxPrice" class="form-control" placeholder="Tối đa..." value="@maxPrice" />
                </div>
                <div class="col-12 col-md-3">
                    <label class="form-label">Từ ngày</label>
                    <input type="date" name="fromDate" class="form-control" value="@fromDate" />
                </div>
                <div class="col-12 col-md-3">
                    <label class="form-label">Đến ngày</label>
                    <input type="date" name="toDate" class="form-control" value="@toDate" />
                </div>
            </div>

            <div class="d-flex justify-content-end align-items-center gap-2 mt-4 pt-3" style="border-top: 1px solid var(--adm-border);">
                <a href="@Url.Action("History", "ManageOrder")" class="btn btn-outline-secondary">
                    <i class="fa-solid fa-rotate-left me-1"></i> Xóa bộ lọc
                </a>
                <button type="submit" class="btn btn-primary">
                    <i class="fa-solid fa-filter me-1"></i> LỌC KẾT QUẢ
                </button>
            </div>
        </form>
    </div>

    <!-- ===== BẢNG LỊCH SỬ ĐƠN HÀNG ===== -->
    <div class="adm-table-wrap mb-5">
        <div class="adm-table-header">
            <h5 class="adm-table-title m-0">
                <i class="fa-solid fa-list-ul"></i>
                Danh Sách Lịch Sử Đơn Hàng (@(Model?.Count() ?? 0))
            </h5>
        </div>
        <div class="adm-table-responsive">
            <table class="table mb-0">
                <thead>
                    <tr>
                        <th class="ps-4" style="width: 90px;">Mã Đơn</th>
                        <th>Ngày Đặt</th>
                        <th>Khách Hàng & SĐT</th>
                        <th>Địa Chỉ Nhận Hàng</th>
                        <th>Thanh Toán</th>
                        <th class="text-end">Tổng Tiền</th>
                        <th class="text-center">Trạng Thái</th>
                        <th class="text-end pe-4" style="width: 120px;">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            string paymentText = item.PaymentMethod == 1 ? "Ngân hàng" : (item.PaymentMethod == 2 ? "MoMo" : "COD");

                            <tr>
                                <td class="ps-4">
                                    <span style="font-family: 'JetBrains Mono', monospace; font-size: 13.5px; color: var(--adm-gold); font-weight: 700;">#@item.Id</span>
                                </td>
                                <td>
                                    <div style="font-weight: 600; color: var(--adm-text);">@item.OrderDate.ToString("dd/MM/yyyy")</div>
                                    <div style="font-size: 12px; color: var(--adm-text-3);"><i class="fa-regular fa-clock me-1"></i>@item.OrderDate.ToString("HH:mm")</div>
                                </td>
                                <td>
                                    <div style="font-weight: 600; color: var(--adm-blue);"><i class="fa-regular fa-circle-user me-1"></i>@item.ReceiverName</div>
                                    <div style="font-size: 12.5px; color: var(--adm-red); font-weight: 600;" class="my-1"><i class="fa-solid fa-phone me-1"></i>@item.ReceiverPhone</div>
                                </td>
                                <td>
                                    <div style="font-size: 12px; color: var(--adm-text-2); max-width: 250px;" class="text-truncate" title="@item.ShippingAddress">
                                        <i class="fa-solid fa-location-dot me-1"></i>@item.ShippingAddress
                                    </div>
                                </td>
                                <td>
                                    <div class="mb-1">
                                        <span class="badge bg-secondary">@paymentText</span>
                                    </div>
                                    @if (item.PaymentStatus == 1)
                                    {
                                        <span class="badge bg-success"><i class="fa-solid fa-check me-1"></i>Đã TT</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-dark border border-secondary text-muted"><i class="fa-regular fa-hourglass-half me-1"></i>Chưa TT</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <span style="font-family: 'JetBrains Mono', monospace; font-weight: 700; color: var(--adm-gold); font-size: 14.5px;">
                                        @item.TotalAmount.ToString("N0") ₫
                                    </span>
                                </td>
                                <td class="text-center">
                                    @switch (item.OrderStatus)
                                    {
                                        case 0:<span class="badge bg-warning text-dark">Chờ duyệt</span> break;
                                        case 1:<span class="badge bg-primary">Đã duyệt</span> break;
                                        case 2:<span class="badge bg-info text-dark">Đã soạn xong</span> break;
                                        case 3:<span class="badge bg-purple" style="background:#6f42c1; color:#fff;">Đang giao</span> break;
                                        case 4:<span class="badge bg-success">Thành công</span> break;
                                        case 5:<span class="badge bg-danger">Thất bại / Hủy</span>break;
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <button type="button" class="btn btn-sm btn-outline-info btn-view-detail fw-bold" data-id="@item.Id">
                                        <i class="fa-solid fa-eye me-1"></i> Chi tiết
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="adm-empty">
                                <i class="fa-solid fa-receipt"></i>
                                <h5>Trống</h5>
                                <p>Không tìm thấy đơn hàng nào phù hợp với bộ lọc.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ============ MODAL XEM CHI TIẾT ĐƠN HÀNG ============ -->
<div class="modal fade" id="orderDetailModal" tabindex="-1" aria-labelledby="orderDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header">
                <h5 class="modal-title" id="orderDetailModalLabel" style="color: var(--adm-text); font-weight: 700; font-size: 16px;">
                    <i class="fa-solid fa-receipt text-primary me-2"></i>Chi Tiết Đơn Hàng <span id="md-order-id" style="color: var(--adm-gold);"></span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">

                <!-- THÔNG TIN KHÁCH HÀNG & THỜI GIAN -->
                <div class="p-3 rounded mb-3" style="background: var(--adm-surface-2); border: 1px solid var(--adm-border);">
                    <div class="row g-3">
                        <div class="col-md-6 border-end border-secondary">
                            <span style="font-size: 11px; font-weight: 700; text-transform: uppercase; color: var(--adm-text-2);">Khách hàng</span>
                            <div class="fw-bold fs-6 mt-1" id="md-receiver-name" style="color: var(--adm-text);"></div>
                            <div class="fw-bold small mt-1" id="md-receiver-phone" style="color: var(--adm-red);"></div>
                        </div>
                        <div class="col-md-6 text-md-end">
                            <span style="font-size: 11px; font-weight: 700; text-transform: uppercase; color: var(--adm-text-2);">Thời gian đặt</span>
                            <div class="fw-bold mt-1" id="md-order-date" style="color: var(--adm-text);"></div>
                        </div>
                        <div class="col-12 mt-2 pt-2 border-top border-secondary">
                            <span style="font-size: 11px; font-weight: 700; text-transform: uppercase; color: var(--adm-text-2);">Địa chỉ giao hàng</span>
                            <div class="fw-bold mt-1" style="color: var(--adm-text);"><i class="fa-solid fa-location-dot me-2 text-danger"></i><span id="md-shipping-address"></span></div>
                        </div>
                    </div>
                </div>

                <!-- THÔNG TIN STAFF AUDIT TRAIL -->
                <div class="p-3 mb-3 rounded" style="background: rgba(88, 166, 255, 0.1); border: 1px solid var(--adm-blue);">
                    <h6 class="fw-bold mb-2" style="color: var(--adm-blue);"><i class="fa-solid fa-user-gear me-2"></i>Vết Nhân Viên Xử Lý Đơn Hàng:</h6>
                    <div class="row g-2 ms-1">
                        <div class="col-md-6">
                            <span style="font-size: 12px; color: var(--adm-text-2);" class="d-block">📦 Nhân viên soạn đơn:</span>
                            <strong style="color: var(--adm-gold); font-size: 14px;" id="md-packed-by"></strong>
                        </div>
                        <div class="col-md-6">
                            <span style="font-size: 12px; color: var(--adm-text-2);" class="d-block">🚚 Nhân viên/Shipper giao hàng:</span>
                            <strong style="color: var(--adm-emerald); font-size: 14px;" id="md-delivered-by"></strong>
                        </div>
                    </div>
                </div>

                <!-- BẢNG DANH SÁCH MẶT HÀNG -->
                <h6 class="fw-bold mb-2 mt-4" style="color: var(--adm-text);"><i class="fa-solid fa-basket-shopping text-warning me-2"></i>Sản Phẩm Đã Mua</h6>
                <div class="adm-table-wrap mb-3">
                    <div class="adm-table-responsive">
                        <table class="table mb-0 align-middle">
                            <thead>
                                <tr>
                                    <th style="width: 70px;" class="text-center">Ảnh</th>
                                    <th>Sản Phẩm</th>
                                    <th class="text-center">SL</th>
                                    <th class="text-end">Đơn Giá</th>
                                    <th class="text-end pe-3">Thành Tiền</th>
                                </tr>
                            </thead>
                            <tbody id="md-items-tbody">
                                <!-- Ajax -->
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- TỔNG TIỀN -->
                <div class="d-flex justify-content-between align-items-center p-3 rounded" style="background: var(--adm-surface-2); border: 1px solid var(--adm-border);">
                    <span style="font-weight: 700; color: var(--adm-text-2); text-transform: uppercase;">Tổng Thanh Toán</span>
                    <span style="font-family: 'JetBrains Mono', monospace; font-weight: 800; font-size: 20px; color: var(--adm-gold);" id="md-total-amount"></span>
                </div>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
            var detailModal = bootstrap.Modal.getOrCreateInstance(document.getElementById('orderDetailModal'));

            $('.btn-view-detail').on('click', function () {
                var orderId = $(this).data('id');
                var btn = $(this);
                var originalHtml = btn.html();
                btn.prop('disabled', true).html('<i class="fa-solid fa-spinner fa-spin"></i>');

                $.ajax({
                    url: '@Url.Action("GetOrderDetailJson", "ManageOrder")',
                    type: 'GET',
                    data: { id: orderId },
                    success: function (res) {
                        btn.prop('disabled', false).html(originalHtml);

                        if (res.success && res.data) {
                            var d = res.data;
                            $('#md-order-id').text('#' + d.id);
                            $('#md-receiver-name').html('<i class="fa-regular fa-circle-user me-2 text-primary"></i>' + d.receiverName);
                            $('#md-receiver-phone').html('<i class="fa-solid fa-phone me-2"></i>' + d.receiverPhone);
                            $('#md-order-date').html('<i class="fa-regular fa-clock me-1"></i> ' + d.orderDate);
                            $('#md-shipping-address').text(d.shippingAddress);
                            $('#md-total-amount').text(d.totalAmount.toLocaleString('vi-VN') + ' ₫');

                            $('#md-packed-by').text(d.packedBy || 'Chưa thực hiện soạn đơn');
                            $('#md-delivered-by').text(d.deliveredBy || 'Chưa thực hiện giao hàng');

                            var tbody = $('#md-items-tbody');
                            tbody.empty();

                            if (d.items && d.items.length > 0) {
                                $.each(d.items, function (i, item) {
                                    var imgUrl = item.image ? item.image : '/Content/images/no-image.png';
                                    var row = '<tr>' +
                                        '<td class="text-center py-2"><img src="' + imgUrl + '" style="width: 40px; height: 40px; object-fit: cover; border-radius: 4px; border: 1px solid var(--adm-border);" /></td>' +
                                        '<td><div style="font-weight: 600; color: var(--adm-text);">' + item.productName + '</div><div style="font-size: 12px; color: var(--adm-text-3);">Barcode: <span class="badge bg-secondary">' + (item.barcode || 'N/A') + '</span></div></td>' +
                                        '<td class="text-center"><span class="badge bg-danger">x' + item.quantity + '</span></td>' +
                                        '<td class="text-end" style="font-family: \'JetBrains Mono\', monospace; color: var(--adm-text-2);">' + item.price.toLocaleString('vi-VN') + ' ₫</td>' +
                                        '<td class="text-end pe-3" style="font-family: \'JetBrains Mono\', monospace; font-weight: 700; color: var(--adm-gold);">' + item.total.toLocaleString('vi-VN') + ' ₫</td>' +
                                        '</tr>';
                                    tbody.append(row);
                                });
                            }
                            detailModal.show();
                        } else {
                            alert(res.message || "Không nạp được thông tin chi tiết đơn!");
                        }
                    },
                    error: function (xhr, status, err) {
                        btn.prop('disabled', false).html(originalHtml);
                        alert("Lỗi khi tải chi tiết đơn hàng: " + (xhr.responseText || err));
                    }
                });
            });
        });
    </script>
}