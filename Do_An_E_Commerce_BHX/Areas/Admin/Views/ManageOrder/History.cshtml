@model IEnumerable<Do_An_E_Commerce_BHX.Models.Entities.Order>

@{
    ViewData["Title"] = "Lịch sử đơn hàng";
    ViewData["Subtitle"] = "Tra cứu nâng cao lịch sử đơn hàng, doanh thu và thông tin nhân viên xử lý";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";

    string search = ViewBag.Search as string ?? "";
    int? status = ViewBag.Status as int?;
    decimal? minPrice = ViewBag.MinPrice as decimal?;
    decimal? maxPrice = ViewBag.MaxPrice as decimal?;
    string fromDate = ViewBag.FromDate as string ?? "";
    string toDate = ViewBag.ToDate as string ?? "";

    double totalSuccessRevenue = ViewBag.TotalSuccessRevenue != null ? (double)ViewBag.TotalSuccessRevenue : 0;
    int totalHistoryCount = ViewBag.TotalHistoryCount != null ? (int)ViewBag.TotalHistoryCount : 0;
    int countSuccess = ViewBag.CountSuccess != null ? (int)ViewBag.CountSuccess : 0;
    int countFailed = ViewBag.CountFailed != null ? (int)ViewBag.CountFailed : 0;
}

<!-- IMPORT THƯ VIỆN ĐỂ KHÔNG BỊ BỂ GIAO DIỆN -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

<style>
    /* ===== CUSTOM CSS CHO ADMIN ĐỒNG BỘ ===== */
    .admin-card {
        border-radius: 12px;
        border: none;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        background-color: #fff;
    }

    .btn-custom {
        border-radius: 8px;
        transition: all 0.2s ease-in-out;
    }

        .btn-custom:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 10px rgba(0,0,0,0.15);
        }

    /* Bảng dữ liệu */
    .table-custom th {
        background-color: #f4f6f9;
        color: #495057;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border-bottom: 2px solid #e2e8f0;
        padding: 16px 12px;
    }

    .table-custom td {
        vertical-align: middle;
        padding: 16px 12px;
        border-bottom: 1px solid #f1f3f5;
        transition: background-color 0.2s;
    }

    .table-custom tbody tr:hover {
        background-color: #f8f9fa;
    }

    /* Badges Trạng thái (Soft UI) */
    .status-badge {
        padding: 6px 12px;
        border-radius: 6px;
        font-weight: 600;
        font-size: 0.85rem;
        display: inline-block;
        border: 1px solid transparent;
    }

    .status-pending {
        background-color: #fff3cd;
        color: #856404;
        border-color: #ffeeba;
    }

    .status-approved {
        background-color: #cce5ff;
        color: #004085;
        border-color: #b8daff;
    }

    .status-packed {
        background-color: #d1ecf1;
        color: #0c5460;
        border-color: #bee5eb;
    }

    .status-delivering {
        background-color: #f3e8fc;
        color: #5a32a3;
        border-color: #dcbdf5;
    }

    .status-success {
        background-color: #d4edda;
        color: #155724;
        border-color: #c3e6cb;
    }

    .status-failed {
        background-color: #f8d7da;
        color: #721c24;
        border-color: #f5c6cb;
    }

    /* Widgets Thống kê hiện đại */
    .widget-card {
        transition: all 0.3s;
    }

        .widget-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 20px rgba(0,0,0,0.08);
        }

    .icon-box {
        width: 50px;
        height: 50px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
    }
</style>

<div class="container-fluid py-3">
    <!-- TOP HEADER -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h3 class="fw-bold text-dark m-0"><i class="fa-solid fa-clock-rotate-left text-primary me-2"></i>Lịch Sử Đơn Hàng</h3>
            <p class="text-muted mb-0 mt-1 fs-6">Tra cứu nâng cao tất cả các đơn hàng, theo dõi vết nhân viên soạn & giao hàng</p>
        </div>

        <div class="d-flex gap-2">
            <a href="@Url.Action("Index", "ManageOrder")" class="btn btn-outline-secondary btn-custom fw-bold">
                <i class="fa-solid fa-boxes-packing me-1"></i> Quản lý đơn
            </a>
            <a href="@Url.Action("PackingList", "ManageOrder")" class="btn btn-outline-warning text-dark btn-custom fw-bold">
                <i class="fa-solid fa-box-open me-1"></i> Soạn hàng
            </a>
            <a href="@Url.Action("DeliveryList", "ManageOrder")" class="btn btn-outline-info btn-custom fw-bold">
                <i class="fa-solid fa-truck-fast me-1"></i> Giao hàng
            </a>
        </div>
    </div>

    <!-- 4 WIDGETS THỐNG KÊ DOANH THU (Style Dashboard Hiện Đại) -->
    <div class="row g-3 mb-4">
        <!-- Tổng đơn -->
        <div class="col-md-3">
            <div class="card admin-card widget-card border-start border-primary border-4">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="small text-muted text-uppercase fw-bold letter-spacing-1">Tổng Đơn Hàng</div>
                            <h3 class="fw-bold text-dark m-0 mt-2">@totalHistoryCount</h3>
                        </div>
                        <div class="icon-box bg-primary bg-opacity-10">
                            <i class="fa-solid fa-receipt fs-4 text-primary"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Doanh thu thành công -->
        <div class="col-md-3">
            <div class="card admin-card widget-card border-start border-success border-4">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="small text-muted text-uppercase fw-bold letter-spacing-1">Doanh Thu (Thành công)</div>
                            <h3 class="fw-bold text-dark m-0 mt-2">@totalSuccessRevenue.ToString("N0") <span class="fs-6">đ</span></h3>
                        </div>
                        <div class="icon-box bg-success bg-opacity-10">
                            <i class="fa-solid fa-sack-dollar fs-4 text-success"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Giao thành công -->
        <div class="col-md-3">
            <div class="card admin-card widget-card border-start border-info border-4">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="small text-muted text-uppercase fw-bold letter-spacing-1">Giao Thành Công</div>
                            <h3 class="fw-bold text-dark m-0 mt-2">@countSuccess</h3>
                        </div>
                        <div class="icon-box bg-info bg-opacity-10">
                            <i class="fa-solid fa-circle-check fs-4 text-info"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Thất bại / Hủy -->
        <div class="col-md-3">
            <div class="card admin-card widget-card border-start border-danger border-4">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="small text-muted text-uppercase fw-bold letter-spacing-1">Thất Bại / Đã Hủy</div>
                            <h3 class="fw-bold text-dark m-0 mt-2">@countFailed</h3>
                        </div>
                        <div class="icon-box bg-danger bg-opacity-10">
                            <i class="fa-solid fa-ban fs-4 text-danger"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- KHUNG TÌM KIẾM NÂNG CAO ĐA TIÊU CHÍ -->
    <div class="card admin-card mb-4 border border-light">
        <div class="card-header bg-white border-bottom py-3">
            <h5 class="m-0 fw-bold text-dark"><i class="fa-solid fa-filter text-primary me-2"></i>Bộ Lọc & Tìm Kiếm Nâng Cao</h5>
        </div>
        <div class="card-body p-4">
            <form method="get" action="@Url.Action("History", "ManageOrder")">
                <div class="row g-3">
                    <!-- Hàng 1 -->
                    <div class="col-md-7">
                        <label class="form-label fw-bold text-secondary small text-uppercase"><i class="fa-solid fa-magnifying-glass me-1"></i>Từ khóa (Mã đơn, SĐT, Tên)</label>
                        <input type="text" name="search" class="form-control" placeholder="VD: #15, 0901234567..." value="@search" />
                    </div>
                    <div class="col-md-5">
                        <label class="form-label fw-bold text-secondary small text-uppercase"><i class="fa-solid fa-list-check me-1"></i>Trạng thái đơn hàng</label>
                        <select name="status" class="form-select">
                            <option value="">-- Tất cả trạng thái --</option>
                            <option value="0" @(status == 0 ? "selected" : "")>0. Chờ duyệt</option>
                            <option value="1" @(status == 1 ? "selected" : "")>1. Đã duyệt (Chờ soạn)</option>
                            <option value="2" @(status == 2 ? "selected" : "")>2. Đã soạn xong (Chờ giao)</option>
                            <option value="3" @(status == 3 ? "selected" : "")>3. Đang giao hàng</option>
                            <option value="4" @(status == 4 ? "selected" : "")>4. Giao thành công (Hoàn tất)</option>
                            <option value="5" @(status == 5 ? "selected" : "")>5. Đã hủy / Giao thất bại</option>
                        </select>
                    </div>

                    <!-- Hàng 2 -->
                    <div class="col-md-3">
                        <label class="form-label fw-bold text-secondary small text-uppercase"><i class="fa-solid fa-dollar-sign me-1"></i>Giá từ (VNĐ)</label>
                        <input type="number" name="minPrice" class="form-control" placeholder="Tối thiểu..." value="@minPrice" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold text-secondary small text-uppercase"><i class="fa-solid fa-dollar-sign me-1"></i>Giá đến (VNĐ)</label>
                        <input type="number" name="maxPrice" class="form-control" placeholder="Tối đa..." value="@maxPrice" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold text-secondary small text-uppercase"><i class="fa-solid fa-calendar-day me-1"></i>Từ ngày</label>
                        <input type="date" name="fromDate" class="form-control" value="@fromDate" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold text-secondary small text-uppercase"><i class="fa-solid fa-calendar-day me-1"></i>Đến ngày</label>
                        <input type="date" name="toDate" class="form-control" value="@toDate" />
                    </div>

                    <!-- Nút hành động -->
                    <div class="col-12 mt-4 d-flex gap-2 justify-content-end">
                        <a href="@Url.Action("History", "ManageOrder")" class="btn btn-outline-secondary btn-custom px-4 fw-bold">
                            <i class="fa-solid fa-rotate-left me-1"></i> Xóa bộ lọc
                        </a>
                        <button type="submit" class="btn btn-primary btn-custom px-5 fw-bold shadow-sm">
                            <i class="fa-solid fa-filter me-1"></i> LỌC KẾT QUẢ
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- BẢNG DANH SÁCH LỊCH SỬ ĐƠN HÀNG -->
    <div class="card admin-card border border-light overflow-hidden mb-5">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-custom mb-0">
                    <thead>
                        <tr>
                            <th class="ps-4" style="width: 90px;">Mã Đơn</th>
                            <th>Ngày Đặt</th>
                            <th>Khách Hàng & SĐT</th>
                            <th>Địa Chỉ Nhận Hàng</th>
                            <th>Thanh Toán</th>
                            <th class="text-end">Tổng Tiền</th>
                            <th class="text-center">Trạng Thái</th>
                            <th class="text-center" style="width: 140px;">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                string statusBadgeClass = "status-all";
                                string statusText = "Không xác định";

                                switch (item.OrderStatus)
                                {
                                    case 0:
                                        statusBadgeClass = "status-pending";
                                        statusText = "Chờ duyệt";
                                        break;
                                    case 1:
                                        statusBadgeClass = "status-approved";
                                        statusText = "Đã duyệt";
                                        break;
                                    case 2:
                                        statusBadgeClass = "status-packed";
                                        statusText = "Đã soạn xong";
                                        break;
                                    case 3:
                                        statusBadgeClass = "status-delivering";
                                        statusText = "Đang giao";
                                        break;
                                    case 4:
                                        statusBadgeClass = "status-success";
                                        statusText = "Thành công";
                                        break;
                                    case 5:
                                        statusBadgeClass = "status-failed";
                                        statusText = "Thất bại / Hủy";
                                        break;
                                }

                                string paymentText = item.PaymentMethod == 1 ? "Ngân hàng" : (item.PaymentMethod == 2 ? "MoMo" : "COD");

                                <tr>
                                    <td class="ps-4">
                                        <span class="badge bg-light text-primary border px-2 py-1 fs-6">#@item.Id</span>
                                    </td>
                                    <td>
                                        <div class="fw-bold text-dark">@item.OrderDate.ToString("dd/MM/yyyy")</div>
                                        <div class="text-muted small"><i class="fa-regular fa-clock me-1"></i>@item.OrderDate.ToString("HH:mm")</div>
                                    </td>
                                    <td>
                                        <div class="fw-bold text-dark"><i class="fa-regular fa-circle-user me-1 text-secondary"></i>@item.ReceiverName</div>
                                        <div class="text-danger fw-bold small my-1"><i class="fa-solid fa-phone me-1"></i>@item.ReceiverPhone</div>
                                    </td>
                                    <td>
                                        <div class="text-muted small text-truncate" style="max-width: 250px;" title="@item.ShippingAddress">
                                            <i class="fa-solid fa-location-dot me-1"></i>@item.ShippingAddress
                                        </div>
                                    </td>
                                    <td>
                                        <div class="mb-1">
                                            <span class="badge bg-light text-dark border">@paymentText</span>
                                        </div>
                                        @if (item.PaymentStatus == 1)
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25"><i class="fa-solid fa-check me-1"></i>Đã TT</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25"><i class="fa-regular fa-hourglass-half me-1"></i>Chưa TT</span>
                                        }
                                    </td>
                                    <td class="text-end fw-bold text-danger fs-6">
                                        @item.TotalAmount.ToString("N0") đ
                                    </td>
                                    <td class="text-center">
                                        <span class="status-badge @statusBadgeClass">@statusText</span>
                                    </td>
                                    <td class="text-center">
                                        <button type="button" class="btn btn-sm btn-outline-primary btn-custom btn-view-detail fw-bold px-3 py-1" data-id="@item.Id">
                                            <i class="fa-solid fa-eye me-1"></i> Chi tiết
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5">
                                    <div class="text-muted">
                                        <i class="fa-solid fa-inbox fs-1 d-block mb-3 opacity-50"></i>
                                        <h5>Không tìm thấy đơn hàng nào phù hợp!</h5>
                                        <p class="mb-0">Vui lòng thử thay đổi điều kiện bộ lọc.</p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- MODAL XEM CHI TIẾT ĐƠN HÀNG NÂNG CAO -->
<div class="modal fade" id="orderDetailModal" tabindex="-1" aria-labelledby="orderDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 16px; overflow: hidden;">
            <div class="modal-header bg-white border-bottom py-3 px-4">
                <h5 class="modal-title fw-bold text-dark" id="orderDetailModalLabel">
                    <i class="fa-solid fa-receipt text-primary me-2"></i>Chi Tiết Đơn Hàng <span id="md-order-id" class="text-primary"></span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 bg-light">

                <!-- THÔNG TIN KHÁCH HÀNG & THỜI GIAN -->
                <div class="bg-white p-3 rounded-3 shadow-sm border border-light mb-3">
                    <div class="row g-3">
                        <div class="col-md-6 border-end">
                            <span class="text-muted small text-uppercase fw-bold">Khách hàng</span>
                            <div class="fw-bold fs-6 text-dark mt-1" id="md-receiver-name"></div>
                            <div class="text-danger fw-bold small mt-1" id="md-receiver-phone"></div>
                        </div>
                        <div class="col-md-6 text-md-end">
                            <span class="text-muted small text-uppercase fw-bold">Thời gian đặt</span>
                            <div class="fw-bold text-dark mt-1" id="md-order-date"></div>
                        </div>
                        <div class="col-12 mt-2 pt-2 border-top">
                            <span class="text-muted small text-uppercase fw-bold">Địa chỉ giao hàng</span>
                            <div class="fw-bold text-dark mt-1"><i class="fa-solid fa-location-dot me-2 text-danger"></i><span id="md-shipping-address"></span></div>
                        </div>
                    </div>
                </div>

                <!-- THÔNG TIN VẾT XỬ LÝ NHÂN VIÊN SOẠN & GIAO HÀNG -->
                <div class="bg-info bg-opacity-10 border border-info border-opacity-25 p-3 mb-3 rounded-3">
                    <h6 class="fw-bold text-info mb-2"><i class="fa-solid fa-user-gear me-2"></i>Nhân Viên Xử Lý Đơn Hàng (Staff Audit Trail):</h6>
                    <div class="row g-2 ms-1">
                        <div class="col-md-6">
                            <span class="text-muted small d-block">📦 Nhân viên soạn đơn:</span>
                            <strong class="text-primary fs-6" id="md-packed-by"></strong>
                        </div>
                        <div class="col-md-6">
                            <span class="text-muted small d-block">🚚 Nhân viên/Shipper giao hàng:</span>
                            <strong class="text-success fs-6" id="md-delivered-by"></strong>
                        </div>
                    </div>
                </div>

                <!-- BẢNG DANH SÁCH MẶT HÀNG -->
                <h6 class="fw-bold text-dark mb-2 mt-4"><i class="fa-solid fa-basket-shopping text-warning me-2"></i>Sản Phẩm Đã Mua</h6>
                <div class="bg-white rounded-3 shadow-sm border border-light overflow-hidden mb-3">
                    <div class="table-responsive">
                        <table class="table table-custom mb-0 align-middle">
                            <thead>
                                <tr>
                                    <th style="width: 70px;" class="text-center">Ảnh</th>
                                    <th>Sản Phẩm</th>
                                    <th class="text-center">SL</th>
                                    <th class="text-end">Đơn Giá</th>
                                    <th class="text-end pe-3">Thành Tiền</th>
                                </tr>
                            </thead>
                            <tbody id="md-items-tbody">
                                <!-- Nội dung sinh từ Ajax -->
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- TỔNG TIỀN -->
                <div class="d-flex justify-content-between align-items-center p-3 bg-white rounded-3 shadow-sm border border-light mt-3">
                    <span class="fs-6 fw-bold text-muted text-uppercase letter-spacing-1">Tổng Thanh Toán</span>
                    <span class="text-danger fs-4 fw-bold" id="md-total-amount"></span>
                </div>

            </div>
            <div class="modal-footer bg-white border-top">
                <button type="button" class="btn btn-secondary btn-custom px-4 fw-bold" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<script>
    $(document).ready(function () {
        var detailModal = new bootstrap.Modal(document.getElementById('orderDetailModal'));

        $('.btn-view-detail').on('click', function () {
            var orderId = $(this).data('id');
            var btn = $(this);
            var originalHtml = btn.html();
            btn.prop('disabled', true).html('<i class="fa-solid fa-spinner fa-spin"></i>');

            $.ajax({
                url: '@Url.Action("GetOrderDetailJson", "ManageOrder")',
                type: 'GET',
                data: { id: orderId },
                success: function (res) {
                    btn.prop('disabled', false).html(originalHtml);

                    if (res.success && res.data) {
                        var d = res.data;
                        $('#md-order-id').text('#' + d.id);
                        $('#md-receiver-name').html('<i class="fa-regular fa-circle-user me-2 text-primary"></i>' + d.receiverName);
                        $('#md-receiver-phone').html('<i class="fa-solid fa-phone me-2"></i>' + d.receiverPhone);
                        $('#md-order-date').html('<i class="fa-regular fa-clock me-1"></i> ' + d.orderDate);
                        $('#md-shipping-address').text(d.shippingAddress);
                        $('#md-total-amount').text(d.totalAmount.toLocaleString('vi-VN') + ' đ');

                        $('#md-packed-by').text(d.packedBy || 'Chưa thực hiện soạn đơn');
                        $('#md-delivered-by').text(d.deliveredBy || 'Chưa thực hiện giao hàng');

                        var tbody = $('#md-items-tbody');
                        tbody.empty();

                        if (d.items && d.items.length > 0) {
                            $.each(d.items, function (i, item) {
                                var imgUrl = item.image ? item.image : '/Content/images/no-image.png';
                                var row = '<tr>' +
                                    '<td class="text-center py-2"><div class="bg-light rounded border p-1 d-inline-block"><img src="' + imgUrl + '" style="width: 40px; height: 40px; object-fit: contain;" /></div></td>' +
                                    '<td><div class="fw-bold text-dark fs-6">' + item.productName + '</div><div class="small text-muted mt-1">Barcode: <span class="badge bg-light text-dark border">' + (item.barcode || 'N/A') + '</span></div></td>' +
                                    '<td class="text-center"><span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-2 py-1">x' + item.quantity + '</span></td>' +
                                    '<td class="text-end fw-bold text-secondary">' + item.price.toLocaleString('vi-VN') + ' đ</td>' +
                                    '<td class="text-end pe-3 fw-bold text-success">' + item.total.toLocaleString('vi-VN') + ' đ</td>' +
                                    '</tr>';
                                tbody.append(row);
                            });
                        }
                        detailModal.show();
                    } else {
                        alert(res.message || "Không nạp được thông tin chi tiết đơn!");
                    }
                },
                error: function (xhr, status, err) {
                    btn.prop('disabled', false).html(originalHtml);
                    alert("Lỗi khi tải chi tiết đơn hàng: " + (xhr.responseText || err));
                }
            });
        });
    });
</script>