@model IEnumerable<Do_An_E_Commerce_BHX.Models.Entities.Order>

@{
    ViewData["Title"] = "Danh sách đơn cần soạn";
    ViewData["Subtitle"] = "Soạn hàng và tích chọn các món đã lấy kho";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
    string currentSearch = ViewBag.CurrentSearch as string ?? "";
}

<div class="dash-page">

    <!-- ===== PAGE HEADER ===== -->
    <div class="d-flex align-items-center justify-content-between mb-4 pb-3" style="border-bottom: 1px solid var(--adm-border);">
        <div>
            <h3 class="mb-1" style="font-size: 20px; font-weight: 700; color: var(--adm-text); display: flex; align-items: center; gap: 10px;">
                <i class="fa-solid fa-box-open text-warning"></i> Khu Vực Soạn Hàng (Packing)
            </h3>
            <p class="mb-0" style="font-size: 13.5px; color: var(--adm-text-2);">Danh sách các đơn hàng đã được duyệt, đang chờ nhân viên lấy hàng kho</p>
        </div>
        <a href="@Url.Action("Index", "ManageOrder")" class="btn btn-outline-secondary">
            <i class="fa-solid fa-arrow-left me-1"></i> Quay lại Quản lý đơn
        </a>
    </div>

    <!-- ===== BỘ LỌC TÌM KIẾM ===== -->
    <div class="adm-filter-bar mb-4">
        <h5 class="mb-3" style="font-size: 14px; font-weight: 700; color: var(--adm-text); display: flex; align-items: center; gap: 8px;">
            <i class="fa-solid fa-sliders text-primary"></i> Tìm kiếm đơn chờ soạn
        </h5>
        <form method="get" action="@Url.Action("PackingList", "ManageOrder")">
            <div class="row g-3">
                <div class="col-12 col-md-8 col-lg-6">
                    <div class="input-group">
                        <span class="input-group-text border-end-0"><i class="fa-solid fa-magnifying-glass"></i></span>
                        <input type="text" name="search" class="form-control border-start-0 ps-0" placeholder="Tìm theo SĐT hoặc Mã đơn (VD: #12)..." value="@currentSearch" />
                    </div>
                </div>
            </div>
            <div class="d-flex justify-content-end align-items-center gap-2 mt-3 pt-3" style="border-top: 1px solid var(--adm-border);">
                @if (!string.IsNullOrEmpty(currentSearch))
                {
                    <a href="@Url.Action("PackingList", "ManageOrder")" class="btn btn-outline-secondary">
                        <i class="fa-solid fa-rotate-left me-1"></i> Xóa lọc
                    </a>
                }
                <button type="submit" class="btn btn-warning text-dark fw-bold">
                    <i class="fa-solid fa-filter me-1"></i> TÌM ĐƠN CHỜ SOẠN
                </button>
            </div>
        </form>
    </div>

    <!-- ===== BẢNG ĐƠN HÀNG CHỜ SOẠN ===== -->
    <div class="adm-table-wrap mb-5">
        <div class="adm-table-header">
            <h5 class="adm-table-title m-0">
                <i class="fa-solid fa-list-ul"></i>
                Danh Sách Đơn Chờ Soạn (@(Model?.Count() ?? 0))
            </h5>
        </div>
        <div class="adm-table-responsive">
            <table class="table mb-0">
                <thead>
                    <tr>
                        <th class="ps-4" style="width: 100px;">Mã Đơn</th>
                        <th>Thời Gian</th>
                        <th>Khách Hàng & SĐT</th>
                        <th>Địa Chỉ Nhận Hàng</th>
                        <th class="text-center">Số Mặt Hàng</th>
                        <th class="text-end">Tổng Tiền</th>
                        <th class="text-center" style="width: 180px;">Hành Động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            int totalItemCount = item.OrderDetails != null ? item.OrderDetails.Sum(od => od.Quantity) : 0;
                            <tr>
                                <td class="ps-4">
                                    <span style="font-family: 'JetBrains Mono', monospace; font-size: 13.5px; color: var(--adm-gold); font-weight: 700;">#@item.Id</span>
                                </td>
                                <td>
                                    <div style="font-weight: 600; color: var(--adm-text);">@item.OrderDate.ToString("dd/MM/yyyy")</div>
                                    <div style="font-size: 12px; color: var(--adm-text-3);"><i class="fa-regular fa-clock me-1"></i>@item.OrderDate.ToString("HH:mm")</div>
                                </td>
                                <td>
                                    <div style="font-weight: 600; color: var(--adm-blue);"><i class="fa-regular fa-circle-user me-1"></i>@item.ReceiverName</div>
                                    <div style="font-size: 12.5px; color: var(--adm-red); font-weight: 600;" class="my-1"><i class="fa-solid fa-phone me-1"></i>@item.ReceiverPhone</div>
                                </td>
                                <td>
                                    <div style="font-size: 12px; color: var(--adm-text-2); max-width: 250px;" class="text-truncate" title="@item.ShippingAddress">
                                        <i class="fa-solid fa-location-dot me-1"></i>@item.ShippingAddress
                                    </div>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-info text-dark">
                                        @(item.OrderDetails != null ? item.OrderDetails.Count : 0) loại
                                    </span>
                                    <span class="badge bg-danger ms-1">
                                        @totalItemCount SP
                                    </span>
                                </td>
                                <td class="text-end">
                                    <span style="font-family: 'JetBrains Mono', monospace; font-weight: 700; color: var(--adm-gold); font-size: 14.5px;">
                                        @item.TotalAmount.ToString("N0") ₫
                                    </span>
                                </td>
                                <td class="text-center">
                                    <a href="@Url.Action("PackingDetail", "ManageOrder", new { id = item.Id })" class="btn btn-warning btn-sm text-dark fw-bold px-3 shadow-sm d-inline-flex align-items-center justify-content-center">
                                        <i class="fa-solid fa-box-open me-2"></i> SOẠN ĐƠN
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="adm-empty">
                                <i class="fa-solid fa-clipboard-check"></i>
                                <h5>Tuyệt vời! Không còn đơn hàng nào chờ soạn.</h5>
                                <p>Tất cả các đơn đã được nhân viên lấy kho xong.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>