@model Do_An_E_Commerce_BHX.Models.Entities.Order

@{
    ViewData["Title"] = "Chi tiết soạn đơn hàng #" + Model.Id;
    ViewData["Subtitle"] = "Tích chọn từng sản phẩm đã lấy từ kệ hàng kho";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
    int totalItems = Model.OrderDetails != null ? Model.OrderDetails.Count : 0;
}

<div class="dash-page">

    <!-- ===== PAGE HEADER ===== -->
    <div class="d-flex align-items-center justify-content-between mb-4 pb-3" style="border-bottom: 1px solid var(--adm-border);">
        <div>
            <h3 class="mb-1" style="font-size: 20px; font-weight: 700; color: var(--adm-text); display: flex; align-items: center; gap: 10px;">
                <i class="fa-solid fa-clipboard-check text-warning"></i> Soạn Hàng Chi Tiết - Đơn <span style="color: var(--adm-gold);">#@Model.Id</span>
            </h3>
            <p class="mb-0" style="font-size: 13.5px; color: var(--adm-text-2);">Kiểm tra và tích chọn đủ sản phẩm trước khi bấm Đã Soạn Xong</p>
        </div>
        <a href="@Url.Action("PackingList", "ManageOrder")" class="btn btn-outline-secondary">
            <i class="fa-solid fa-arrow-left me-1"></i> Quay lại Danh sách
        </a>
    </div>

    <!-- ===== KHUNG THÔNG TIN KHÁCH HÀNG ===== -->
    <div class="p-4 mb-4 rounded" style="background: var(--adm-surface); border: 1px solid var(--adm-border);">
        <div class="row g-4 align-items-center">
            <div class="col-md-4 border-end border-secondary">
                <span style="font-size: 11px; font-weight: 700; text-transform: uppercase; color: var(--adm-text-2);">Người nhận</span>
                <div style="font-weight: 700; font-size: 16px; color: var(--adm-text);" class="mt-1"><i class="fa-regular fa-circle-user me-2 text-primary"></i>@Model.ReceiverName</div>
                <div style="color: var(--adm-red); font-weight: 700;" class="mt-1"><i class="fa-solid fa-phone me-2"></i>@(User.IsInRole("Admin") ? Model.ReceiverPhone : (string.IsNullOrEmpty(Model.ReceiverPhone) || Model.ReceiverPhone.Length < 6 ? "*****" : Model.ReceiverPhone.Substring(0, 3) + "****" + Model.ReceiverPhone.Substring(Model.ReceiverPhone.Length - 3)))</div>
            </div>
            <div class="col-md-5 border-end border-secondary">
                <span style="font-size: 11px; font-weight: 700; text-transform: uppercase; color: var(--adm-text-2);">Địa chỉ giao hàng & Nhân viên soạn</span>
                <div style="font-weight: 600; color: var(--adm-text);" class="mt-1 pe-3">
                    <i class="fa-solid fa-location-dot me-2 text-danger"></i>@Model.ShippingAddress
                </div>
                <div class="mt-2 text-primary fw-bold small">
                    <i class="fa-solid fa-user-gear me-1"></i>Nhân viên thực hiện soạn đơn: <span class="badge bg-primary text-white fs-6">@User.Identity.Name</span>
                </div>
            </div>
            <div class="col-md-3 text-md-end">
                <span style="font-size: 11px; font-weight: 700; text-transform: uppercase; color: var(--adm-text-2);">Tổng tiền đơn hàng</span>
                <div style="font-family: 'JetBrains Mono', monospace; font-weight: 800; font-size: 22px; color: var(--adm-gold);" class="mt-1">
                    @Model.TotalAmount.ToString("N0") ₫
                </div>
            </div>
        </div>
    </div>

    <!-- ===== TIẾN TRÌNH LẤY HÀNG ===== -->
    <div class="p-4 mb-4 rounded" style="background: var(--adm-surface); border: 1px solid var(--adm-border);">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
            <div class="fw-bold fs-5" style="color: var(--adm-text);">
                Tiến trình lấy hàng:
                <span id="picked-count-text" class="text-success fs-3 mx-1">0</span>
                <span class="text-muted mx-1">/</span>
                <span class="fs-4">@totalItems</span> sản phẩm
            </div>
            <button type="button" id="btnCheckAllItems" class="btn btn-outline-primary">
                <i class="fa-solid fa-check-double me-1"></i> Chọn tất cả
            </button>
        </div>
        <div class="progress" style="height: 14px; border-radius: 8px; background-color: var(--adm-surface-3);">
            <div id="packingProgressBar" class="progress-bar bg-success progress-bar-striped progress-bar-animated" role="progressbar" style="width: 0%; transition: width 0.4s ease;"></div>
        </div>
    </div>

    <!-- ===== DANH SÁCH MẶT HÀNG ===== -->
    <div class="adm-table-wrap mb-4">
        <div class="adm-table-header">
            <h5 class="adm-table-title m-0">
                <i class="fa-solid fa-list-check text-primary"></i>
                Danh Sách Sản Phẩm Cần Lấy
            </h5>
        </div>
        <div class="adm-table-responsive">
            <table class="table mb-0 align-middle">
                <thead>
                    <tr>
                        <th style="width: 140px;" class="ps-4">Trạng Thái</th>
                        <th style="width: 80px;" class="text-center">Hình</th>
                        <th>Sản Phẩm & Mã Barcode</th>
                        <th class="text-center">Cần Lấy</th>
                        <th class="text-end">Đơn Giá</th>
                        <th class="text-end pe-4">Thành Tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.OrderDetails != null && Model.OrderDetails.Any())
                    {
                        foreach (var item in Model.OrderDetails)
                        {
                            var p = item.Product;
                            decimal price = p != null ? p.Price : 0;
                            decimal lineTotal = price * item.Quantity;
                            <tr class="item-row" style="cursor: pointer;">
                                <td class="ps-4">
                                    <div class="form-check m-0 d-flex align-items-center">
                                        <input type="checkbox" class="form-check-input pick-item-check m-0" style="width: 22px; height: 22px; cursor: pointer;" />
                                        <label class="form-check-label ms-2 fw-bold text-muted check-label" style="cursor: pointer; user-select: none;">Chưa lấy</label>
                                    </div>
                                </td>
                                <td class="text-center py-2">
                                    <img src="@(p != null && !string.IsNullOrEmpty(p.URLImage) ? p.URLImage : "/Content/images/no-image.png")"
                                         alt="Product" style="width: 48px; height: 48px; object-fit: cover; border-radius: 6px; border: 1px solid var(--adm-border);" />
                                </td>
                                <td>
                                    <div style="font-weight: 600; color: var(--adm-text);">@(p != null ? p.Name : "Sản phẩm không xác định")</div>
                                    <div style="font-size: 12px; color: var(--adm-text-3);" class="mt-1">
                                        Barcode: <span class="badge bg-secondary">@(p != null ? p.Barcode : "N/A")</span>
                                    </div>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-danger fs-6 px-3 py-2">x @item.Quantity</span>
                                </td>
                                <td class="text-end" style="font-family: 'JetBrains Mono', monospace; color: var(--adm-text-2);">
                                    @price.ToString("N0") ₫
                                </td>
                                <td class="text-end pe-4" style="font-family: 'JetBrains Mono', monospace; font-weight: 700; color: var(--adm-gold);">
                                    @lineTotal.ToString("N0") ₫
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- ===== NÚT HOÀN TẤT ===== -->
    <div class="text-end mb-5">
        <button id="btnCompletePacking" class="btn btn-secondary btn-lg px-5 py-3 fw-bold shadow" disabled style="border-radius: 50px;">
            <i class="fa-solid fa-truck-fast me-2"></i> ĐÃ SOẠN XONG <i class="fa-solid fa-arrow-right ms-2"></i>
        </button>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
            var totalItems = @totalItems;

            $('.item-row').on('click', function(e) {
                if(e.target.type !== 'checkbox' && e.target.tagName !== 'LABEL') {
                    var checkbox = $(this).find('.pick-item-check');
                    checkbox.prop('checked', !checkbox.prop('checked')).trigger('change');
                }
            });

            function updateProgress() {
                var checkedCount = $('.pick-item-check:checked').length;
                $('#picked-count-text').text(checkedCount);

                var percent = totalItems > 0 ? (checkedCount / totalItems) * 100 : 0;
                $('#packingProgressBar').css('width', percent + '%');

                $('.pick-item-check').each(function () {
                    var row = $(this).closest('tr');
                    var label = row.find('.check-label');
                    if ($(this).is(':checked')) {
                        row.css('background', 'rgba(63, 185, 80, 0.1)');
                        label.html('<i class="fa-solid fa-circle-check text-success me-1"></i>Đã lấy').css('color', 'var(--adm-emerald)');
                    } else {
                        row.css('background', 'transparent');
                        label.text('Chưa lấy').css('color', 'var(--adm-text-3)');
                    }
                });

                if (checkedCount === totalItems && totalItems > 0) {
                    $('#btnCompletePacking').prop('disabled', false)
                        .removeClass('btn-secondary').addClass('btn-success');
                } else {
                    $('#btnCompletePacking').prop('disabled', true)
                        .removeClass('btn-success').addClass('btn-secondary');
                }
            }

            $('.pick-item-check').on('change', function () {
                updateProgress();
            });

            $('#btnCheckAllItems').on('click', function () {
                $('.pick-item-check').prop('checked', true);
                updateProgress();
            });

            $('#btnCompletePacking').on('click', function (e) {
                e.preventDefault();
                var btn = $(this);
                var originalHtml = btn.html();
                btn.prop('disabled', true).html('<i class="fa-solid fa-spinner fa-spin me-2"></i> Đang xử lý...');

                $.post('@Url.Action("CompletePacking", "ManageOrder")', { id: @Model.Id }, function (res) {
                    if (res.success) {
                        alert("🎉 " + res.message);
                        window.location.href = res.redirectUrl || '@Url.Action("DeliveryList", "ManageOrder")';
                    } else {
                        alert(res.message || "Xử lý thất bại!");
                        btn.prop('disabled', false).html(originalHtml);
                    }
                });
            });
        });
    </script>
}