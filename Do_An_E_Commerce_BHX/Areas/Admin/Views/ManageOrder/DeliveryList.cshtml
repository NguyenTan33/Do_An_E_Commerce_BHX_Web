@model IEnumerable<Do_An_E_Commerce_BHX.Models.Entities.Order>

@{
    ViewData["Title"] = "Quản lý giao hàng";
    ViewData["Subtitle"] = "Phân công Shipper, xác nhận Giao thành công hoặc Giao thất bại hoàn tồn kho";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
    string currentSearch = ViewBag.CurrentSearch as string ?? "";

    bool shouldMask = Do_An_E_Commerce_BHX.Helpers.ManagerSensitiveInfoConfig.ShouldMaskForUser(User);
    Func<string, string> maskPhone = p => (!shouldMask || string.IsNullOrEmpty(p) || p.Length < 6) ? p : p.Substring(0, 3) + "****" + p.Substring(p.Length - 3);
    Func<string, string> maskAddress = addr =>
    {
        if (!shouldMask || string.IsNullOrEmpty(addr)) return addr;
        if (addr.Length <= 10) return "****** (Đã che địa chỉ)";
        int commaIdx = addr.LastIndexOf(',');
        if (commaIdx > 5) return addr.Substring(0, 4) + "******" + addr.Substring(commaIdx);
        return addr.Substring(0, 5) + "****** (Đã che địa chỉ)";
    };
}

<div class="dash-page">

    <!-- ===== PAGE HEADER ===== -->
    <div class="d-flex align-items-center justify-content-between mb-4 pb-3" style="border-bottom: 1px solid var(--adm-border);">
        <div>
            <h3 class="mb-1" style="font-size: 20px; font-weight: 700; color: var(--adm-text); display: flex; align-items: center; gap: 10px;">
                <i class="fa-solid fa-truck-fast text-info"></i> Khu Vực Quản Lý Giao Hàng
            </h3>
            <p class="mb-0" style="font-size: 13.5px; color: var(--adm-text-2);">Phân công Shipper giao hàng và xác nhận kết quả Giao Thành Công / Thất Bại</p>
        </div>
        <a href="@Url.Action("Index", "ManageOrder")" class="btn btn-outline-secondary">
            <i class="fa-solid fa-arrow-left me-1"></i> Quay lại Quản lý đơn
        </a>
    </div>

    <!-- ===== BỘ LỌC TÌM KIẾM ===== -->
    <div class="adm-filter-bar mb-4">
        <h5 class="mb-3" style="font-size: 14px; font-weight: 700; color: var(--adm-text); display: flex; align-items: center; gap: 8px;">
            <i class="fa-solid fa-sliders text-primary"></i> Tìm kiếm đơn giao
        </h5>
        <form method="get" action="@Url.Action("DeliveryList", "ManageOrder")">
            <div class="row g-3">
                <div class="col-12 col-md-8 col-lg-6">
                    <div class="input-group">
                        <span class="input-group-text border-end-0"><i class="fa-solid fa-magnifying-glass"></i></span>
                        <input type="text" name="search" class="form-control border-start-0 ps-0" placeholder="Tìm theo SĐT hoặc Mã đơn (VD: #12)..." value="@currentSearch" />
                    </div>
                </div>
            </div>
            <div class="d-flex justify-content-end align-items-center gap-2 mt-3 pt-3" style="border-top: 1px solid var(--adm-border);">
                @if (!string.IsNullOrEmpty(currentSearch))
                {
                    <a href="@Url.Action("DeliveryList", "ManageOrder")" class="btn btn-outline-secondary">
                        <i class="fa-solid fa-rotate-left me-1"></i> Xóa lọc
                    </a>
                }
                <button type="submit" class="btn btn-primary">
                    <i class="fa-solid fa-filter me-1"></i> TÌM ĐƠN GIAO HÀNG
                </button>
            </div>
        </form>
    </div>

    <!-- ===== BẢNG ĐƠN CHỜ GIAO / ĐANG GIAO ===== -->
    <div class="adm-table-wrap mb-5">
        <div class="adm-table-header">
            <h5 class="adm-table-title m-0">
                <i class="fa-solid fa-list-ul"></i>
                Danh Sách Đơn Cần Giao (@(Model?.Count() ?? 0))
            </h5>
        </div>
        <div class="adm-table-responsive">
            <table class="table mb-0">
                <thead>
                    <tr>
                        <th class="ps-4" style="width: 90px;">Mã Đơn</th>
                        <th>Thời Gian</th>
                        <th>Khách Hàng & SĐT</th>
                        <th>Địa Chỉ Nhận Hàng</th>
                        <th class="text-end">Tổng Tiền</th>
                        <th class="text-center">Trạng Thái</th>
                        <th class="text-center" style="width: 320px;">Hành Động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            bool isDelivering = item.OrderStatus == 3;
                            <tr>
                                <td class="ps-4">
                                    <span style="font-family: 'JetBrains Mono', monospace; font-size: 13.5px; color: var(--adm-gold); font-weight: 700;">#@item.Id</span>
                                </td>
                                <td>
                                    <div style="font-weight: 600; color: var(--adm-text);">@item.OrderDate.ToString("dd/MM/yyyy")</div>
                                    <div style="font-size: 12px; color: var(--adm-text-3);"><i class="fa-regular fa-clock me-1"></i>@item.OrderDate.ToString("HH:mm")</div>
                                </td>
                                <td>
                                    <div style="font-weight: 600; color: var(--adm-blue);"><i class="fa-regular fa-circle-user me-1"></i>@item.ReceiverName</div>
                                    <div style="font-size: 12.5px; color: var(--adm-red); font-weight: 600;" class="my-1"><i class="fa-solid fa-phone me-1"></i>@maskPhone(item.ReceiverPhone)</div>
                                </td>
                                <td>
                                    <div style="font-size: 12px; color: var(--adm-text-2); max-width: 250px;" class="text-truncate" title="@maskAddress(item.ShippingAddress)">
                                        <i class="fa-solid fa-location-dot me-1"></i>@maskAddress(item.ShippingAddress)
                                    </div>
                                    @if (!string.IsNullOrEmpty(item.Note))
                                    {
                                        <div class="small text-info mt-1 font-weight-bold bg-info bg-opacity-10 d-inline-block px-2 py-1 rounded">
                                            <i class="fa-solid fa-info-circle me-1"></i>Shipper: @item.Note
                                        </div>
                                    }
                                </td>
                                <td class="text-end">
                                    <span style="font-family: 'JetBrains Mono', monospace; font-weight: 700; color: var(--adm-gold); font-size: 14.5px;">
                                        @item.TotalAmount.ToString("N0") ₫
                                    </span>
                                </td>
                                <td class="text-center">
                                    @if (item.OrderStatus == 2)
                                    {
                                        <span class="badge bg-info text-dark">
                                            <i class="fa-solid fa-boxes-stacked me-1"></i> Chờ giao
                                        </span>
                                    }
                                    else if (item.OrderStatus == 3)
                                    {
                                        <span class="badge bg-purple" style="background:#6f42c1; color:#fff;">
                                            <i class="fa-solid fa-motorcycle me-1"></i> Đang đi giao
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (!isDelivering)
                                    {
                                        <button type="button" class="btn btn-primary btn-sm fw-bold btn-start-delivery w-100 shadow-sm py-2" data-id="@item.Id">
                                            <i class="fa-solid fa-truck-ramp-box me-2"></i> BẮT ĐẦU ĐI GIAO
                                        </button>
                                    }
                                    else
                                    {
                                        <div class="d-flex gap-2">
                                            <button type="button" class="btn btn-success btn-sm fw-bold btn-success-delivery flex-fill shadow-sm py-2" data-id="@item.Id" title="Giao thành công">
                                                <i class="fa-solid fa-circle-check me-1"></i> THÀNH CÔNG
                                            </button>
                                            <button type="button" class="btn btn-outline-danger btn-sm fw-bold btn-failed-delivery flex-fill py-2" data-id="@item.Id" title="Giao thất bại - Cộng trả tồn kho">
                                                <i class="fa-solid fa-circle-xmark me-1"></i> THẤT BẠI
                                            </button>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="adm-empty">
                                <i class="fa-solid fa-motorcycle"></i>
                                <h5>Trống</h5>
                                <p>Tất cả các đơn đã được xử lý xong hoặc đang chờ soạn.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
            $('.btn-start-delivery').on('click', function () {
                var id = $(this).data('id');
                var shipperName = prompt("Nhập tên Tài xế / Shipper giao đơn #" + id + " (Tùy chọn):", "Shipper Bách Hóa Xanh");
                if (shipperName !== null) {
                    var btn = $(this);
                    btn.prop('disabled', true).html('<i class="fa-solid fa-spinner fa-spin me-1"></i> Đang xử lý...');

                    $.post('@Url.Action("StartDelivery", "ManageOrder")', { id: id, note: shipperName }, function (res) {
                        alert(res.message);
                        if (res.success) location.reload();
                        else btn.prop('disabled', false).html('<i class="fa-solid fa-truck-ramp-box me-2"></i> BẮT ĐẦU ĐI GIAO');
                    });
                }
            });

            $('.btn-success-delivery').on('click', function () {
                var id = $(this).data('id');
                if (confirm("🎉 XÁC NHẬN: Đơn hàng #" + id + " đã được GIAO HÀNG THÀNH CÔNG cho khách?")) {
                    var btn = $(this);
                    btn.prop('disabled', true).html('<i class="fa-solid fa-spinner fa-spin"></i>');

                    $.post('@Url.Action("CompleteDeliverySuccess", "ManageOrder")', { id: id }, function (res) {
                        alert(res.message);
                        if (res.success) location.reload();
                        else btn.prop('disabled', false).html('<i class="fa-solid fa-circle-check me-1"></i> THÀNH CÔNG');
                    });
                }
            });

            $('.btn-failed-delivery').on('click', function () {
                var id = $(this).data('id');
                if (confirm("⚠️ CẢNH BÁO: Đơn hàng #" + id + " GIAO HÀNG THẤT BẠI?\n(Hệ thống sẽ chuyển trạng thái Thất Bại và TỰ ĐỘNG CỘNG TRẢ LẠI SỐ LƯỢNG TỒN KHO!)")) {
                    var btn = $(this);
                    btn.prop('disabled', true).html('<i class="fa-solid fa-spinner fa-spin"></i>');

                    $.post('@Url.Action("CompleteDeliveryFailed", "ManageOrder")', { id: id }, function (res) {
                        alert(res.message);
                        if (res.success) location.reload();
                        else btn.prop('disabled', false).html('<i class="fa-solid fa-circle-xmark me-1"></i> THẤT BẠI');
                    });
                }
            });
        });
    </script>
}