@model IEnumerable<Do_An_E_Commerce_BHX.Models.Entities.Order>

@{
    ViewData["Title"] = "Quản lý đơn hàng";
    ViewData["Subtitle"] = "Duyệt đơn, hủy đơn, tìm kiếm và thao tác hàng loạt";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";

    string currentSearch = ViewBag.CurrentSearch as string ?? "";
    int? currentStatus = ViewBag.CurrentStatus as int?;

    int countAll = ViewBag.CountAll != null ? (int)ViewBag.CountAll : 0;
    int countPending = ViewBag.CountPending != null ? (int)ViewBag.CountPending : 0;
    int countApproved = ViewBag.CountApproved != null ? (int)ViewBag.CountApproved : 0;
    int countPacked = ViewBag.CountPacked != null ? (int)ViewBag.CountPacked : 0;
    int countDelivering = ViewBag.CountDelivering != null ? (int)ViewBag.CountDelivering : 0;
    int countSuccess = ViewBag.CountSuccess != null ? (int)ViewBag.CountSuccess : 0;
    int countFailed = ViewBag.CountFailed != null ? (int)ViewBag.CountFailed : 0;
}

<div class="dash-page">

    <!-- ===== PAGE HEADER (ĐÃ FIX RỚT DÒNG TRÊN MOBILE) ===== -->
    <div class="d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between mb-4 pb-3 gap-3" style="border-bottom: 1px solid var(--adm-border);">
        <div>
            <h3 class="mb-1" style="font-size: 20px; font-weight: 700; color: var(--adm-text); display: flex; align-items: center; gap: 10px;">
                <i class="fa-solid fa-boxes-packing text-primary"></i> Quản Lý Đơn Hàng
            </h3>
            <p class="mb-0" style="font-size: 13.5px; color: var(--adm-text-2);">Duyệt đơn mới, hủy đơn hoàn tồn kho và xử lý luồng đơn hàng</p>
        </div>

        <div class="d-flex flex-wrap gap-2 w-100 w-md-auto">
            <a href="@Url.Action("PackingList", "ManageOrder")" class="btn btn-warning text-dark fw-bold flex-fill flex-md-grow-0">
                <i class="fa-solid fa-box-open me-1"></i> Soạn Hàng
                <span class="badge bg-dark text-white ms-1 rounded-pill">@countApproved</span>
            </a>
            <a href="@Url.Action("DeliveryList", "ManageOrder")" class="btn btn-info text-dark fw-bold flex-fill flex-md-grow-0">
                <i class="fa-solid fa-truck-fast me-1"></i> Giao Hàng
                <span class="badge bg-dark text-white ms-1 rounded-pill">@(countPacked + countDelivering)</span>
            </a>
        </div>
    </div>

    <!-- ===== BỘ LỌC TÌM KIẾM ===== -->
    <div class="adm-filter-bar mb-4">
        <h5 class="mb-3" style="font-size: 14px; font-weight: 700; color: var(--adm-text); display: flex; align-items: center; gap: 8px;">
            <i class="fa-solid fa-sliders text-primary"></i> Bộ lọc & Trạng thái
        </h5>
        <form method="get" action="@Url.Action("Index", "ManageOrder")">
            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <label class="form-label">Từ khóa tìm kiếm</label>
                    <div class="input-group">
                        <span class="input-group-text border-end-0"><i class="fa-solid fa-magnifying-glass"></i></span>
                        <input type="text" name="search" class="form-control border-start-0 ps-0" placeholder="SĐT khách hoặc Mã Đơn (VD: #12)..." value="@currentSearch" />
                    </div>
                </div>
            </div>

            <!-- TABS LỌC TRẠNG THÁI -->
            <div class="d-flex flex-wrap gap-2 mt-3 pt-3" style="border-top: 1px dashed var(--adm-border);">
                <a href="@Url.Action("Index", "ManageOrder", new { search = currentSearch })"
                   class="btn btn-sm @(!currentStatus.HasValue ? "btn-primary" : "btn-outline-secondary")" style="border-radius: 20px; padding: 6px 16px;">
                    Tất cả <span class="badge bg-dark ms-1 opacity-75">@countAll</span>
                </a>

                <a href="@Url.Action("Index", "ManageOrder", new { search = currentSearch, status = 0 })"
                   class="btn btn-sm @(currentStatus == 0 ? "btn-warning text-dark fw-bold" : "btn-outline-secondary")" style="border-radius: 20px; padding: 6px 16px;">
                    Chờ duyệt <span class="badge bg-dark text-white ms-1 opacity-75">@countPending</span>
                </a>

                <a href="@Url.Action("Index", "ManageOrder", new { search = currentSearch, status = 2 })"
                   class="btn btn-sm @(currentStatus == 2 ? "btn-info text-dark fw-bold" : "btn-outline-secondary")" style="border-radius: 20px; padding: 6px 16px;">
                    Đã soạn <span class="badge bg-dark text-white ms-1 opacity-75">@countPacked</span>
                </a>

                <a href="@Url.Action("Index", "ManageOrder", new { search = currentSearch, status = 3 })"
                   class="btn btn-sm @(currentStatus == 3 ? "btn-primary" : "btn-outline-secondary")" style="border-radius: 20px; padding: 6px 16px;">
                    Đang giao <span class="badge bg-dark ms-1 opacity-75">@countDelivering</span>
                </a>

                <a href="@Url.Action("Index", "ManageOrder", new { search = currentSearch, status = 4 })"
                   class="btn btn-sm @(currentStatus == 4 ? "btn-success" : "btn-outline-secondary")" style="border-radius: 20px; padding: 6px 16px;">
                    Thành công <span class="badge bg-dark ms-1 opacity-75">@countSuccess</span>
                </a>
            </div>

            <div class="d-flex justify-content-end align-items-center gap-2 mt-3 pt-3" style="border-top: 1px solid var(--adm-border);">
                <a href="@Url.Action("Index", "ManageOrder")" class="btn btn-outline-secondary">
                    <i class="fa-solid fa-rotate-left"></i> Đặt lại
                </a>
                <button type="submit" class="btn btn-primary">
                    <i class="fa-solid fa-filter"></i> LỌC ĐƠN HÀNG
                </button>
            </div>
        </form>
    </div>

    <!-- ===== THANH THAO TÁC HÀNG LOẠT ===== -->
    <div class="p-3 mb-3 d-flex flex-wrap align-items-center justify-content-between gap-3 rounded" style="background: var(--adm-surface-2); border: 1px solid var(--adm-border);">
        <div class="form-check m-0 ms-2">
            <input class="form-check-input" type="checkbox" id="checkAll" style="width: 20px; height: 20px; cursor: pointer;" />
            <label class="form-check-label fw-bold ms-2" for="checkAll" style="cursor: pointer; color: var(--adm-text);">
                Chọn tất cả trang này
            </label>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <button id="btnBulkApprove" class="btn btn-sm btn-success">
                <i class="fa-solid fa-check-double me-1"></i> Duyệt chọn
            </button>
            <button id="btnBulkCancel" class="btn btn-sm btn-warning text-dark fw-bold">
                <i class="fa-solid fa-rotate-left me-1"></i> Hủy & Hoàn kho
            </button>
            <button id="btnBulkDelete" class="btn btn-sm btn-danger">
                <i class="fa-solid fa-trash me-1"></i> Xóa
            </button>
        </div>
    </div>

    <!-- ===== BẢNG DANH SÁCH ĐƠN HÀNG ===== -->
    <div class="adm-table-wrap mb-5">
        <div class="adm-table-header">
            <h5 class="adm-table-title m-0">
                <i class="fa-solid fa-list-ul"></i>
                Danh Sách Đơn Hàng (@(Model?.Count() ?? 0))
            </h5>
        </div>
        <div class="adm-table-responsive">
            <table class="table mb-0">
                <thead>
                    <tr>
                        <th style="width: 50px;" class="ps-4 text-center"><i class="fa-solid fa-list-check"></i></th>
                        <th style="width: 100px;">Mã Đơn</th>
                        <th>Thời Gian</th>
                        <th>Thông tin Giao hàng</th>
                        <th>Thanh Toán</th>
                        <th class="text-end">Tổng Tiền</th>
                        <th class="text-center">Trạng Thái</th>
                        <th class="text-end pe-4" style="min-width: 160px;">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            string paymentMethodText = item.PaymentMethod == 1 ? "Ngân hàng" : (item.PaymentMethod == 2 ? "MoMo" : "COD");

                            <tr>
                                <td class="ps-4 text-center">
                                    <input type="checkbox" class="form-check-input order-check" value="@item.Id" style="width: 18px; height: 18px; cursor: pointer;" />
                                </td>
                                <td>
                                    <span style="font-family: 'JetBrains Mono', monospace; font-size: 13.5px; color: var(--adm-gold); font-weight: 700;">#@item.Id</span>
                                </td>
                                <td>
                                    <div style="font-weight: 600; color: var(--adm-text);">@item.OrderDate.ToString("dd/MM/yyyy")</div>
                                    <div style="font-size: 12px; color: var(--adm-text-3);"><i class="fa-regular fa-clock me-1"></i>@item.OrderDate.ToString("HH:mm")</div>
                                </td>
                                <td>
                                    <div style="font-weight: 600; color: var(--adm-blue);"><i class="fa-regular fa-circle-user me-1"></i>@item.ReceiverName</div>
                                    <div style="font-size: 12.5px; color: var(--adm-red); font-weight: 600;" class="my-1"><i class="fa-solid fa-phone me-1"></i>@item.ReceiverPhone</div>
                                    <div style="font-size: 12px; color: var(--adm-text-2); max-width: 250px;" class="text-truncate" title="@item.ShippingAddress">
                                        <i class="fa-solid fa-location-dot me-1"></i>@item.ShippingAddress
                                    </div>
                                </td>
                                <td>
                                    <div class="mb-1">
                                        <span class="badge bg-secondary">@paymentMethodText</span>
                                    </div>
                                    @if (item.PaymentStatus == 1)
                                    {
                                        <span class="badge bg-success"><i class="fa-solid fa-check me-1"></i>Đã thu</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-dark border border-secondary text-muted"><i class="fa-regular fa-hourglass-half me-1"></i>Chưa thu</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <span style="font-family: 'JetBrains Mono', monospace; font-weight: 700; color: var(--adm-gold); font-size: 14.5px;">
                                        @item.TotalAmount.ToString("N0") ₫
                                    </span>
                                </td>
                                <td class="text-center">
                                    @switch (item.OrderStatus)
                                    {
                                        case 0:<span class="badge bg-warning text-dark">Chờ duyệt</span> break;
                                        case 1:<span class="badge bg-primary">Đã duyệt</span> break;
                                        case 2:<span class="badge bg-info text-dark">Đã soạn xong</span> break;
                                        case 3:<span class="badge bg-purple" style="background:#6f42c1; color:#fff;">Đang giao</span> break;
                                        case 4:<span class="badge bg-success">Thành công</span> break;
                                        case 5:<span class="badge bg-danger">Đã hủy / Thất bại</span>break;
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-flex gap-1 justify-content-end">
                                        <button type="button" class="btn btn-sm btn-info text-dark fw-bold" onclick="openOrderDetailModal(@item.Id)" title="Xem chi tiết đơn hàng #@item.Id">
                                            <i class="fa-solid fa-eye me-1"></i> Chi tiết
                                        </button>

                                        @if (item.OrderStatus == 0)
                                        {
                                            <button type="button" class="btn btn-sm btn-success btn-approve" data-id="@item.Id" title="Duyệt đơn hàng">
                                                <i class="fa-solid fa-check"></i> Duyệt
                                            </button>
                                        }

                                        @if (item.OrderStatus == 1)
                                        {
                                            <a href="@Url.Action("PackingDetail", "ManageOrder", new { id = item.Id })" class="btn btn-sm btn-warning text-dark fw-bold" title="Soạn đơn">
                                                <i class="fa-solid fa-box-open"></i> Soạn
                                            </a>
                                        }

                                        @if (item.OrderStatus != 4 && item.OrderStatus != 5)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-warning btn-cancel" data-id="@item.Id" title="Hủy đơn & Hoàn tồn kho">
                                                <i class="fa-solid fa-ban"></i> Hủy
                                            </button>
                                        }

                                        <button type="button" class="btn btn-sm btn-outline-danger btn-delete" data-id="@item.Id" title="Xóa đơn">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="adm-empty">
                                <i class="fa-solid fa-boxes-packing"></i>
                                <h5>Trống</h5>
                                <p>Thử thay đổi bộ lọc hoặc từ khóa tìm kiếm.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- MODAL XEM CHI TIẾT ĐƠN HÀNG -->
<div class="modal fade" id="orderDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content bg-dark text-white border-secondary shadow-lg">
            <div class="modal-header border-secondary" style="background: var(--adm-surface-2);">
                <h5 class="modal-title text-warning fw-bold d-flex align-items-center gap-2">
                    <i class="fa-solid fa-circle-info"></i> CHI TIẾT ĐƠN HÀNG <span id="modalOrderId" class="text-gold font-monospace"></span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="row g-3 mb-4 p-3 rounded-3 border border-secondary" style="background: rgba(255,255,255,0.02);">
                    <div class="col-md-6">
                        <div class="text-muted small">Thời gian đặt: <strong id="modalOrderDate" class="text-white"></strong></div>
                        <div class="text-muted small mt-1">Khách nhận: <strong id="modalReceiver" class="text-info"></strong></div>
                        <div class="text-muted small mt-1">SĐT liên hệ: <strong id="modalPhone" class="text-danger"></strong></div>
                        <div class="text-muted small mt-1">Nhân viên soạn: <strong id="modalPackedBy" class="text-warning"></strong></div>
                    </div>
                    <div class="col-md-6">
                        <div class="text-muted small">Phương thức: <strong id="modalPayment" class="text-warning"></strong></div>
                        <div class="text-muted small mt-1">Địa chỉ giao: <strong id="modalAddress" class="text-white"></strong></div>
                        <div class="text-muted small mt-1">Nhân viên giao: <strong id="modalDeliveredBy" class="text-info"></strong></div>
                    </div>
                </div>

                <!-- DANH SÁCH MÓN ĂN TRONG ĐƠN -->
                <h6 class="fw-bold text-warning mb-3"><i class="fa-solid fa-boxes-stacked me-1"></i>Sản phẩm trong đơn:</h6>
                <div class="table-responsive mb-3 border border-secondary rounded-3">
                    <table class="table table-dark table-hover align-middle mb-0" id="modalItemsTable">
                        <thead class="table-secondary text-white">
                            <tr>
                                <th>Sản phẩm</th>
                                <th class="text-center">Đơn giá</th>
                                <th class="text-center">Số lượng</th>
                                <th class="text-end pe-3">Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>

                <div class="d-flex justify-content-between align-items-center p-3 rounded-3 border border-warning" style="background: rgba(240, 180, 41, 0.08);">
                    <span class="fw-bold text-white fs-6">TỔNG THÀNH TIỀN ĐƠN HÀNG:</span>
                    <span id="modalFinalTotal" class="fw-bold text-warning fs-4 font-monospace"></span>
                </div>
            </div>
            <div class="modal-footer border-secondary">
                <button type="button" class="btn btn-secondary px-4 fw-bold" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        // JS mở Modal Chi Tiết Đơn Hàng từ Quản lý đơn
        function openOrderDetailModal(orderId) {
            var modalEl = document.getElementById('orderDetailModal');
            var modal = bootstrap.Modal.getOrCreateInstance(modalEl);

            document.getElementById('modalOrderId').textContent = '#' + orderId;
            document.getElementById('modalOrderDate').textContent = 'Đang nạp...';
            document.getElementById('modalReceiver').textContent = '...';
            document.getElementById('modalPhone').textContent = '...';
            document.getElementById('modalPayment').textContent = '...';
            document.getElementById('modalAddress').textContent = '...';
            document.getElementById('modalPackedBy').textContent = '...';
            document.getElementById('modalDeliveredBy').textContent = '...';
            document.getElementById('modalFinalTotal').textContent = '0 ₫';
            
            var tbody = document.querySelector('#modalItemsTable tbody');
            tbody.innerHTML = '<tr><td colspan="4" class="text-center py-3 text-warning"><i class="fa-solid fa-spinner fa-spin me-2"></i>Đang nạp dữ liệu chi tiết đơn hàng...</td></tr>';
            
            modal.show();

            fetch('@Url.Action("GetOrderDetailJson", "ManageOrder")?id=' + orderId)
                .then(res => res.json())
                .then(res => {
                    if (res.success && res.data) {
                        var d = res.data;
                        document.getElementById('modalOrderDate').textContent = d.orderDate;
                        document.getElementById('modalReceiver').textContent = d.receiverName;
                        document.getElementById('modalPhone').textContent = d.receiverPhone;
                        document.getElementById('modalPayment').textContent = d.paymentMethod + ' (' + d.paymentStatus + ')';
                        document.getElementById('modalAddress').textContent = d.shippingAddress;
                        document.getElementById('modalPackedBy').textContent = d.packedBy || 'N/A';
                        document.getElementById('modalDeliveredBy').textContent = d.deliveredBy || 'N/A';
                        document.getElementById('modalFinalTotal').textContent = d.totalAmount.toLocaleString('vi-VN') + ' ₫';

                        tbody.innerHTML = '';
                        if (d.items && d.items.length > 0) {
                            d.items.forEach(function(item) {
                                var tr = document.createElement('tr');
                                tr.innerHTML = `
                                    <td>
                                        <div class="fw-bold text-white">${item.productName}</div>
                                        <small class="text-muted">Mã vạch: ${item.barcode || 'N/A'}</small>
                                    </td>
                                    <td class="text-center text-warning font-monospace">${item.price.toLocaleString('vi-VN')} ₫</td>
                                    <td class="text-center font-monospace fw-bold">x${item.quantity}</td>
                                    <td class="text-end pe-3 text-emerald font-monospace fw-bold">${item.total.toLocaleString('vi-VN')} ₫</td>
                                `;
                                tbody.appendChild(tr);
                            });
                        } else {
                            tbody.innerHTML = '<tr><td colspan="4" class="text-center text-muted">Không có danh sách món.</td></tr>';
                        }
                    } else {
                        tbody.innerHTML = '<tr><td colspan="4" class="text-center text-danger">Không tải được thông tin đơn hàng!</td></tr>';
                    }
                })
                .catch(err => {
                    tbody.innerHTML = '<tr><td colspan="4" class="text-center text-danger">Lỗi kết nối máy chủ!</td></tr>';
                });
        }

        $(document).ready(function () {
            $('#checkAll').on('change', function () {
                $('.order-check').prop('checked', $(this).is(':checked'));
            });

            function getSelectedIds() {
                var ids = [];
                $('.order-check:checked').each(function () {
                    ids.push(parseInt($(this).val()));
                });
                return ids;
            }

            $('.btn-approve').on('click', function () {
                var id = $(this).data('id');
                if (confirm("Xác nhận duyệt đơn hàng #" + id + "?")) {
                    $.post('@Url.Action("Approve", "ManageOrder")', { id: id }, function (res) {
                        alert(res.message);
                        if (res.success) location.reload();
                    });
                }
            });

            $('.btn-cancel').on('click', function () {
                var id = $(this).data('id');
                if (confirm("Xác nhận hủy đơn hàng #" + id + "? (Hệ thống sẽ tự động cộng trả lại tồn kho)")) {
                    $.post('@Url.Action("Cancel", "ManageOrder")', { id: id }, function (res) {
                        alert(res.message);
                        if (res.success) location.reload();
                    });
                }
            });

            $('.btn-delete').on('click', function () {
                var id = $(this).data('id');
                if (confirm("Bạn có chắc chắn muốn xóa đơn hàng #" + id + "?")) {
                    $.post('@Url.Action("Delete", "ManageOrder")', { id: id }, function (res) {
                        alert(res.message);
                        if (res.success) location.reload();
                    });
                }
            });

            $('#btnBulkApprove').on('click', function () {
                var ids = getSelectedIds();
                if (ids.length === 0) { alert("Vui lòng tích chọn ít nhất 1 đơn hàng!"); return; }
                if (confirm("Bạn có muốn duyệt " + ids.length + " đơn hàng đã chọn?")) {
                    $.post('@Url.Action("BulkApprove", "ManageOrder")', { ids: ids }, function (res) {
                        alert(res.message);
                        if (res.success) location.reload();
                    });
                }
            });

            $('#btnBulkCancel').on('click', function () {
                var ids = getSelectedIds();
                if (ids.length === 0) { alert("Vui lòng tích chọn ít nhất 1 đơn hàng!"); return; }
                if (confirm("Xác nhận hủy " + ids.length + " đơn hàng đã chọn?")) {
                    $.post('@Url.Action("BulkCancel", "ManageOrder")', { ids: ids }, function (res) {
                        alert(res.message);
                        if (res.success) location.reload();
                    });
                }
            });

            $('#btnBulkDelete').on('click', function () {
                var ids = getSelectedIds();
                if (ids.length === 0) { alert("Vui lòng tích chọn ít nhất 1 đơn hàng!"); return; }
                if (confirm("CẢNH BÁO: XÓA VĨNH VIỄN " + ids.length + " đơn hàng?")) {
                    $.post('@Url.Action("BulkDelete", "ManageOrder")', { ids: ids }, function (res) {
                        alert(res.message);
                        if (res.success) location.reload();
                    });
                }
            });
        });
    </script>
}