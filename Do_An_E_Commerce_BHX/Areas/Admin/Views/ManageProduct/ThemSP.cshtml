@model Do_An_E_Commerce_BHX.Models.Entities.Product

@{
    ViewData["Title"] = "Thêm Sản Phẩm Mới";
    ViewData["Subtitle"] = "Nhập thông tin sản phẩm mới vào kho hàng";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container-fluid py-3" style="max-width: 900px;">
    <!-- HEADER BAR -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3" style="border-bottom: 1px solid var(--adm-border);">
        <div>
            <h3 class="mb-1 fw-bold text-white d-flex align-items-center gap-2">
                <i class="fa-solid fa-square-plus text-warning"></i> Thêm Sản Phẩm Mới
            </h3>
            <p class="mb-0 text-muted small">Điền đầy đủ các thông tin bắt buộc (*) để lưu sản phẩm vào hệ thống</p>
        </div>
        <a href="@Url.Action("Index", "ManageProduct")" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="fa-solid fa-arrow-left me-1"></i> Quay lại danh sách
        </a>
    </div>

    <!-- FORM CARD DARK THEME -->
    <div class="card border-0 shadow-lg rounded-4 overflow-hidden" style="background: var(--adm-surface); border: 1px solid var(--adm-border) !important;">
        <div class="card-body p-4 p-md-5">
            @using (Html.BeginForm("ThemSP", "ManageProduct", FormMethod.Post, new { id = "form-them-sp" }))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(false, "", new { @class = "text-danger mb-3" })

                <!-- TÊN SẢN PHẨM -->
                <div class="mb-4">
                    <label class="form-label text-warning fw-bold small text-uppercase"><i class="fa-solid fa-tag me-1"></i>Tên sản phẩm (*)</label>
                    @Html.TextBoxFor(m => m.Name, new { @class = "form-control form-control-lg bg-dark text-white border-secondary", placeholder = "VD: Bia Tiger Crystal, Thịt Ba Chỉ Heo Tươi...", required = "required" })
                </div>

                <!-- MÃ VẠCH & GIÁ BÁN -->
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label class="form-label text-warning fw-bold small text-uppercase"><i class="fa-solid fa-barcode me-1"></i>Mã vạch (*)</label>
                        @Html.TextBoxFor(m => m.Barcode, new { @class = "form-control bg-dark text-white border-secondary", placeholder = "8938505974194", required = "required" })
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-warning fw-bold small text-uppercase"><i class="fa-solid fa-money-bill-wave me-1"></i>Giá bán mặc định (VNĐ) (*)</label>
                        <input type="number" name="Price" class="form-control bg-dark text-white border-secondary fw-bold" placeholder="330000" min="0" step="1000" required />
                    </div>
                </div>

                <!-- TỒN KHO & DANH MỤC -->
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label class="form-label text-warning fw-bold small text-uppercase"><i class="fa-solid fa-boxes-stacked me-1"></i>Số lượng tồn kho lẻ (*)</label>
                        @Html.TextBoxFor(m => m.Quantity, new { type = "number", min = "0", @class = "form-control bg-dark text-white border-secondary", placeholder = "100", required = "required" })
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-warning fw-bold small text-uppercase"><i class="fa-solid fa-layer-group me-1"></i>Danh mục sản phẩm (*)</label>
                        @Html.DropDownListFor(m => m.CategoryId, ViewBag.Category as SelectList, "-- Chọn danh mục --", new { @class = "form-select bg-dark text-white border-secondary", required = "required" })
                    </div>
                </div>

                <!-- SẢN PHẨM KHO GỐC NẾU LÀ QUY CÁCH THÙNG / LỐC -->
                <div class="p-3 mb-4 rounded-3 border" style="background: rgba(13, 110, 253, 0.1); border-color: rgba(13, 110, 253, 0.3) !important;">
                    <label class="form-label text-info fw-bold small mb-2"><i class="fa-solid fa-link me-1"></i>Sản Phẩm Kho Gốc (Dành cho bài Thùng / Lốc 6 lon dùng chung kho lẻ)</label>
                    @Html.DropDownListFor(m => m.ParentProductId, ViewBag.ParentProductId as SelectList, "-- BÀI MẶC ĐỊNH (Tự quản lý kho riêng) --", new { @class = "form-select bg-dark text-white border-secondary fw-bold" })
                    <small class="text-info opacity-75 d-block mt-2"><i class="fa-solid fa-circle-info me-1"></i>Chọn bài Lon lẻ gốc để khi bán Thùng tự động trừ kho từ bài Lon lẻ gốc.</small>
                </div>

                <!-- ĐƠN VỊ TÍNH & HỆ SỐ QUY ĐỔI -->
                <div class="row g-3 mb-4 p-3 rounded-3 border border-secondary" style="background: rgba(255, 255, 255, 0.03);">
                    <div class="col-md-6">
                        <label class="form-label text-warning fw-bold small text-uppercase"><i class="fa-solid fa-scale-balanced me-1"></i>Đơn vị tính mặc định (*)</label>
                        @Html.TextBoxFor(m => m.Unit, new { @class = "form-control bg-dark text-white border-secondary", placeholder = "VD: Thùng, Lon, Kg, Chai, Vỉ 200g...", required = "required" })
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-warning fw-bold small text-uppercase"><i class="fa-solid fa-calculator me-1"></i>Hệ số quy đổi kho lẻ (*)</label>
                        @Html.TextBoxFor(m => m.UnitMultiplier, new { type = "number", min = "1", @class = "form-control bg-dark text-white border-secondary", placeholder = "1 (1 Thùng 24 lon = 24)", required = "required" })
                        <small class="text-muted text-xs mt-1 d-block">Nhập 24 cho Thùng 24 lon, 200 cho Vỉ 200g, 1 cho hàng lẻ.</small>
                    </div>
                </div>

                <!-- MÔ TẢ CHI TIẾT -->
                <div class="mb-4">
                    <label class="form-label text-warning fw-bold small text-uppercase"><i class="fa-solid fa-align-left me-1"></i>Mô tả chi tiết sản phẩm</label>
                    @Html.TextAreaFor(m => m.Description, new { rows = "3", @class = "form-control bg-dark text-white border-secondary", placeholder = "Nhập mô tả sản phẩm tươi ngon, nguồn gốc xuất xứ..." })
                </div>

                <!-- HÌNH ẢNH URL -->
                <div class="mb-4">
                    <label class="form-label text-warning fw-bold small text-uppercase"><i class="fa-solid fa-image me-1"></i>Đường dẫn hình ảnh (URL Image)</label>
                    @Html.TextBoxFor(m => m.URLImage, new { @class = "form-control bg-dark text-white border-secondary", placeholder = "coca.jpg" })
                </div>

                <!-- TRẠNG THÁI HIỂN THỊ -->
                <div class="mb-4 p-3 rounded-3 border border-secondary" style="background: rgba(255, 255, 255, 0.03);">
                    <label class="form-label text-white fw-bold small mb-2 text-uppercase">Trạng thái sản phẩm:</label>
                    <div class="d-flex gap-4 flex-wrap">
                        <label class="form-check-label text-success fw-bold cursor-pointer">
                            @Html.CheckBoxFor(m => m.IsAvailable, new { @class = "form-check-input me-1", @checked = "checked" }) Đang bán
                        </label>
                        <label class="form-check-label text-danger fw-bold cursor-pointer">
                            @Html.CheckBoxFor(m => m.IsHot, new { @class = "form-check-input me-1" }) Nổi bật 🔥
                        </label>
                        <label class="form-check-label text-warning fw-bold cursor-pointer">
                            @Html.CheckBoxFor(m => m.IsBestSeller, new { @class = "form-check-input me-1" }) Bán chạy ⭐
                        </label>
                    </div>
                </div>

                <!-- BUTTON ACTIONS -->
                <div class="d-flex justify-content-end gap-3 pt-3 border-top border-secondary">
                    <a href="@Url.Action("Index", "ManageProduct")" class="btn btn-outline-secondary px-4 fw-bold">Hủy bỏ</a>
                    <button type="submit" class="btn btn-warning fw-bold px-5 text-dark shadow">
                        <i class="fa-solid fa-floppy-disk me-1"></i> LƯU SẢN PHẨM MỚI
                    </button>
                </div>
            }
        </div>
    </div>
</div>