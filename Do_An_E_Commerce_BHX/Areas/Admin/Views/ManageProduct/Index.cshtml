@model IEnumerable<Do_An_E_Commerce_BHX.Models.Entities.Product>

@{
    ViewData["Title"] = "Quản lý sản phẩm";
    ViewData["Subtitle"] = "Tổng quan toàn bộ sản phẩm đang bán";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="dash-page">

    <!-- ===== PAGE HEADER ===== -->
    <div class="d-flex align-items-center justify-content-between mb-4 pb-3" style="border-bottom: 1px solid var(--adm-border);">
        <div>
            <h3 class="mb-1" style="font-size: 20px; font-weight: 700; color: var(--adm-text); display: flex; align-items: center; gap: 10px;">
                <i class="fa-solid fa-box-open text-primary"></i> Quản Lý Sản Phẩm
            </h3>
            <p class="mb-0" style="font-size: 13.5px; color: var(--adm-text-2);">Quản lý kho, giá bán và trạng thái hiển thị của các sản phẩm</p>
        </div>
        <div class="d-flex align-items-center gap-3">
            <span class="badge bg-secondary" style="font-size: 13px; padding: 8px 12px;">
                <i class="fa-solid fa-boxes-stacked me-1"></i> @(Model?.Count() ?? 0) SP
            </span>
            <a href="@Url.Action("ThemSP", "ManageProduct")" class="btn btn-success">
                <i class="fa-solid fa-plus"></i> Thêm sản phẩm
            </a>
        </div>
    </div>

    <!-- ===== BỘ LỌC TÌM KIẾM ĐA LỚP ===== -->
    <div class="adm-filter-bar">
        <h5 class="mb-3" style="font-size: 14px; font-weight: 700; color: var(--adm-text); display: flex; align-items: center; gap: 8px;">
            <i class="fa-solid fa-sliders text-primary"></i> Bộ lọc chi tiết
        </h5>
        @using (Html.BeginForm("Index", "ManageProduct", FormMethod.Get))
        {
            <div class="row g-3">
                <!-- Hàng 1 -->
                <div class="col-12 col-md-4 col-lg-3">
                    <label class="form-label">Từ khóa</label>
                    <input type="text" name="TuKhoa" class="form-control" value="@Request["TuKhoa"]" placeholder="Tên sản phẩm..." />
                </div>
                <div class="col-12 col-md-4 col-lg-3">
                    <label class="form-label">Danh mục</label>
                    @Html.DropDownList("CategoryId", ViewBag.Category as SelectList, "-- Tất cả --", new { @class = "form-select" })
                </div>
                <div class="col-12 col-md-4 col-lg-3">
                    <label class="form-label">Loại sản phẩm</label>
                    <select name="productType" class="form-select">
                        <option value="">-- Tất cả --</option>
                        <option value="1" @(ViewBag.ProductType == 1 ? "selected" : "")>⭐ Sản phẩm kho gốc</option>
                        <option value="2" @(ViewBag.ProductType == 2 ? "selected" : "")>🔗 Bài quy cách con</option>
                    </select>
                </div>
                <div class="col-12 col-md-6 col-lg-3">
                    <label class="form-label">Khoảng giá</label>
                    <div class="input-group">
                        <input type="number" name="GiaTu" class="form-control" value="@Request["GiaTu"]" placeholder="Từ..." />
                        <span class="input-group-text border-start-0 border-end-0">-</span>
                        <input type="number" name="GiaDen" class="form-control" value="@Request["GiaDen"]" placeholder="Đến..." />
                    </div>
                </div>

                <!-- Hàng 2 -->
                <div class="col-12 col-md-6 col-lg-3">
                    <label class="form-label">Khoảng Tồn kho</label>
                    <div class="input-group">
                        <input type="number" name="TonTu" class="form-control" value="@Request["TonTu"]" placeholder="Từ..." />
                        <span class="input-group-text border-start-0 border-end-0">-</span>
                        <input type="number" name="TonDen" class="form-control" value="@Request["TonDen"]" placeholder="Đến..." />
                    </div>
                </div>
                <div class="col-12 col-md-6 col-lg-2">
                    <label class="form-label">Kinh doanh</label>
                    <select name="isAvailable" class="form-select">
                        <option value="">-- Tất cả --</option>
                        <option value="true" @(Request["isAvailable"] == "true" ? "selected" : "")>Đang bán</option>
                        <option value="false" @(Request["isAvailable"] == "false" ? "selected" : "")>Ngừng bán</option>
                    </select>
                </div>
                <div class="col-12 col-md-4 col-lg-2">
                    <label class="form-label">TT Khóa</label>
                    <select name="isLock" class="form-select">
                        <option value="">-- Tất cả --</option>
                        <option value="true" @(Request["isLock"] == "true" ? "selected" : "")>Bị khóa</option>
                        <option value="false" @(Request["isLock"] == "false" ? "selected" : "")>Đang mở</option>
                    </select>
                </div>
                <div class="col-12 col-md-4 col-lg-2">
                    <label class="form-label">Nổi bật / Bán chạy</label>
                    <select name="isHot" class="form-select mb-2">
                        <option value="">-- Lọc Hot --</option>
                        <option value="true" @(Request["isHot"] == "true" ? "selected" : "")>Sản phẩm Hot</option>
                    </select>
                    <select name="isBestSeller" class="form-select">
                        <option value="">-- Lọc BestSeller --</option>
                        <option value="true" @(Request["isBestSeller"] == "true" ? "selected" : "")>Bán chạy</option>
                    </select>
                </div>
                <div class="col-12 col-md-4 col-lg-3">
                    <label class="form-label">Sắp xếp</label>
                    <select name="SortBy" class="form-select">
                        <option value="">Mặc định</option>
                        <option value="nameAsc" @(Request["SortBy"] == "nameAsc" ? "selected" : "")>Tên A-Z</option>
                        <option value="nameDesc" @(Request["SortBy"] == "nameDesc" ? "selected" : "")>Tên Z-A</option>
                        <option value="priceAsc" @(Request["SortBy"] == "priceAsc" ? "selected" : "")>Giá tăng</option>
                        <option value="priceDesc" @(Request["SortBy"] == "priceDesc" ? "selected" : "")>Giá giảm</option>
                        <option value="qtyAsc" @(Request["SortBy"] == "qtyAsc" ? "selected" : "")>Tồn tăng</option>
                        <option value="qtyDesc" @(Request["SortBy"] == "qtyDesc" ? "selected" : "")>Tồn giảm</option>
                    </select>
                </div>
            </div>

            <!-- Nút Lọc và Đặt lại đã được đồng bộ -->
            <div class="d-flex justify-content-end align-items-center gap-2 mt-4 pt-3" style="border-top: 1px solid var(--adm-border);">
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                    <i class="fa-solid fa-rotate-left"></i> Đặt lại
                </a>
                <button type="submit" class="btn btn-primary">
                    <i class="fa-solid fa-filter"></i> TÌM KIẾM
                </button>
            </div>
        }
    </div>

    <!-- ===== BẢNG DANH SÁCH SẢN PHẨM ===== -->
    <div class="adm-table-wrap">
        <div class="adm-table-header">
            <h5 class="adm-table-title m-0">
                <i class="fa-solid fa-list-ul"></i>
                Danh Sách Sản Phẩm (@(Model?.Count() ?? 0))
            </h5>
        </div>
        <div class="adm-table-responsive">
            <table class="table mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">Mã SP</th>
                        <th>Tên sản phẩm</th>
                        <th>Mã vạch</th>
                        <th style="min-width: 150px;">Tồn kho</th>
                        <th class="text-end">Giá bán</th>
                        <th class="text-end pe-4" style="min-width: 140px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        var maxQty = Model.Max(p => p.Quantity);
                        if (maxQty <= 0) { maxQty = 1; }

                        foreach (var item in Model)
                        {
                            var pct = (int)Math.Min(100, (item.Quantity * 100.0) / maxQty);
                            var stockColor = item.Quantity <= 5 ? "var(--adm-red)" : (item.Quantity <= 20 ? "var(--adm-orange)" : "var(--adm-emerald)");

                            <tr>
                                <td class="ps-4">
                                    <span style="font-family: 'JetBrains Mono', monospace; color: var(--adm-text-2); font-size: 13px;">#@item.Id</span>
                                </td>
                                <td>
                                    <div style="font-weight: 600; font-size: 14.5px;">@item.Name</div>
                                    <div class="mt-1 d-flex flex-wrap gap-1 align-items-center">
                                        <span class="badge bg-secondary text-white">
                                            📦 @(string.IsNullOrEmpty(item.Unit) ? "Cái" : item.Unit) @(item.UnitMultiplier > 1 ? $"({item.UnitMultiplier} lẻ)" : "")
                                        </span>

                                        @if (item.ParentProductId.HasValue && item.ParentProduct != null)
                                        {
                                            <span class="badge bg-info text-dark">🔗 Kho gốc: @item.ParentProduct.Name</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-primary">⭐ Bài Kho Gốc</span>
                                        }

                                        @if (item.IsHot)
                                        {<span class="badge bg-danger">HOT</span>}
                                        @if (item.IsBestSeller)
                                        {<span class="badge bg-warning text-dark">BEST SELLER</span>}
                                        @if (!item.IsAvailable)
                                        {<span class="badge bg-secondary text-decoration-line-through">Ngừng bán</span>}
                                        @if (item.IsLock)
                                        {<span class="badge bg-dark border border-secondary">Bị khóa</span>}
                                    </div>
                                </td>
                                <td>
                                    <span style="font-family: 'JetBrains Mono', monospace; font-size: 13px; color: var(--adm-text-2);">
                                        <i class="fa-solid fa-barcode me-1"></i> @item.Barcode
                                    </span>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="progress flex-grow-1" style="height: 6px; background-color: var(--adm-surface-3);">
                                            <div class="progress-bar" style="width: @(pct)%; background-color: @stockColor;"></div>
                                        </div>
                                        <span style="font-family: 'JetBrains Mono', monospace; font-size: 13px;">@item.Quantity</span>
                                    </div>
                                </td>
                                <td class="text-end">
                                    <span style="font-family: 'JetBrains Mono', monospace; font-weight: 700; color: var(--adm-gold);">
                                        @item.Price.ToString("N0") ₫
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    <!-- Nút Xem Chi Tiết -->
                                    <button type="button" class="btn btn-sm btn-outline-info" title="Xem chi tiết"
                                            onclick="openDetailModal({
                                                id: '@item.Id',
                                                name: '@Html.Raw(HttpUtility.JavaScriptStringEncode(item.Name))',
                                                barcode: '@item.Barcode',
                                                category: '@Html.Raw(HttpUtility.JavaScriptStringEncode(item.Category?.Name ?? "Chưa phân loại"))',
                                                price: '@item.Price.ToString("N0") ₫',
                                                quantity: '@item.Quantity',
                                                image: '@(string.IsNullOrEmpty(item.URLImage) ? "https://via.placeholder.com/140?text=No+Img" : item.URLImage)',
                                                desc: '@Html.Raw(HttpUtility.JavaScriptStringEncode(item.Description ?? "Không có mô tả chi tiết."))',
                                                isAvailable: @(item.IsAvailable ? "true" : "false"),
                                                isHot: @(item.IsHot ? "true" : "false"),
                                                isBestSeller: @(item.IsBestSeller ? "true" : "false"),
                                                isLock: @(item.IsLock ? "true" : "false")
                                            })">
                                        <i class="fa-solid fa-eye"></i>
                                    </button>

                                    <!-- Nút Sửa -->
                                    <a href="@Url.Action("SuaSP", "ManageProduct", new { id = item.Id })" class="btn btn-sm btn-outline-primary ms-1" title="Sửa">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                    </a>

                                    <!-- Nút Xóa -->
                                    <button type="button" class="btn btn-sm btn-outline-danger ms-1" title="Xóa"
                                            onclick="openDeleteModal(@item.Id, '@Html.Raw(HttpUtility.JavaScriptStringEncode(item.Name))')">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>

                                    <!-- Form ẩn xóa -->
                                    @using (Html.BeginForm("XoaSP", "ManageProduct", FormMethod.Post, new { id = "formDelete_" + item.Id, style = "display:none;" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="Id" value="@item.Id" />
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="adm-empty">
                                <i class="fa-solid fa-box-open"></i>
                                <h5>Trống</h5>
                                <p>Chưa có sản phẩm nào trong danh sách.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ============ MODALS (BOOTSTRAP 5) ============ -->
<!-- Modal Xem Chi Tiết -->
<div class="modal fade" id="detailModal" tabindex="-1" aria-labelledby="detailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header">
                <h5 class="modal-title" id="detailModalLabel" style="color: var(--adm-text); font-weight: 700; font-size: 16px;">
                    <i class="fa-solid fa-circle-info text-info me-2"></i> Chi tiết sản phẩm <span id="dtId" style="color: var(--adm-gold);"></span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="row g-4">
                    <div class="col-12 col-md-4 text-center">
                        <img id="dtImage" src="" class="img-fluid rounded border border-secondary p-1" style="background: var(--adm-surface-2); max-height: 200px; object-fit: contain;" alt="Product Image" onerror="this.src='https://via.placeholder.com/140?text=No+Img';" />
                    </div>
                    <div class="col-12 col-md-8">
                        <h4 id="dtName" style="font-weight: 700; color: var(--adm-text); margin-bottom: 16px;"></h4>

                        <table class="table table-borderless table-sm mb-3" style="color: var(--adm-text-2);">
                            <tr>
                                <td style="width: 100px; font-weight: 600;">Danh mục:</td>
                                <td id="dtCategory" style="color: var(--adm-text);"></td>
                            </tr>
                            <tr>
                                <td style="font-weight: 600;">Giá bán:</td>
                                <td id="dtPrice" style="color: var(--adm-gold); font-weight: 700; font-family: 'JetBrains Mono', monospace;"></td>
                            </tr>
                            <tr>
                                <td style="font-weight: 600;">Tồn kho:</td>
                                <td id="dtQuantity" style="color: var(--adm-text);"></td>
                            </tr>
                            <tr>
                                <td style="font-weight: 600;">Mã vạch:</td>
                                <td id="dtBarcode" style="color: var(--adm-text); font-family: 'JetBrains Mono', monospace;"></td>
                            </tr>
                        </table>

                        <div id="dtBadges" class="d-flex flex-wrap gap-2 mt-2"></div>
                    </div>
                    <div class="col-12">
                        <div class="p-3 rounded" style="background: var(--adm-surface-2); border: 1px solid var(--adm-border);">
                            <strong style="color: var(--adm-text-2);">Mô tả chi tiết:</strong>
                            <div id="dtDesc" class="mt-2" style="font-size: 13.5px; line-height: 1.6; max-height: 150px; overflow-y: auto;"></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Xác Nhận Xóa -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-danger shadow-lg">
            <div class="modal-header" style="border-bottom-color: var(--adm-red-dim) !important;">
                <h5 class="modal-title text-danger" id="deleteModalLabel" style="font-weight: 700; font-size: 15px;">
                    <i class="fa-solid fa-triangle-exclamation me-2"></i>Xác nhận xóa
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <p style="color: var(--adm-text-2); margin-bottom: 0;">
                    Bạn có chắc chắn muốn xóa sản phẩm <strong id="deleteProductName" class="text-white"></strong>?<br />
                    <span class="text-danger mt-2 d-inline-block" style="font-size: 12.5px;">* Cảnh báo: Hành động này không thể hoàn tác.</span>
                </p>
            </div>
            <div class="modal-footer" style="border-top-color: var(--adm-border) !important;">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-danger" onclick="confirmDelete()"><i class="fa-solid fa-trash"></i> Xóa sản phẩm</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // --- JS Modal Chi Tiết (Bootstrap 5) ---
        function openDetailModal(data) {
            document.getElementById('dtId').textContent = '#' + data.id;
            document.getElementById('dtName').textContent = data.name;
            document.getElementById('dtCategory').textContent = data.category;
            document.getElementById('dtPrice').textContent = data.price;
            document.getElementById('dtQuantity').textContent = data.quantity + ' sản phẩm';
            document.getElementById('dtBarcode').textContent = data.barcode || 'N/A';
            document.getElementById('dtDesc').textContent = data.desc;
            document.getElementById('dtImage').src = data.image;

            let badgesHtml = '';
            if (data.isAvailable) badgesHtml += '<span class="badge bg-success">Đang kinh doanh</span>';
            if (data.isHot) badgesHtml += '<span class="badge bg-danger">HOT 🔥</span>';
            if (data.isBestSeller) badgesHtml += '<span class="badge bg-warning text-dark">Best Seller ⭐</span>';
            if (data.isLock) badgesHtml += '<span class="badge bg-dark border border-secondary">Đã khóa 🔒</span>';
            document.getElementById('dtBadges').innerHTML = badgesHtml;

            var detailModal = bootstrap.Modal.getOrCreateInstance(document.getElementById('detailModal'));
            detailModal.show();
        }

        // --- JS Modal Xóa (Bootstrap 5) ---
        let productIdToDelete = null;

        function openDeleteModal(id, productName) {
            productIdToDelete = id;
            document.getElementById('deleteProductName').textContent = productName;

            var deleteModal = bootstrap.Modal.getOrCreateInstance(document.getElementById('deleteModal'));
            deleteModal.show();
        }

        function confirmDelete() {
            if (productIdToDelete) {
                document.getElementById('formDelete_' + productIdToDelete).submit();
            }
        }
    </script>
}